// Assemble the core compiler's stack IR into a WebAssembly module.
// The embedded type/import header is the stable Pseudo2Wasm host ABI.
DECLARE PREFIX : STRING
DECLARE PREFIX_HEX : STRING
DECLARE IR : STRING
DECLARE LINE : STRING
DECLARE CHARACTER : STRING
DECLARE TEXT : STRING
DECLARE CODE : STRING
DECLARE BODY : STRING
DECLARE PAYLOAD : STRING
DECLARE WASM : STRING
DECLARE MODE : STRING
DECLARE POSITION : INTEGER
DECLARE INDEX : INTEGER
DECLARE LINE_LENGTH : INTEGER
DECLARE STRING_INDEX : INTEGER
DECLARE OP_INDEX : INTEGER
DECLARE CALL_INDEX : INTEGER
DECLARE VALUE : INTEGER
DECLARE BYTE_VALUE : INTEGER
DECLARE MORE : INTEGER
DECLARE DEPTH : INTEGER
DECLARE ROUTINE_COUNT : INTEGER
DECLARE MAIN_CODE : STRING
DECLARE ROUTINE_BODIES : STRING
DECLARE ROUTINE_EXPORTS : STRING
DECLARE ROUTINE_NAME : STRING
DECLARE FUNCTION_PAYLOAD : STRING
DECLARE EXPORT_PAYLOAD : STRING
DECLARE SECTION_DATA : STRING
DECLARE ROUTINE_MODE : INTEGER

PREFIX_HEX ← ""
PREFIX ← ""
INDEX ← 1
WHILE INDEX < LENGTH(PREFIX_HEX)
  CHARACTER ← MID(PREFIX_HEX, INDEX, 1)
  BYTE_VALUE ← ASC(CHARACTER)
  IF BYTE_VALUE >= 65 THEN
    BYTE_VALUE ← BYTE_VALUE - 55
  ELSE
    BYTE_VALUE ← BYTE_VALUE - 48
  ENDIF
  VALUE ← BYTE_VALUE * 16
  CHARACTER ← MID(PREFIX_HEX, INDEX + 1, 1)
  BYTE_VALUE ← ASC(CHARACTER)
  IF BYTE_VALUE >= 65 THEN
    BYTE_VALUE ← BYTE_VALUE - 55
  ELSE
    BYTE_VALUE ← BYTE_VALUE - 48
  ENDIF
  PREFIX ← PREFIX & CHR(VALUE + BYTE_VALUE)
  INDEX ← INDEX + 2
ENDWHILE
INPUT IR
IR ← IR & CHR(10)
POSITION ← 1
STRING_INDEX ← 0
CODE ← ""
DEPTH ← 0
ROUTINE_COUNT ← 0
ROUTINE_BODIES ← ""
ROUTINE_EXPORTS ← ""
ROUTINE_MODE ← 0
WHILE POSITION <= LENGTH(IR)
  LINE ← ""
  CHARACTER ← MID(IR, POSITION, 1)
  WHILE CHARACTER <> CHR(10)
    LINE ← LINE & CHARACTER
    POSITION ← POSITION + 1
    CHARACTER ← MID(IR, POSITION, 1)
  ENDWHILE
  POSITION ← POSITION + 1
  MODE ← ""
  IF LINE = "" THEN
    MODE ← "DONE"
  ENDIF
  IF LEFT(LINE, 2) = "I:" THEN
    LINE_LENGTH ← LENGTH(LINE)
    TEXT ← MID(LINE, 3, LINE_LENGTH)
    OUTPUT "S:" & TEXT
    VALUE ← STRING_INDEX
    STRING_INDEX ← STRING_INDEX + 1
    CODE ← CODE & CHR(65)
    MORE ← 1
    WHILE MORE = 1
      BYTE_VALUE ← VALUE MOD 128
      VALUE ← VALUE DIV 128
      MORE ← 0
      IF VALUE > 0 THEN
        MORE ← 1
      ENDIF
      IF BYTE_VALUE >= 64 THEN
        IF VALUE = 0 THEN
          MORE ← 1
        ENDIF
      ENDIF
      IF MORE = 1 THEN
        BYTE_VALUE ← BYTE_VALUE + 128
      ENDIF
      CODE ← CODE & CHR(BYTE_VALUE)
    ENDWHILE
    MODE ← "DONE"
  ENDIF
  IF LEFT(LINE, 2) = "O:" THEN
    LINE_LENGTH ← LENGTH(LINE)
    TEXT ← MID(LINE, 3, LINE_LENGTH)
    OP_INDEX ← 99
    IF TEXT = "OR" THEN
      OP_INDEX ← 0
    ENDIF
    IF TEXT = "AND" THEN
      OP_INDEX ← 1
    ENDIF
    IF TEXT = "=" THEN
      OP_INDEX ← 2
    ENDIF
    IF TEXT = "<>" THEN
      OP_INDEX ← 3
    ENDIF
    IF TEXT = "<" THEN
      OP_INDEX ← 4
    ENDIF
    IF TEXT = "<=" THEN
      OP_INDEX ← 5
    ENDIF
    IF TEXT = ">" THEN
      OP_INDEX ← 6
    ENDIF
    IF TEXT = ">=" THEN
      OP_INDEX ← 7
    ENDIF
    IF TEXT = "IN" THEN
      OP_INDEX ← 8
    ENDIF
    IF TEXT = "&" THEN
      OP_INDEX ← 9
    ENDIF
    IF TEXT = "+" THEN
      OP_INDEX ← 10
    ENDIF
    IF TEXT = "-" THEN
      OP_INDEX ← 11
    ENDIF
    IF TEXT = "*" THEN
      OP_INDEX ← 12
    ENDIF
    IF TEXT = "/" THEN
      OP_INDEX ← 13
    ENDIF
    IF TEXT = "DIV" THEN
      OP_INDEX ← 14
    ENDIF
    IF TEXT = "MOD" THEN
      OP_INDEX ← 15
    ENDIF
    IF OP_INDEX = 99 THEN
      OUTPUT "E:Unknown operator " & TEXT
    ENDIF
    VALUE ← OP_INDEX
    CODE ← CODE & CHR(65)
    MORE ← 1
    WHILE MORE = 1
      BYTE_VALUE ← VALUE MOD 128
      VALUE ← VALUE DIV 128
      MORE ← 0
      IF VALUE > 0 THEN
        MORE ← 1
      ENDIF
      IF BYTE_VALUE >= 64 THEN
        IF VALUE = 0 THEN
          MORE ← 1
        ENDIF
      ENDIF
      IF MORE = 1 THEN
        BYTE_VALUE ← BYTE_VALUE + 128
      ENDIF
      CODE ← CODE & CHR(BYTE_VALUE)
    ENDWHILE
    MODE ← "DONE"
  ENDIF
  IF LEFT(LINE, 2) = "U:" THEN
    LINE_LENGTH ← LENGTH(LINE)
    TEXT ← MID(LINE, 3, LINE_LENGTH)
    OP_INDEX ← 99
    IF TEXT = "NOT" THEN
      OP_INDEX ← 0
    ENDIF
    IF TEXT = "-" THEN
      OP_INDEX ← 1
    ENDIF
    IF TEXT = "+" THEN
      OP_INDEX ← 2
    ENDIF
    IF TEXT = "^" THEN
      OP_INDEX ← 3
    ENDIF
    IF OP_INDEX = 99 THEN
      OUTPUT "E:Unknown unary operator " & TEXT
    ENDIF
    CODE ← CODE & CHR(65)
    CODE ← CODE & CHR(OP_INDEX)
    MODE ← "DONE"
  ENDIF
  IF LEFT(LINE, 2) = "K:" THEN
    CODE ← CODE & CHR(65)
    IF LINE = "K:1" THEN
      CODE ← CODE & CHR(1)
    ELSE
      CODE ← CODE & CHR(0)
    ENDIF
    MODE ← "DONE"
  ENDIF
  IF LEFT(LINE, 2) = "T:" THEN
    LINE_LENGTH ← LENGTH(LINE)
    TEXT ← MID(LINE, 3, LINE_LENGTH)
    VALUE ← STR_TO_NUM(TEXT)
    CODE ← CODE & CHR(65)
    MORE ← 1
    WHILE MORE = 1
      BYTE_VALUE ← VALUE MOD 128
      VALUE ← VALUE DIV 128
      MORE ← 0
      IF VALUE > 0 THEN
        MORE ← 1
      ENDIF
      IF BYTE_VALUE >= 64 THEN
        IF VALUE = 0 THEN
          MORE ← 1
        ENDIF
      ENDIF
      IF MORE = 1 THEN
        BYTE_VALUE ← BYTE_VALUE + 128
      ENDIF
      CODE ← CODE & CHR(BYTE_VALUE)
    ENDWHILE
    CODE ← CODE & CHR(16)
    CODE ← CODE & CHR(0)
    MODE ← "DONE"
  ENDIF
  IF LEFT(LINE, 2) = "F:" THEN
    LINE_LENGTH ← LENGTH(LINE)
    TEXT ← MID(LINE, 3, LINE_LENGTH)
    OP_INDEX ← STR_TO_NUM(TEXT)
    CODE ← CODE & CHR(65)
    CODE ← CODE & CHR(OP_INDEX)
    MODE ← "DONE"
  ENDIF
  IF MODE = "" THEN
    CALL_INDEX ← 99
    IF LINE = "GET" THEN
      CALL_INDEX ← 4
    ENDIF
    IF LINE = "SET" THEN
      CALL_INDEX ← 5
    ENDIF
    IF LINE = "FIELD" THEN
      CALL_INDEX ← 17
    ENDIF
    IF LINE = "SETFIELD" THEN
      CALL_INDEX ← 18
    ENDIF
    IF LINE = "INDEX" THEN
      CALL_INDEX ← 15
    ENDIF
    IF LINE = "SETINDEX" THEN
      CALL_INDEX ← 16
    ENDIF
    IF LINE = "DEREF" THEN
      CALL_INDEX ← 28
    ENDIF
    IF LINE = "SETDEREF" THEN
      CALL_INDEX ← 29
    ENDIF
    IF LINE = "FILEOP" THEN
      CALL_INDEX ← 22
    ENDIF
    IF LINE = "LOOPDECLARE" THEN
      CALL_INDEX ← 32
    ENDIF
    IF LINE = "NEWOBJECT" THEN
      CALL_INDEX ← 30
    ENDIF
    IF LINE = "CALLMETHOD" THEN
      CALL_INDEX ← 31
    ENDIF
    IF LINE = "DECLARE" THEN
      CALL_INDEX ← 6
    ENDIF
    IF LINE = "BINARY" THEN
      CALL_INDEX ← 7
    ENDIF
    IF LINE = "UNARY" THEN
      CALL_INDEX ← 8
    ENDIF
    IF LINE = "BOOL" THEN
      CALL_INDEX ← 3
    ENDIF
    IF LINE = "ARGS" THEN
      CALL_INDEX ← 10
    ENDIF
    IF LINE = "PUSH" THEN
      CALL_INDEX ← 11
    ENDIF
    IF LINE = "CALLBUILTIN" THEN
      CALL_INDEX ← 12
    ENDIF
    IF LINE = "OUTPUT" THEN
      CALL_INDEX ← 13
    ENDIF
    IF LINE = "INPUT" THEN
      CALL_INDEX ← 14
    ENDIF
    IF LINE = "CREATE" THEN
      CALL_INDEX ← 21
    ENDIF
    IF LINE = "REFNAME" THEN
      CALL_INDEX ← 25
    ENDIF
    IF LINE = "STR" THEN
      CALL_INDEX ← 2
    ENDIF
    IF CALL_INDEX <> 99 THEN
      CODE ← CODE & CHR(16)
      CODE ← CODE & CHR(CALL_INDEX)
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "IF" THEN
      CODE ← CODE & CHR(16)
      CODE ← CODE & CHR(9)
      CODE ← CODE & CHR(4)
      CODE ← CODE & CHR(64)
      DEPTH ← DEPTH + 1
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "NULL" THEN
      CODE ← CODE & CHR(208)
      CODE ← CODE & CHR(111)
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "ELSE" THEN
      CODE ← CODE & CHR(5)
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "ENDIF" THEN
      CODE ← CODE & CHR(11)
      DEPTH ← DEPTH - 1
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "WHILE" THEN
      CODE ← CODE & CHR(2)
      CODE ← CODE & CHR(64)
      CODE ← CODE & CHR(3)
      CODE ← CODE & CHR(64)
      DEPTH ← DEPTH + 1
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "WHILE_TEST" THEN
      CODE ← CODE & CHR(16)
      CODE ← CODE & CHR(9)
      CODE ← CODE & CHR(69)
      CODE ← CODE & CHR(13)
      CODE ← CODE & CHR(1)
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "FOR_TEST" THEN
      CODE ← CODE & CHR(16)
      CODE ← CODE & CHR(23)
      CODE ← CODE & CHR(69)
      CODE ← CODE & CHR(13)
      CODE ← CODE & CHR(1)
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "ENDWHILE" THEN
      CODE ← CODE & CHR(12)
      CODE ← CODE & CHR(0)
      CODE ← CODE & CHR(11)
      CODE ← CODE & CHR(11)
      DEPTH ← DEPTH - 1
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "REPEAT" THEN
      CODE ← CODE & CHR(3)
      CODE ← CODE & CHR(64)
      DEPTH ← DEPTH + 1
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "UNTIL_TEST" THEN
      CODE ← CODE & CHR(16)
      CODE ← CODE & CHR(9)
      CODE ← CODE & CHR(69)
      CODE ← CODE & CHR(13)
      CODE ← CODE & CHR(0)
      CODE ← CODE & CHR(11)
      DEPTH ← DEPTH - 1
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 2) = "R:" THEN
      IF ROUTINE_MODE = 1 THEN
        OUTPUT "E:Nested routine definition"
      ENDIF
      ROUTINE_MODE ← 1
      MAIN_CODE ← CODE
      CODE ← CHR(65)
      CODE ← CODE & CHR(ROUTINE_COUNT)
      CODE ← CODE & CHR(32)
      CODE ← CODE & CHR(0)
      CODE ← CODE & CHR(16)
      CODE ← CODE & CHR(19)
      LINE_LENGTH ← LENGTH(LINE)
      ROUTINE_NAME ← MID(LINE, 3, LINE_LENGTH)
      ROUTINE_EXPORTS ← ROUTINE_EXPORTS & CHR(LENGTH(ROUTINE_NAME))
      ROUTINE_EXPORTS ← ROUTINE_EXPORTS & ROUTINE_NAME
      ROUTINE_EXPORTS ← ROUTINE_EXPORTS & CHR(0)
      VALUE ← ROUTINE_COUNT + 33
      ROUTINE_EXPORTS ← ROUTINE_EXPORTS & CHR(VALUE)
      ROUTINE_COUNT ← ROUTINE_COUNT + 1
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "ENDROUTINE" THEN
      CODE ← CODE & CHR(208)
      CODE ← CODE & CHR(111)
      CODE ← CODE & CHR(16)
      CODE ← CODE & CHR(20)
      BODY ← CHR(0) & CODE
      BODY ← BODY & CHR(11)
      VALUE ← LENGTH(BODY)
      MORE ← 1
      WHILE MORE = 1
        BYTE_VALUE ← VALUE MOD 128
        VALUE ← VALUE DIV 128
        MORE ← 0
        IF VALUE > 0 THEN
          MORE ← 1
          BYTE_VALUE ← BYTE_VALUE + 128
        ENDIF
        ROUTINE_BODIES ← ROUTINE_BODIES & CHR(BYTE_VALUE)
      ENDWHILE
      ROUTINE_BODIES ← ROUTINE_BODIES & BODY
      CODE ← MAIN_CODE
      ROUTINE_MODE ← 0
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "RETURN" THEN
      CODE ← CODE & CHR(16)
      CODE ← CODE & CHR(20)
      CODE ← CODE & CHR(15)
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "DROP" THEN
      CODE ← CODE & CHR(26)
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 12) = "CALLROUTINE:" THEN
      LINE_LENGTH ← LENGTH(LINE)
      TEXT ← MID(LINE, 13, LINE_LENGTH)
      VALUE ← STR_TO_NUM(TEXT)
      VALUE ← VALUE + 33
      CODE ← CODE & CHR(16)
      MORE ← 1
      WHILE MORE = 1
        BYTE_VALUE ← VALUE MOD 128
        VALUE ← VALUE DIV 128
        MORE ← 0
        IF VALUE > 0 THEN
          MORE ← 1
          BYTE_VALUE ← BYTE_VALUE + 128
        ENDIF
        CODE ← CODE & CHR(BYTE_VALUE)
      ENDWHILE
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 6) = "ERROR:" THEN
      OUTPUT "E:" & LINE
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    OUTPUT "E:Unknown IR " & LINE
  ENDIF
ENDWHILE
IF DEPTH <> 0 THEN
  OUTPUT "E:Unclosed control blocks"
ENDIF

IF ROUTINE_MODE = 1 THEN
  OUTPUT "E:Unclosed routine"
ENDIF
BODY ← CHR(0) & CODE
BODY ← BODY & CHR(11)
VALUE ← LENGTH(BODY)
VALUE ← ROUTINE_COUNT + 1
PAYLOAD ← CHR(VALUE)
PAYLOAD ← PAYLOAD & ROUTINE_BODIES
VALUE ← LENGTH(BODY)
MORE ← 1
WHILE MORE = 1
  BYTE_VALUE ← VALUE MOD 128
  VALUE ← VALUE DIV 128
  MORE ← 0
  IF VALUE > 0 THEN
    MORE ← 1
    BYTE_VALUE ← BYTE_VALUE + 128
  ENDIF
  PAYLOAD ← PAYLOAD & CHR(BYTE_VALUE)
ENDWHILE
PAYLOAD ← PAYLOAD & BODY

VALUE ← ROUTINE_COUNT + 1
FUNCTION_PAYLOAD ← CHR(VALUE)
INDEX ← 1
WHILE INDEX <= ROUTINE_COUNT
  FUNCTION_PAYLOAD ← FUNCTION_PAYLOAD & CHR(33)
  INDEX ← INDEX + 1
ENDWHILE
FUNCTION_PAYLOAD ← FUNCTION_PAYLOAD & CHR(34)
SECTION_DATA ← CHR(3)
VALUE ← LENGTH(FUNCTION_PAYLOAD)
MORE ← 1
WHILE MORE = 1
  BYTE_VALUE ← VALUE MOD 128
  VALUE ← VALUE DIV 128
  MORE ← 0
  IF VALUE > 0 THEN
    MORE ← 1
    BYTE_VALUE ← BYTE_VALUE + 128
  ENDIF
  SECTION_DATA ← SECTION_DATA & CHR(BYTE_VALUE)
ENDWHILE
SECTION_DATA ← SECTION_DATA & FUNCTION_PAYLOAD
WASM ← PREFIX & SECTION_DATA

VALUE ← ROUTINE_COUNT + 1
EXPORT_PAYLOAD ← CHR(VALUE)
EXPORT_PAYLOAD ← EXPORT_PAYLOAD & ROUTINE_EXPORTS
EXPORT_PAYLOAD ← EXPORT_PAYLOAD & CHR(4)
EXPORT_PAYLOAD ← EXPORT_PAYLOAD & "main"
EXPORT_PAYLOAD ← EXPORT_PAYLOAD & CHR(0)
VALUE ← ROUTINE_COUNT + 33
EXPORT_PAYLOAD ← EXPORT_PAYLOAD & CHR(VALUE)
WASM ← WASM & CHR(7)
VALUE ← LENGTH(EXPORT_PAYLOAD)
MORE ← 1
WHILE MORE = 1
  BYTE_VALUE ← VALUE MOD 128
  VALUE ← VALUE DIV 128
  MORE ← 0
  IF VALUE > 0 THEN
    MORE ← 1
    BYTE_VALUE ← BYTE_VALUE + 128
  ENDIF
  WASM ← WASM & CHR(BYTE_VALUE)
ENDWHILE
WASM ← WASM & EXPORT_PAYLOAD
WASM ← WASM & CHR(10)
VALUE ← LENGTH(PAYLOAD)
MORE ← 1
WHILE MORE = 1
  BYTE_VALUE ← VALUE MOD 128
  VALUE ← VALUE DIV 128
  MORE ← 0
  IF VALUE > 0 THEN
    MORE ← 1
    BYTE_VALUE ← BYTE_VALUE + 128
  ENDIF
  WASM ← WASM & CHR(BYTE_VALUE)
ENDWHILE
WASM ← WASM & PAYLOAD
OUTPUT "B:" & WASM

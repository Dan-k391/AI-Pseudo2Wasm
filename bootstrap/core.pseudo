// CAIE pseudocode compiler. It emits stack IR for assembler.pseudo.
DECLARE SOURCE : STRING
DECLARE LINE : STRING
DECLARE CHARACTER : STRING
DECLARE QUOTE : STRING
DECLARE EXPR : STRING
DECLARE ATOM : STRING
DECLARE LEFT_PART : STRING
DECLARE RIGHT_PART : STRING
DECLARE OPERATOR : STRING
DECLARE MODE : STRING
DECLARE NAME : STRING
DECLARE FUNCTION_NAME : STRING
DECLARE ARGUMENTS : STRING
DECLARE ARGUMENT : STRING
DECLARE RECORD_LINE : STRING
DECLARE CANDIDATE : STRING
DECLARE POSITION : INTEGER
DECLARE SOURCE_LINE : INTEGER
DECLARE INDEX : INTEGER
DECLARE LINE_LENGTH : INTEGER
DECLARE NAME_LENGTH : INTEGER
DECLARE EXPR_LENGTH : INTEGER
DECLARE OP_POSITION : INTEGER
DECLARE OP_LENGTH : INTEGER
DECLARE DEPTH : INTEGER
DECLARE IN_STRING : INTEGER
DECLARE PART_COUNT : INTEGER
DECLARE PART_INDEX : INTEGER
DECLARE OPEN_INDEX : INTEGER
DECLARE ARG_POSITION : INTEGER
DECLARE ARG_LENGTH : INTEGER
DECLARE SCAN : INTEGER
DECLARE START_POSITION : INTEGER
DECLARE WORK : STRING
DECLARE FRAME : STRING
DECLARE FRAME_START : INTEGER
DECLARE FRAME_LENGTH : INTEGER
DECLARE FRAME_INDEX : INTEGER
DECLARE BEST_PRECEDENCE : INTEGER
DECLARE CANDIDATE_PRECEDENCE : INTEGER
DECLARE SPLIT_OUTER : INTEGER
DECLARE CANDIDATE_LENGTH : INTEGER
DECLARE ARG_DEPTH : INTEGER
DECLARE ARG_IN_STRING : INTEGER
DECLARE FOR_COUNTER : INTEGER
DECLARE FOR_STACK : STRING
DECLARE FOR_ENTRY : STRING
DECLARE FOR_END_NAME : STRING
DECLARE FOR_STEP_NAME : STRING
DECLARE FROM_EXPR : STRING
DECLARE TO_EXPR : STRING
DECLARE STEP_EXPR : STRING
DECLARE TO_POSITION : INTEGER
DECLARE STEP_POSITION : INTEGER
DECLARE ARROW_POSITION : INTEGER
DECLARE FOR_SEPARATOR : INTEGER
DECLARE CASE_ACTIVE : INTEGER
DECLARE CASE_ARMS : INTEGER
DECLARE CASE_EXPR : STRING
// Save the enclosing CASE while compiling a nested selection.
DECLARE CASE_STACK : STRING
DECLARE CASE_ENTRY : STRING
DECLARE CASE_SPLIT : INTEGER
DECLARE CASE_HEADER : STRING
DECLARE CASE_BODY : STRING
DECLARE CASE_INSERT : STRING
DECLARE CASE_CONDITION : STRING
DECLARE CASE_COLON : INTEGER
DECLARE CASE_TO : INTEGER
DECLARE TYPE_RECORD : INTEGER
DECLARE TYPE_NAME : STRING
DECLARE TYPE_FIELDS : STRING
DECLARE TYPE_TEXT : STRING
DECLARE TYPE_SPEC : STRING
DECLARE TYPE_EQUALS : INTEGER
DECLARE TYPE_CLOSE : INTEGER
DECLARE INDEX_POSITION : INTEGER
DECLARE INDEX_ARGS : STRING
DECLARE DEFINE_OPEN : INTEGER
DECLARE DEFINE_CLOSE : INTEGER
DECLARE ROUTINE_COUNT : INTEGER
DECLARE ROUTINE_MAP : STRING
DECLARE ROUTINE_REF_MAP : STRING
DECLARE ROUTINE_NAME : STRING
DECLARE ROUTINE_KIND : STRING
DECLARE ROUTINE_RETURN : STRING
DECLARE ROUTINE_OPEN : INTEGER
DECLARE ROUTINE_CLOSE : INTEGER
DECLARE PARAMS : STRING
DECLARE PARAM_SPEC : STRING
DECLARE PARAM : STRING
DECLARE PARAM_NAME : STRING
DECLARE PARAM_TYPE : STRING
DECLARE PARAM_COLON : INTEGER
DECLARE PARAM_POSITION : INTEGER
DECLARE BYREF_FLAGS : STRING
DECLARE IS_BYREF : INTEGER
DECLARE CALL_INDEX : INTEGER
DECLARE MAP_KEY : STRING
DECLARE CALL_FLAGS : STRING
DECLARE ARG_TOTAL : INTEGER
DECLARE ARG_NUMBER : INTEGER
DECLARE VALUE : INTEGER
DECLARE FILE_OP : INTEGER
DECLARE FILE_REF_POSITION : INTEGER
DECLARE FILE_ARG_COUNT : INTEGER
DECLARE FILE_FOR_POSITION : INTEGER
DECLARE FILE_MODE : STRING
DECLARE DATE_CALL : STRING
DECLARE ARRAY_RANGES : STRING
DECLARE CLASS_ACTIVE : INTEGER
DECLARE CLASS_NAME : STRING
DECLARE CLASS_PARENT : STRING
DECLARE CLASS_FIELDS : STRING
DECLARE CLASS_ACCESS : STRING
DECLARE CLASS_INHERITS : INTEGER
DECLARE ROUTINE_ACTIVE : INTEGER
DECLARE EXPORT_NAME : STRING
DECLARE METHOD_MODE : INTEGER
DECLARE METHOD_NAME : STRING
DECLARE INDEX_FIELD : INTEGER
DECLARE FIELD_POSITION : INTEGER
DECLARE TARGET_NAME : STRING
DECLARE FIELD_NAME : STRING

INPUT SOURCE
SOURCE ← SOURCE & CHR(10)
POSITION ← 1
SOURCE_LINE ← 0
FOR_COUNTER ← 0
FOR_STACK ← ""
CASE_ACTIVE ← 0
CASE_ARMS ← 0
CASE_STACK ← ""
TYPE_RECORD ← 0
ROUTINE_COUNT ← 0
ROUTINE_MAP ← ""
ROUTINE_REF_MAP ← ""
CLASS_ACTIVE ← 0
ROUTINE_ACTIVE ← 0
WHILE POSITION <= LENGTH(SOURCE)
  SOURCE_LINE ← SOURCE_LINE + 1
  LINE ← ""
  QUOTE ← ""
  CHARACTER ← MID(SOURCE, POSITION, 1)
  WHILE CHARACTER <> CHR(10)
    IF CHARACTER = QUOTE THEN
      QUOTE ← ""
      LINE ← LINE & CHARACTER
    ELSE
      IF QUOTE = "" AND (CHARACTER = CHR(34) OR CHARACTER = CHR(39)) THEN
        QUOTE ← CHARACTER
        LINE ← LINE & CHARACTER
      ELSE
        IF QUOTE = "" AND CHARACTER = "<" AND MID(SOURCE, POSITION + 1, 1) = "-" THEN
          LINE ← LINE & "←"
          POSITION ← POSITION + 1
        ELSE
          IF QUOTE = "" THEN
            IF CHARACTER = CHR(9) THEN
              LINE ← LINE & " "
            ELSE
              LINE ← LINE & UCASE(CHARACTER)
            ENDIF
          ELSE
            LINE ← LINE & CHARACTER
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    POSITION ← POSITION + 1
    CHARACTER ← MID(SOURCE, POSITION, 1)
  ENDWHILE
  POSITION ← POSITION + 1
  INDEX ← 1
  QUOTE ← ""
  WHILE INDEX <= LENGTH(LINE)
    CHARACTER ← MID(LINE, INDEX, 1)
    IF CHARACTER = QUOTE THEN
      QUOTE ← ""
    ELSE
      IF QUOTE = "" AND (CHARACTER = CHR(34) OR CHARACTER = CHR(39)) THEN
        QUOTE ← CHARACTER
      ELSE
        IF QUOTE = "" AND MID(LINE, INDEX, 2) = "//" THEN
          LINE ← LEFT(LINE, INDEX - 1)
          INDEX ← LENGTH(LINE) + 1
        ENDIF
      ENDIF
    ENDIF
    INDEX ← INDEX + 1
  ENDWHILE
  WHILE RIGHT(LINE, 1) = " "
    LINE ← LEFT(LINE, LENGTH(LINE) - 1)
  ENDWHILE
  WHILE LEFT(LINE, 1) = " "
    LINE_LENGTH ← LENGTH(LINE)
    LINE_LENGTH ← LINE_LENGTH - 1
    LINE ← MID(LINE, 2, LINE_LENGTH)
  ENDWHILE
  IF RIGHT(LINE, 1) = CHR(13) THEN
    LINE_LENGTH ← LENGTH(LINE)
    LINE_LENGTH ← LINE_LENGTH - 1
    LINE ← LEFT(LINE, LINE_LENGTH)
  ENDIF
  MODE ← ""
  EXPR ← ""
  IF LEFT(LINE, 2) = "//" THEN
    MODE ← "SKIP"
  ENDIF
  IF LINE = "" THEN
    MODE ← "SKIP"
  ENDIF
  IF MODE <> "SKIP" THEN
    OUTPUT "T:" & NUM_TO_STR(SOURCE_LINE)
  ENDIF
  CLASS_ACCESS ← "PUBLIC"
  IF LEFT(LINE, 7) = "PUBLIC " THEN
    LINE_LENGTH ← LENGTH(LINE)
    LINE ← MID(LINE, 8, LINE_LENGTH)
  ENDIF
  IF LEFT(LINE, 8) = "PRIVATE " THEN
    CLASS_ACCESS ← "PRIVATE"
    LINE_LENGTH ← LENGTH(LINE)
    LINE ← MID(LINE, 9, LINE_LENGTH)
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 8) = "CASE OF " THEN
      IF CASE_ACTIVE = 1 THEN
        CASE_STACK ← CASE_STACK & CASE_EXPR & CHR(31)
        CASE_STACK ← CASE_STACK & NUM_TO_STR(CASE_ARMS) & CHR(30)
      ENDIF
      CASE_ACTIVE ← 1
      CASE_ARMS ← 0
      LINE_LENGTH ← LENGTH(LINE)
      CASE_EXPR ← MID(LINE, 9, LINE_LENGTH)
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "ENDCASE" THEN
      IF CASE_ACTIVE = 0 THEN
        OUTPUT "ERROR:" & NUM_TO_STR(SOURCE_LINE) & ":" & LINE
      ELSE
        CASE_INSERT ← ""
        INDEX ← 1
        WHILE INDEX <= CASE_ARMS
          CASE_INSERT ← CASE_INSERT & "ENDIF"
          CASE_INSERT ← CASE_INSERT & CHR(10)
          INDEX ← INDEX + 1
        ENDWHILE
        START_POSITION ← POSITION - 1
        LEFT_PART ← LEFT(SOURCE, START_POSITION)
        LINE_LENGTH ← LENGTH(SOURCE)
        RIGHT_PART ← MID(SOURCE, POSITION, LINE_LENGTH)
        SOURCE ← LEFT_PART & CASE_INSERT
        SOURCE ← SOURCE & RIGHT_PART
      ENDIF
      CASE_ACTIVE ← 0
      IF CASE_STACK <> "" THEN
        CASE_SPLIT ← 0
        INDEX ← 1
        WHILE INDEX < LENGTH(CASE_STACK)
          IF MID(CASE_STACK, INDEX, 1) = CHR(30) THEN
            CASE_SPLIT ← INDEX
          ENDIF
          INDEX ← INDEX + 1
        ENDWHILE
        CASE_ENTRY ← MID(CASE_STACK, CASE_SPLIT + 1, LENGTH(CASE_STACK) - CASE_SPLIT - 1)
        CASE_STACK ← LEFT(CASE_STACK, CASE_SPLIT)
        CASE_SPLIT ← 0
        INDEX ← 1
        WHILE INDEX <= LENGTH(CASE_ENTRY)
          IF MID(CASE_ENTRY, INDEX, 1) = CHR(31) THEN
            CASE_SPLIT ← INDEX
          ENDIF
          INDEX ← INDEX + 1
        ENDWHILE
        CASE_EXPR ← LEFT(CASE_ENTRY, CASE_SPLIT - 1)
        CASE_ARMS ← STR_TO_NUM(MID(CASE_ENTRY, CASE_SPLIT + 1, LENGTH(CASE_ENTRY)))
        CASE_ACTIVE ← 1
      ENDIF
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF CASE_ACTIVE = 1 THEN
      CASE_COLON ← 0
      IF LEFT(LINE, 10) = "OTHERWISE " THEN
        CASE_COLON ← 1
      ENDIF
      IF IS_NUM(LEFT(LINE, 1)) THEN
        CASE_COLON ← 1
      ENDIF
      IF LEFT(LINE, 1) = CHR(34) OR LEFT(LINE, 1) = CHR(39) THEN
        CASE_COLON ← 1
      ENDIF
      IF CASE_COLON = 1 THEN
        CASE_COLON ← 0
        QUOTE ← ""
        INDEX ← 1
        WHILE INDEX <= LENGTH(LINE)
          CHARACTER ← MID(LINE, INDEX, 1)
          IF CHARACTER = CHR(34) OR CHARACTER = CHR(39) THEN
            IF QUOTE = "" THEN
              QUOTE ← CHARACTER
            ELSE
              IF QUOTE = CHARACTER THEN
                QUOTE ← ""
              ENDIF
            ENDIF
          ENDIF
          IF CHARACTER = ":" AND QUOTE = "" AND CASE_COLON = 0 THEN
            CASE_COLON ← INDEX
          ENDIF
          INDEX ← INDEX + 1
        ENDWHILE
        IF CASE_COLON > 0 THEN
          NAME_LENGTH ← CASE_COLON - 1
          CASE_HEADER ← LEFT(LINE, NAME_LENGTH)
          WHILE RIGHT(CASE_HEADER, 1) = " "
            NAME_LENGTH ← LENGTH(CASE_HEADER)
            NAME_LENGTH ← NAME_LENGTH - 1
            CASE_HEADER ← LEFT(CASE_HEADER, NAME_LENGTH)
          ENDWHILE
          START_POSITION ← CASE_COLON + 1
          LINE_LENGTH ← LENGTH(LINE)
          CASE_BODY ← MID(LINE, START_POSITION, LINE_LENGTH)
          WHILE LEFT(CASE_BODY, 1) = " "
            CASE_BODY ← MID(CASE_BODY, 2, LENGTH(CASE_BODY))
          ENDWHILE
          CASE_INSERT ← ""
          IF CASE_ARMS > 0 THEN
            CASE_INSERT ← "ELSE"
            CASE_INSERT ← CASE_INSERT & CHR(10)
          ENDIF
          IF LEFT(CASE_HEADER, 9) <> "OTHERWISE" THEN
            CASE_TO ← 0
            INDEX ← 1
            WHILE INDEX <= LENGTH(CASE_HEADER)
              IF MID(CASE_HEADER, INDEX, 4) = " TO " THEN
                CASE_TO ← INDEX
              ENDIF
              INDEX ← INDEX + 1
            ENDWHILE
            IF CASE_TO = 0 THEN
              CASE_CONDITION ← CASE_EXPR & " = "
              CASE_CONDITION ← CASE_CONDITION & CASE_HEADER
            ELSE
              NAME_LENGTH ← CASE_TO - 1
              CASE_CONDITION ← CASE_EXPR & " >= "
              CASE_CONDITION ← CASE_CONDITION & LEFT(CASE_HEADER, NAME_LENGTH)
              CASE_CONDITION ← CASE_CONDITION & " AND "
              CASE_CONDITION ← CASE_CONDITION & CASE_EXPR
              CASE_CONDITION ← CASE_CONDITION & " <= "
              START_POSITION ← CASE_TO + 4
              LINE_LENGTH ← LENGTH(CASE_HEADER)
              CASE_CONDITION ← CASE_CONDITION & MID(CASE_HEADER, START_POSITION, LINE_LENGTH)
            ENDIF
            CASE_INSERT ← CASE_INSERT & "IF "
            CASE_INSERT ← CASE_INSERT & CASE_CONDITION
            CASE_INSERT ← CASE_INSERT & " THEN"
            CASE_INSERT ← CASE_INSERT & CHR(10)
            CASE_ARMS ← CASE_ARMS + 1
          ENDIF
          IF CASE_BODY <> "" THEN
            CASE_INSERT ← CASE_INSERT & CASE_BODY
            CASE_INSERT ← CASE_INSERT & CHR(10)
          ENDIF
          START_POSITION ← POSITION - 1
          LEFT_PART ← LEFT(SOURCE, START_POSITION)
          LINE_LENGTH ← LENGTH(SOURCE)
          RIGHT_PART ← MID(SOURCE, POSITION, LINE_LENGTH)
          SOURCE ← LEFT_PART & CASE_INSERT
          SOURCE ← SOURCE & RIGHT_PART
          MODE ← "SKIP"
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 6) = "CLASS " THEN
      CLASS_ACTIVE ← 1
      CLASS_FIELDS ← ""
      CLASS_PARENT ← ""
      CLASS_INHERITS ← 0
      INDEX ← 1
      WHILE INDEX <= LENGTH(LINE)
        IF MID(LINE, INDEX, 10) = " INHERITS " THEN
          CLASS_INHERITS ← INDEX
        ENDIF
        INDEX ← INDEX + 1
      ENDWHILE
      IF CLASS_INHERITS = 0 THEN
        LINE_LENGTH ← LENGTH(LINE)
        CLASS_NAME ← MID(LINE, 7, LINE_LENGTH)
      ELSE
        NAME_LENGTH ← CLASS_INHERITS - 7
        CLASS_NAME ← MID(LINE, 7, NAME_LENGTH)
        START_POSITION ← CLASS_INHERITS + 10
        LINE_LENGTH ← LENGTH(LINE)
        CLASS_PARENT ← MID(LINE, START_POSITION, LINE_LENGTH)
      ENDIF
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "ENDCLASS" THEN
      RECORD_LINE ← "M:CLASS:" & CLASS_NAME
      RECORD_LINE ← RECORD_LINE & ":"
      RECORD_LINE ← RECORD_LINE & CLASS_PARENT
      RECORD_LINE ← RECORD_LINE & ":"
      RECORD_LINE ← RECORD_LINE & CLASS_FIELDS
      OUTPUT RECORD_LINE
      CLASS_ACTIVE ← 0
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF CLASS_ACTIVE = 1 AND ROUTINE_ACTIVE = 0 THEN
      IF LEFT(LINE, 9) <> "FUNCTION " AND LEFT(LINE, 10) <> "PROCEDURE " THEN
        CLASS_INHERITS ← 0
        INDEX ← 1
        WHILE INDEX <= LENGTH(LINE)
          IF MID(LINE, INDEX, 1) = ":" THEN
            CLASS_INHERITS ← INDEX
          ENDIF
          INDEX ← INDEX + 1
        ENDWHILE
        IF CLASS_INHERITS > 0 THEN
          NAME_LENGTH ← CLASS_INHERITS - 2
          NAME ← LEFT(LINE, NAME_LENGTH)
          START_POSITION ← CLASS_INHERITS + 2
          LINE_LENGTH ← LENGTH(LINE)
          TYPE_TEXT ← MID(LINE, START_POSITION, LINE_LENGTH)
          CLASS_FIELDS ← CLASS_FIELDS & NAME
          CLASS_FIELDS ← CLASS_FIELDS & ","
          CLASS_FIELDS ← CLASS_FIELDS & TYPE_TEXT
          CLASS_FIELDS ← CLASS_FIELDS & ","
          CLASS_FIELDS ← CLASS_FIELDS & CLASS_ACCESS
          CLASS_FIELDS ← CLASS_FIELDS & ";"
          MODE ← "SKIP"
        ENDIF
      ENDIF
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 9) = "FUNCTION " OR LEFT(LINE, 10) = "PROCEDURE " THEN
      ROUTINE_KIND ← "FUNCTION"
      START_POSITION ← 10
      IF LEFT(LINE, 10) = "PROCEDURE " THEN
        ROUTINE_KIND ← "PROCEDURE"
        START_POSITION ← 11
      ENDIF
      ROUTINE_OPEN ← 0
      ROUTINE_CLOSE ← 0
      INDEX ← 1
      WHILE INDEX <= LENGTH(LINE)
        IF MID(LINE, INDEX, 1) = "(" THEN
          IF ROUTINE_OPEN = 0 THEN
            ROUTINE_OPEN ← INDEX
          ENDIF
        ENDIF
        IF MID(LINE, INDEX, 1) = ")" THEN
          ROUTINE_CLOSE ← INDEX
        ENDIF
        INDEX ← INDEX + 1
      ENDWHILE
      NAME_LENGTH ← ROUTINE_OPEN - START_POSITION
      ROUTINE_NAME ← MID(LINE, START_POSITION, NAME_LENGTH)
      ROUTINE_RETURN ← ""
      INDEX ← ROUTINE_CLOSE + 1
      WHILE INDEX <= LENGTH(LINE)
        IF MID(LINE, INDEX, 9) = " RETURNS " THEN
          START_POSITION ← INDEX + 9
          LINE_LENGTH ← LENGTH(LINE)
          ROUTINE_RETURN ← MID(LINE, START_POSITION, LINE_LENGTH)
        ENDIF
        INDEX ← INDEX + 1
      ENDWHILE
      START_POSITION ← ROUTINE_OPEN + 1
      ARG_LENGTH ← ROUTINE_CLOSE - START_POSITION
      PARAMS ← MID(LINE, START_POSITION, ARG_LENGTH)
      PARAMS ← PARAMS & ","
      PARAM_SPEC ← ""
      BYREF_FLAGS ← ""
      PARAM_POSITION ← 1
      WHILE PARAM_POSITION <= LENGTH(PARAMS)
        PARAM ← ""
        CHARACTER ← MID(PARAMS, PARAM_POSITION, 1)
        WHILE CHARACTER <> ","
          PARAM ← PARAM & CHARACTER
          PARAM_POSITION ← PARAM_POSITION + 1
          CHARACTER ← MID(PARAMS, PARAM_POSITION, 1)
        ENDWHILE
        PARAM_POSITION ← PARAM_POSITION + 1
        WHILE LEFT(PARAM, 1) = " "
          PARAM ← MID(PARAM, 2, LENGTH(PARAM))
        ENDWHILE
        IF PARAM <> "" THEN
          IS_BYREF ← 0
          IF LEFT(PARAM, 6) = "BYREF " THEN
            IS_BYREF ← 1
            PARAM ← MID(PARAM, 7, LENGTH(PARAM))
          ENDIF
          IF LEFT(PARAM, 6) = "BYVAL " THEN
            PARAM ← MID(PARAM, 7, LENGTH(PARAM))
          ENDIF
          PARAM_COLON ← 0
          INDEX ← 1
          WHILE INDEX <= LENGTH(PARAM)
            IF MID(PARAM, INDEX, 1) = ":" THEN
              PARAM_COLON ← INDEX
            ENDIF
            INDEX ← INDEX + 1
          ENDWHILE
          NAME_LENGTH ← PARAM_COLON - 1
          PARAM_NAME ← LEFT(PARAM, NAME_LENGTH)
          WHILE RIGHT(PARAM_NAME, 1) = " "
            NAME_LENGTH ← LENGTH(PARAM_NAME)
            NAME_LENGTH ← NAME_LENGTH - 1
            PARAM_NAME ← LEFT(PARAM_NAME, NAME_LENGTH)
          ENDWHILE
          START_POSITION ← PARAM_COLON + 1
          PARAM_TYPE ← MID(PARAM, START_POSITION, LENGTH(PARAM))
          WHILE LEFT(PARAM_TYPE, 1) = " "
            PARAM_TYPE ← MID(PARAM_TYPE, 2, LENGTH(PARAM_TYPE))
          ENDWHILE
          PARAM_SPEC ← PARAM_SPEC & PARAM_NAME
          PARAM_SPEC ← PARAM_SPEC & ","
          PARAM_SPEC ← PARAM_SPEC & PARAM_TYPE
          PARAM_SPEC ← PARAM_SPEC & ","
          IF IS_BYREF = 1 THEN
            PARAM_SPEC ← PARAM_SPEC & "1;"
            BYREF_FLAGS ← BYREF_FLAGS & "1"
          ELSE
            PARAM_SPEC ← PARAM_SPEC & "0;"
            BYREF_FLAGS ← BYREF_FLAGS & "0"
          ENDIF
        ENDIF
      ENDWHILE
      EXPORT_NAME ← ROUTINE_NAME
      METHOD_MODE ← 0
      IF CLASS_ACTIVE = 1 THEN
        EXPORT_NAME ← CLASS_NAME & "."
        EXPORT_NAME ← EXPORT_NAME & ROUTINE_NAME
        METHOD_MODE ← 1
      ENDIF
      ROUTINE_MAP ← ROUTINE_MAP & "|"
      ROUTINE_MAP ← ROUTINE_MAP & EXPORT_NAME
      ROUTINE_MAP ← ROUTINE_MAP & "="
      VALUE ← ROUTINE_COUNT + 1
      ROUTINE_MAP ← ROUTINE_MAP & CHR(VALUE)
      ROUTINE_REF_MAP ← ROUTINE_REF_MAP & "|"
      ROUTINE_REF_MAP ← ROUTINE_REF_MAP & EXPORT_NAME
      ROUTINE_REF_MAP ← ROUTINE_REF_MAP & "="
      ROUTINE_REF_MAP ← ROUTINE_REF_MAP & BYREF_FLAGS
      ROUTINE_REF_MAP ← ROUTINE_REF_MAP & CHR(30)
      ROUTINE_COUNT ← ROUTINE_COUNT + 1
      IF METHOD_MODE = 1 THEN
        RECORD_LINE ← "M:METHOD:" & CLASS_NAME
        RECORD_LINE ← RECORD_LINE & ":"
        RECORD_LINE ← RECORD_LINE & ROUTINE_KIND
      ELSE
        RECORD_LINE ← "M:ROUTINE:" & ROUTINE_KIND
      ENDIF
      RECORD_LINE ← RECORD_LINE & ":"
      RECORD_LINE ← RECORD_LINE & ROUTINE_NAME
      RECORD_LINE ← RECORD_LINE & ":"
      RECORD_LINE ← RECORD_LINE & ROUTINE_RETURN
      RECORD_LINE ← RECORD_LINE & ":"
      RECORD_LINE ← RECORD_LINE & PARAM_SPEC
      IF METHOD_MODE = 1 THEN
        RECORD_LINE ← RECORD_LINE & ":"
        RECORD_LINE ← RECORD_LINE & CLASS_ACCESS
      ENDIF
      OUTPUT RECORD_LINE
      OUTPUT "R:" & EXPORT_NAME
      ROUTINE_ACTIVE ← 1
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "ENDFUNCTION" OR LINE = "ENDPROCEDURE" THEN
      OUTPUT "ENDROUTINE"
      ROUTINE_ACTIVE ← 0
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 7) = "RETURN " THEN
      MODE ← "RETURN"
      LINE_LENGTH ← LENGTH(LINE)
      EXPR ← MID(LINE, 8, LINE_LENGTH)
    ENDIF
    IF LINE = "RETURN" THEN
      MODE ← "RETURN"
      EXPR ← "NULL"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 5) = "CALL " THEN
      MODE ← "CALLSTMT"
      LINE_LENGTH ← LENGTH(LINE)
      EXPR ← MID(LINE, 6, LINE_LENGTH)
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 5) = "TYPE " THEN
      TYPE_EQUALS ← 0
      INDEX ← 1
      WHILE INDEX <= LENGTH(LINE)
        IF MID(LINE, INDEX, 1) = "=" THEN
          TYPE_EQUALS ← INDEX
        ENDIF
        INDEX ← INDEX + 1
      ENDWHILE
      IF TYPE_EQUALS = 0 THEN
        TYPE_RECORD ← 1
        LINE_LENGTH ← LENGTH(LINE)
        TYPE_NAME ← MID(LINE, 6, LINE_LENGTH)
        TYPE_FIELDS ← ""
      ELSE
        NAME_LENGTH ← TYPE_EQUALS - 7
        TYPE_NAME ← MID(LINE, 6, NAME_LENGTH)
        START_POSITION ← TYPE_EQUALS + 2
        LINE_LENGTH ← LENGTH(LINE)
        TYPE_TEXT ← MID(LINE, START_POSITION, LINE_LENGTH)
        TYPE_SPEC ← "NAMED|" & TYPE_TEXT
        IF LEFT(TYPE_TEXT, 6) = "ARRAY[" THEN
          TYPE_CLOSE ← 0
          INDEX ← 1
          WHILE INDEX <= LENGTH(TYPE_TEXT)
            IF MID(TYPE_TEXT, INDEX, 1) = "]" THEN
              TYPE_CLOSE ← INDEX
            ENDIF
            INDEX ← INDEX + 1
          ENDWHILE
          NAME_LENGTH ← TYPE_CLOSE - 7
          ARRAY_RANGES ← MID(TYPE_TEXT, 7, NAME_LENGTH)
          TYPE_SPEC ← CHR(31) & "ARRAY"
          TYPE_SPEC ← TYPE_SPEC & "|"
          TYPE_SPEC ← TYPE_SPEC & ARRAY_RANGES
          TYPE_SPEC ← TYPE_SPEC & "|"
          START_POSITION ← TYPE_CLOSE + 5
          LINE_LENGTH ← LENGTH(TYPE_TEXT)
          TYPE_SPEC ← TYPE_SPEC & MID(TYPE_TEXT, START_POSITION, LINE_LENGTH)
        ENDIF
        IF LEFT(TYPE_TEXT, 7) = "SET OF " THEN
          TYPE_SPEC ← "SET|" & MID(TYPE_TEXT, 8, LENGTH(TYPE_TEXT))
        ENDIF
        IF LEFT(TYPE_TEXT, 1) = "^" THEN
          TYPE_SPEC ← "POINTER|" & MID(TYPE_TEXT, 2, LENGTH(TYPE_TEXT))
        ENDIF
        IF LEFT(TYPE_TEXT, 1) = "(" THEN
          NAME_LENGTH ← LENGTH(TYPE_TEXT)
          NAME_LENGTH ← NAME_LENGTH - 2
          TYPE_SPEC ← "ENUM|" & MID(TYPE_TEXT, 2, NAME_LENGTH)
        ENDIF
        RECORD_LINE ← "M:TYPE:" & TYPE_NAME
        RECORD_LINE ← RECORD_LINE & ":"
        RECORD_LINE ← RECORD_LINE & TYPE_SPEC
        OUTPUT RECORD_LINE
      ENDIF
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "ENDTYPE" THEN
      IF TYPE_RECORD = 1 THEN
        RECORD_LINE ← "M:TYPE:" & TYPE_NAME
        RECORD_LINE ← RECORD_LINE & ":RECORD:"
        RECORD_LINE ← RECORD_LINE & TYPE_FIELDS
        OUTPUT RECORD_LINE
        TYPE_RECORD ← 0
      ELSE
        OUTPUT "ERROR:" & NUM_TO_STR(SOURCE_LINE) & ":" & LINE
      ENDIF
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 9) = "CONSTANT " THEN
      OP_POSITION ← 0
      INDEX ← 1
      WHILE INDEX <= LENGTH(LINE)
        IF MID(LINE, INDEX, 1) = "=" THEN
          OP_POSITION ← INDEX
        ENDIF
        INDEX ← INDEX + 1
      ENDWHILE
      NAME_LENGTH ← OP_POSITION - 11
      NAME ← MID(LINE, 10, NAME_LENGTH)
      START_POSITION ← OP_POSITION + 2
      LINE_LENGTH ← LENGTH(LINE)
      EXPR ← MID(LINE, START_POSITION, LINE_LENGTH)
      OUTPUT "M:CONST:" & NAME & ":" & EXPR
      OUTPUT "I:" & NAME
      OUTPUT "I:$CONSTANT"
      MODE ← "CONSTANT"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 8) = "DECLARE " THEN
      INDEX ← 9
      CHARACTER ← MID(LINE, INDEX, 1)
      WHILE CHARACTER <> ":" AND INDEX <= LENGTH(LINE)
        INDEX ← INDEX + 1
        CHARACTER ← MID(LINE, INDEX, 1)
      ENDWHILE
      NAME_LENGTH ← INDEX - 9
      NAME ← MID(LINE, 9, NAME_LENGTH)
      WHILE RIGHT(NAME, 1) = " "
        NAME ← LEFT(NAME, LENGTH(NAME) - 1)
      ENDWHILE
      START_POSITION ← INDEX + 1
      LINE_LENGTH ← LENGTH(LINE)
      TYPE_TEXT ← MID(LINE, START_POSITION, LINE_LENGTH)
      WHILE LEFT(TYPE_TEXT, 1) = " "
        TYPE_TEXT ← MID(TYPE_TEXT, 2, LENGTH(TYPE_TEXT))
      ENDWHILE
      IF TYPE_RECORD = 1 THEN
        TYPE_FIELDS ← TYPE_FIELDS & NAME
        TYPE_FIELDS ← TYPE_FIELDS & ","
        TYPE_FIELDS ← TYPE_FIELDS & TYPE_TEXT
        TYPE_FIELDS ← TYPE_FIELDS & ";"
      ELSE
        IF LEFT(TYPE_TEXT, 6) = "ARRAY[" THEN
          TYPE_CLOSE ← 0
          INDEX ← 1
          WHILE INDEX <= LENGTH(TYPE_TEXT)
            IF MID(TYPE_TEXT, INDEX, 1) = "]" THEN
              TYPE_CLOSE ← INDEX
            ENDIF
            INDEX ← INDEX + 1
          ENDWHILE
          NAME_LENGTH ← TYPE_CLOSE - 7
          ARRAY_RANGES ← MID(TYPE_TEXT, 7, NAME_LENGTH)
          TYPE_SPEC ← CHR(31) & "ARRAY"
          TYPE_SPEC ← TYPE_SPEC & "|"
          TYPE_SPEC ← TYPE_SPEC & ARRAY_RANGES
          TYPE_SPEC ← TYPE_SPEC & "|"
          START_POSITION ← TYPE_CLOSE + 5
          LINE_LENGTH ← LENGTH(TYPE_TEXT)
          TYPE_SPEC ← TYPE_SPEC & MID(TYPE_TEXT, START_POSITION, LINE_LENGTH)
          TYPE_TEXT ← TYPE_SPEC
        ENDIF
        IF LEFT(TYPE_TEXT, 1) = CHR(31) THEN
          OUTPUT "I:" & NAME
          OUTPUT "I:" & TYPE_TEXT
          OUTPUT "I:" & TYPE_TEXT
          OUTPUT "ARGS"
          MODE ← "ARRAY_DECL"
        ELSE
          CANDIDATE ← ""
          SCAN ← 1
          WHILE SCAN <= LENGTH(NAME) + 1
            CHARACTER ← MID(NAME, SCAN, 1)
            IF CHARACTER = "," OR SCAN > LENGTH(NAME) THEN
              WHILE LEFT(CANDIDATE, 1) = " "
                CANDIDATE ← MID(CANDIDATE, 2, LENGTH(CANDIDATE))
              ENDWHILE
              WHILE RIGHT(CANDIDATE, 1) = " "
                CANDIDATE ← LEFT(CANDIDATE, LENGTH(CANDIDATE) - 1)
              ENDWHILE
              OUTPUT "I:" & CANDIDATE
              OUTPUT "I:" & TYPE_TEXT
              OUTPUT "I:" & TYPE_TEXT
              OUTPUT "ARGS"
              OUTPUT "CREATE"
              OUTPUT "DECLARE"
              CANDIDATE ← ""
            ELSE
              CANDIDATE ← CANDIDATE & CHARACTER
            ENDIF
            SCAN ← SCAN + 1
          ENDWHILE
        ENDIF
      ENDIF
      IF MODE <> "ARRAY_DECL" THEN
        MODE ← "SKIP"
      ENDIF
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 7) = "DEFINE " THEN
      DEFINE_OPEN ← 0
      DEFINE_CLOSE ← 0
      INDEX ← 1
      WHILE INDEX <= LENGTH(LINE)
        IF MID(LINE, INDEX, 1) = "(" THEN
          DEFINE_OPEN ← INDEX
        ENDIF
        IF MID(LINE, INDEX, 1) = ")" THEN
          DEFINE_CLOSE ← INDEX
        ENDIF
        INDEX ← INDEX + 1
      ENDWHILE
      NAME_LENGTH ← DEFINE_OPEN - 8
      NAME ← MID(LINE, 8, NAME_LENGTH)
      START_POSITION ← DEFINE_CLOSE + 4
      LINE_LENGTH ← LENGTH(LINE)
      TYPE_TEXT ← MID(LINE, START_POSITION, LINE_LENGTH)
      START_POSITION ← DEFINE_OPEN + 1
      ARG_LENGTH ← DEFINE_CLOSE - START_POSITION
      ARGUMENTS ← MID(LINE, START_POSITION, ARG_LENGTH)
      OUTPUT "I:" & NAME
      OUTPUT "I:" & TYPE_TEXT
      OUTPUT "ARGS"
      MODE ← "DEFINE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "ELSE" THEN
      OUTPUT "ELSE"
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "ENDIF" THEN
      OUTPUT "ENDIF"
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "ENDWHILE" THEN
      OUTPUT "ENDWHILE"
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "REPEAT" THEN
      OUTPUT "REPEAT"
      OUTPUT "T:" & NUM_TO_STR(SOURCE_LINE)
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 6) = "UNTIL " THEN
      MODE ← "UNTIL"
      LINE_LENGTH ← LENGTH(LINE)
      EXPR ← MID(LINE, 7, LINE_LENGTH)
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 4) = "FOR " THEN
      MODE ← "FOR"
      ARROW_POSITION ← 0
      TO_POSITION ← 0
      STEP_POSITION ← 0
      INDEX ← 1
      WHILE INDEX <= LENGTH(LINE)
        IF MID(LINE, INDEX, 1) = "←" THEN
          ARROW_POSITION ← INDEX
        ENDIF
        IF MID(LINE, INDEX, 4) = " TO " THEN
          TO_POSITION ← INDEX
        ENDIF
        IF MID(LINE, INDEX, 6) = " STEP " THEN
          STEP_POSITION ← INDEX
        ENDIF
        INDEX ← INDEX + 1
      ENDWHILE
      IF TO_POSITION = 0 THEN
        OUTPUT "ERROR:" & NUM_TO_STR(SOURCE_LINE) & ":" & LINE
        MODE ← "SKIP"
      ELSE
        NAME_LENGTH ← ARROW_POSITION - 5
        NAME ← MID(LINE, 5, NAME_LENGTH)
        WHILE RIGHT(NAME, 1) = " "
          NAME ← LEFT(NAME, LENGTH(NAME) - 1)
        ENDWHILE
        START_POSITION ← ARROW_POSITION + 1
        EXPR_LENGTH ← TO_POSITION - START_POSITION
        FROM_EXPR ← MID(LINE, START_POSITION, EXPR_LENGTH)
        START_POSITION ← TO_POSITION + 4
        IF STEP_POSITION = 0 THEN
          LINE_LENGTH ← LENGTH(LINE)
          TO_EXPR ← MID(LINE, START_POSITION, LINE_LENGTH)
          STEP_EXPR ← "1"
        ELSE
          EXPR_LENGTH ← STEP_POSITION - START_POSITION
          TO_EXPR ← MID(LINE, START_POSITION, EXPR_LENGTH)
          START_POSITION ← STEP_POSITION + 6
          LINE_LENGTH ← LENGTH(LINE)
          STEP_EXPR ← MID(LINE, START_POSITION, LINE_LENGTH)
        ENDIF
        FOR_COUNTER ← FOR_COUNTER + 1
        FOR_END_NAME ← "__FOR_END_" & NUM_TO_STR(FOR_COUNTER)
        FOR_STEP_NAME ← "__FOR_STEP_" & NUM_TO_STR(FOR_COUNTER)
        OUTPUT "I:" & FOR_END_NAME
        OUTPUT "I:INTEGER"
        OUTPUT "I:INTEGER"
        OUTPUT "ARGS"
        OUTPUT "CREATE"
        OUTPUT "LOOPDECLARE"
        OUTPUT "I:" & FOR_STEP_NAME
        OUTPUT "I:INTEGER"
        OUTPUT "I:INTEGER"
        OUTPUT "ARGS"
        OUTPUT "CREATE"
        OUTPUT "LOOPDECLARE"
        OUTPUT "I:" & NAME
        FOR_ENTRY ← NAME & "|"
        FOR_ENTRY ← FOR_ENTRY & FOR_STEP_NAME
        FOR_STACK ← FOR_STACK & CHR(30)
        FOR_STACK ← FOR_STACK & FOR_ENTRY
      ENDIF
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 4) = "NEXT" THEN
      IF FOR_STACK = "" THEN
        OUTPUT "ERROR:" & NUM_TO_STR(SOURCE_LINE) & ":" & LINE
      ELSE
        FOR_SEPARATOR ← 1
        INDEX ← 1
        WHILE INDEX <= LENGTH(FOR_STACK)
          IF MID(FOR_STACK, INDEX, 1) = CHR(30) THEN
            FOR_SEPARATOR ← INDEX
          ENDIF
          INDEX ← INDEX + 1
        ENDWHILE
        START_POSITION ← FOR_SEPARATOR + 1
        LINE_LENGTH ← LENGTH(FOR_STACK)
        FOR_ENTRY ← MID(FOR_STACK, START_POSITION, LINE_LENGTH)
        NAME_LENGTH ← FOR_SEPARATOR - 1
        FOR_STACK ← LEFT(FOR_STACK, NAME_LENGTH)
        INDEX ← 1
        WHILE MID(FOR_ENTRY, INDEX, 1) <> "|"
          INDEX ← INDEX + 1
        ENDWHILE
        NAME_LENGTH ← INDEX - 1
        NAME ← LEFT(FOR_ENTRY, NAME_LENGTH)
        START_POSITION ← INDEX + 1
        LINE_LENGTH ← LENGTH(FOR_ENTRY)
        FOR_STEP_NAME ← MID(FOR_ENTRY, START_POSITION, LINE_LENGTH)
        OUTPUT "I:" & NAME
        OUTPUT "O:+"
        OUTPUT "I:" & NAME
        OUTPUT "GET"
        OUTPUT "I:" & FOR_STEP_NAME
        OUTPUT "GET"
        OUTPUT "BINARY"
        OUTPUT "SET"
        OUTPUT "ENDWHILE"
      ENDIF
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 3) = "IF " THEN
      MODE ← "IF"
      EXPR_LENGTH ← LENGTH(LINE)
      EXPR_LENGTH ← EXPR_LENGTH - 8
      EXPR ← MID(LINE, 4, EXPR_LENGTH)
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 6) = "WHILE " THEN
      MODE ← "WHILE"
      LINE_LENGTH ← LENGTH(LINE)
      EXPR ← MID(LINE, 7, LINE_LENGTH)
      OUTPUT "WHILE"
      OUTPUT "T:" & NUM_TO_STR(SOURCE_LINE)
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 7) = "OUTPUT " THEN
      MODE ← "OUTPUT"
      LINE_LENGTH ← LENGTH(LINE)
      EXPR ← MID(LINE, 8, LINE_LENGTH)
      OUTPUT "ARGS"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    FILE_OP ← -1
    OP_LENGTH ← 0
    FILE_REF_POSITION ← 0
    FILE_ARG_COUNT ← 2
    IF LEFT(LINE, 9) = "OPENFILE " THEN
      FILE_OP ← 0
      OP_LENGTH ← 8
    ENDIF
    IF LEFT(LINE, 10) = "CLOSEFILE " THEN
      FILE_OP ← 1
      OP_LENGTH ← 9
      FILE_ARG_COUNT ← 1
    ENDIF
    IF LEFT(LINE, 9) = "READFILE " THEN
      FILE_OP ← 2
      OP_LENGTH ← 8
      FILE_REF_POSITION ← 2
    ENDIF
    IF LEFT(LINE, 10) = "WRITEFILE " THEN
      FILE_OP ← 3
      OP_LENGTH ← 9
    ENDIF
    IF LEFT(LINE, 5) = "SEEK " THEN
      FILE_OP ← 4
      OP_LENGTH ← 4
    ENDIF
    IF LEFT(LINE, 10) = "GETRECORD " THEN
      FILE_OP ← 5
      OP_LENGTH ← 9
      FILE_REF_POSITION ← 2
    ENDIF
    IF LEFT(LINE, 10) = "PUTRECORD " THEN
      FILE_OP ← 6
      OP_LENGTH ← 9
    ENDIF
    IF FILE_OP >= 0 THEN
      START_POSITION ← OP_LENGTH + 2
      LINE_LENGTH ← LENGTH(LINE)
      ARGUMENTS ← MID(LINE, START_POSITION, LINE_LENGTH)
      IF FILE_OP = 0 THEN
        FILE_FOR_POSITION ← 0
        INDEX ← 1
        WHILE INDEX <= LENGTH(ARGUMENTS)
          IF MID(ARGUMENTS, INDEX, 5) = " FOR " THEN
            FILE_FOR_POSITION ← INDEX
          ENDIF
          INDEX ← INDEX + 1
        ENDWHILE
        NAME_LENGTH ← FILE_FOR_POSITION - 1
        LEFT_PART ← LEFT(ARGUMENTS, NAME_LENGTH)
        START_POSITION ← FILE_FOR_POSITION + 5
        LINE_LENGTH ← LENGTH(ARGUMENTS)
        FILE_MODE ← MID(ARGUMENTS, START_POSITION, LINE_LENGTH)
        ARGUMENTS ← LEFT_PART & ", "
        ARGUMENTS ← ARGUMENTS & CHR(34)
        ARGUMENTS ← ARGUMENTS & FILE_MODE
        ARGUMENTS ← ARGUMENTS & CHR(34)
      ENDIF
      OUTPUT "F:" & NUM_TO_STR(FILE_OP)
      OUTPUT "ARGS"
      MODE ← "FILE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 6) = "INPUT " THEN
      LINE_LENGTH ← LENGTH(LINE)
      ARGUMENTS ← MID(LINE, 7, LINE_LENGTH)
      NAME ← ""
      INDEX ← 1
      WHILE INDEX <= LENGTH(ARGUMENTS) + 1
        CHARACTER ← MID(ARGUMENTS, INDEX, 1)
        IF CHARACTER = "," OR INDEX > LENGTH(ARGUMENTS) THEN
          WHILE LEFT(NAME, 1) = " "
            NAME ← MID(NAME, 2, LENGTH(NAME))
          ENDWHILE
          WHILE RIGHT(NAME, 1) = " "
            NAME ← LEFT(NAME, LENGTH(NAME) - 1)
          ENDWHILE
          OUTPUT "I:" & NAME
          OUTPUT "REFNAME"
          OUTPUT "INPUT"
          NAME ← ""
        ELSE
          NAME ← NAME & CHARACTER
        ENDIF
        INDEX ← INDEX + 1
      ENDWHILE
      MODE ← "SKIP"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    INDEX ← 1
    OP_POSITION ← 0
    WHILE INDEX <= LENGTH(LINE)
      IF OP_POSITION = 0 THEN
        IF MID(LINE, INDEX, 1) = "←" THEN
          OP_POSITION ← INDEX
        ENDIF
      ENDIF
      INDEX ← INDEX + 1
    ENDWHILE
    IF OP_POSITION > 0 THEN
      MODE ← "ASSIGN"
      NAME_LENGTH ← OP_POSITION - 1
      NAME ← LEFT(LINE, NAME_LENGTH)
      WHILE RIGHT(NAME, 1) = " "
        NAME ← LEFT(NAME, LENGTH(NAME) - 1)
      ENDWHILE
      START_POSITION ← OP_POSITION + 1
      LINE_LENGTH ← LENGTH(LINE)
      EXPR ← MID(LINE, START_POSITION, LINE_LENGTH)
      FIELD_POSITION ← 0
      INDEX_POSITION ← 0
      INDEX ← 1
      WHILE INDEX <= LENGTH(NAME)
        IF MID(NAME, INDEX, 1) = "." THEN
          FIELD_POSITION ← INDEX
        ENDIF
        IF MID(NAME, INDEX, 1) = "[" THEN
          INDEX_POSITION ← INDEX
        ENDIF
        INDEX ← INDEX + 1
      ENDWHILE
      IF RIGHT(NAME, 1) = "^" THEN
        NAME_LENGTH ← LENGTH(NAME)
        NAME_LENGTH ← NAME_LENGTH - 1
        TARGET_NAME ← LEFT(NAME, NAME_LENGTH)
        OUTPUT "I:" & TARGET_NAME
        OUTPUT "GET"
        MODE ← "ASSIGN_DEREF"
      ELSE
      IF INDEX_POSITION > 0 THEN
        NAME_LENGTH ← INDEX_POSITION - 1
        TARGET_NAME ← LEFT(NAME, NAME_LENGTH)
        TYPE_CLOSE ← 0
        INDEX ← INDEX_POSITION
        WHILE INDEX <= LENGTH(NAME)
          IF MID(NAME, INDEX, 1) = "]" THEN
            TYPE_CLOSE ← INDEX
          ENDIF
          INDEX ← INDEX + 1
        ENDWHILE
        START_POSITION ← INDEX_POSITION + 1
        ARG_LENGTH ← TYPE_CLOSE - START_POSITION
        INDEX_ARGS ← MID(NAME, START_POSITION, ARG_LENGTH)
        OUTPUT "I:" & TARGET_NAME
        OUTPUT "GET"
        OUTPUT "ARGS"
        IF TYPE_CLOSE < LENGTH(NAME) THEN
          START_POSITION ← TYPE_CLOSE + 2
          LINE_LENGTH ← LENGTH(NAME)
          FIELD_NAME ← MID(NAME, START_POSITION, LINE_LENGTH)
          MODE ← "ASSIGN_INDEX_FIELD"
        ELSE
          MODE ← "ASSIGN_INDEX"
        ENDIF
      ELSE
        IF FIELD_POSITION = 0 THEN
          OUTPUT "I:" & NAME
        ELSE
          NAME_LENGTH ← FIELD_POSITION - 1
          TARGET_NAME ← LEFT(NAME, NAME_LENGTH)
          START_POSITION ← FIELD_POSITION + 1
          LINE_LENGTH ← LENGTH(NAME)
          FIELD_NAME ← MID(NAME, START_POSITION, LINE_LENGTH)
          OUTPUT "I:" & TARGET_NAME
          OUTPUT "GET"
          OUTPUT "I:" & FIELD_NAME
          MODE ← "ASSIGN_FIELD"
        ENDIF
      ENDIF
      ENDIF
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF RIGHT(LINE, 1) = ")" THEN
      MODE ← "CALLSTMT"
      EXPR ← LINE
    ENDIF
  ENDIF
  IF MODE = "" THEN
    OUTPUT "ERROR:" & NUM_TO_STR(SOURCE_LINE) & ":" & LINE
    MODE ← "SKIP"
  ENDIF
  IF MODE <> "SKIP" THEN
    IF MODE = "FOR" THEN
      WORK ← "F3"
      WORK ← WORK & CHR(30)
      WORK ← WORK & "E:"
      WORK ← WORK & STEP_EXPR
      WORK ← WORK & CHR(30)
      WORK ← WORK & "F2"
      WORK ← WORK & CHR(30)
      WORK ← WORK & "E:"
      WORK ← WORK & TO_EXPR
      WORK ← WORK & CHR(30)
      WORK ← WORK & "F1"
      WORK ← WORK & CHR(30)
      WORK ← WORK & "E:"
      WORK ← WORK & FROM_EXPR
    ELSE
    IF MODE = "OUTPUT" THEN
      WORK ← "Q"
      ARGUMENTS ← EXPR
    ENDIF
    IF MODE = "DEFINE" THEN
      WORK ← "D"
    ENDIF
    IF MODE = "FILE" THEN
      WORK ← "Y"
    ENDIF
    IF MODE = "ARRAY_DECL" THEN
      WORK ← "G"
      ARGUMENTS ← ""
      INDEX ← 1
      WHILE INDEX <= LENGTH(ARRAY_RANGES)
        CHARACTER ← MID(ARRAY_RANGES, INDEX, 1)
        IF CHARACTER = ":" THEN
          ARGUMENTS ← ARGUMENTS & ","
        ELSE
          ARGUMENTS ← ARGUMENTS & CHARACTER
        ENDIF
        INDEX ← INDEX + 1
      ENDWHILE
    ENDIF
    IF MODE = "ASSIGN_INDEX" THEN
      WORK ← "X"
      WORK ← WORK & CHR(30)
      WORK ← WORK & "E:"
      WORK ← WORK & EXPR
      ARGUMENTS ← INDEX_ARGS
    ENDIF
    IF MODE = "ASSIGN_INDEX_FIELD" THEN
      WORK ← "H"
      WORK ← WORK & CHR(30)
      WORK ← WORK & "E:"
      WORK ← WORK & EXPR
      WORK ← WORK & CHR(30)
      WORK ← WORK & "IF:"
      WORK ← WORK & FIELD_NAME
      WORK ← WORK & CHR(30)
      WORK ← WORK & "J"
      ARGUMENTS ← INDEX_ARGS
    ENDIF
    IF MODE = "OUTPUT" OR MODE = "ASSIGN_INDEX" OR MODE = "ASSIGN_INDEX_FIELD" OR MODE = "DEFINE" OR MODE = "FILE" OR MODE = "ARRAY_DECL" THEN
      ARG_POSITION ← LENGTH(ARGUMENTS)
      ARG_NUMBER ← 0
      IF MODE = "FILE" THEN
        ARG_NUMBER ← FILE_ARG_COUNT
      ENDIF
      ARGUMENT ← ""
      ARG_DEPTH ← 0
      ARG_IN_STRING ← 0
      WHILE ARG_POSITION >= 1
        CHARACTER ← MID(ARGUMENTS, ARG_POSITION, 1)
        IF CHARACTER = CHR(34) THEN
          IF ARG_IN_STRING = 0 THEN
            ARG_IN_STRING ← 1
          ELSE
            ARG_IN_STRING ← 0
          ENDIF
        ENDIF
        IF ARG_IN_STRING = 0 THEN
          IF CHARACTER = ")" THEN
            ARG_DEPTH ← ARG_DEPTH + 1
          ENDIF
          IF CHARACTER = "]" THEN
            ARG_DEPTH ← ARG_DEPTH + 1
          ENDIF
          IF CHARACTER = "(" THEN
            ARG_DEPTH ← ARG_DEPTH - 1
          ENDIF
          IF CHARACTER = "[" THEN
            ARG_DEPTH ← ARG_DEPTH - 1
          ENDIF
        ENDIF
        IF CHARACTER = "," THEN
          IF ARG_DEPTH = 0 AND ARG_IN_STRING = 0 THEN
            WHILE LEFT(ARGUMENT, 1) = " "
              ARGUMENT ← MID(ARGUMENT, 2, LENGTH(ARGUMENT))
            ENDWHILE
            WHILE RIGHT(ARGUMENT, 1) = " "
              ARG_LENGTH ← LENGTH(ARGUMENT)
              ARG_LENGTH ← ARG_LENGTH - 1
              ARGUMENT ← LEFT(ARGUMENT, ARG_LENGTH)
            ENDWHILE
            WORK ← WORK & CHR(30)
            WORK ← WORK & "P"
            WORK ← WORK & CHR(30)
            IF ARG_NUMBER = FILE_REF_POSITION THEN
              IF MODE = "FILE" THEN
                WORK ← WORK & "REFE:"
              ELSE
                WORK ← WORK & "E:"
              ENDIF
            ELSE
              WORK ← WORK & "E:"
            ENDIF
            WORK ← WORK & ARGUMENT
            ARGUMENT ← ""
            ARG_NUMBER ← ARG_NUMBER - 1
          ELSE
            ARGUMENT ← CHARACTER & ARGUMENT
          ENDIF
        ELSE
          ARGUMENT ← CHARACTER & ARGUMENT
        ENDIF
        ARG_POSITION ← ARG_POSITION - 1
      ENDWHILE
      WHILE LEFT(ARGUMENT, 1) = " "
        ARGUMENT ← MID(ARGUMENT, 2, LENGTH(ARGUMENT))
      ENDWHILE
      WHILE RIGHT(ARGUMENT, 1) = " "
        ARG_LENGTH ← LENGTH(ARGUMENT)
        ARG_LENGTH ← ARG_LENGTH - 1
        ARGUMENT ← LEFT(ARGUMENT, ARG_LENGTH)
      ENDWHILE
      WORK ← WORK & CHR(30)
      WORK ← WORK & "P"
      WORK ← WORK & CHR(30)
      IF ARG_NUMBER = FILE_REF_POSITION THEN
        IF MODE = "FILE" THEN
          WORK ← WORK & "REFE:"
        ELSE
          WORK ← WORK & "E:"
        ENDIF
      ELSE
        WORK ← WORK & "E:"
      ENDIF
      WORK ← WORK & ARGUMENT
    ELSE
      WORK ← "E:" & EXPR
    ENDIF
    ENDIF
    WHILE WORK <> ""
      FRAME_START ← 1
      FRAME_INDEX ← 1
      WHILE FRAME_INDEX <= LENGTH(WORK)
        IF MID(WORK, FRAME_INDEX, 1) = CHR(30) THEN
          FRAME_START ← FRAME_INDEX + 1
        ENDIF
        FRAME_INDEX ← FRAME_INDEX + 1
      ENDWHILE
      FRAME_LENGTH ← LENGTH(WORK)
      FRAME_LENGTH ← FRAME_LENGTH - FRAME_START
      FRAME_LENGTH ← FRAME_LENGTH + 1
      FRAME ← MID(WORK, FRAME_START, FRAME_LENGTH)
      IF FRAME_START = 1 THEN
        WORK ← ""
      ELSE
        FRAME_LENGTH ← FRAME_START - 2
        WORK ← LEFT(WORK, FRAME_LENGTH)
      ENDIF
      CASE OF FRAME
        "F1" :
          OUTPUT "SET"
          OUTPUT "I:" & FOR_END_NAME
          FRAME ← "Z"
        "F2" :
          OUTPUT "SET"
          OUTPUT "I:" & FOR_STEP_NAME
          FRAME ← "Z"
        "F3" :
          OUTPUT "SET"
          OUTPUT "WHILE"
          OUTPUT "T:" & NUM_TO_STR(SOURCE_LINE)
          OUTPUT "I:" & NAME
          OUTPUT "GET"
          OUTPUT "I:" & FOR_END_NAME
          OUTPUT "GET"
          OUTPUT "I:" & FOR_STEP_NAME
          OUTPUT "GET"
          OUTPUT "FOR_TEST"
          FRAME ← "Z"
        "J" :
          OUTPUT "INDEX"
          FRAME ← "Z"
        "X" :
          OUTPUT "SETINDEX"
          FRAME ← "Z"
        "D" :
          OUTPUT "DECLARE"
          FRAME ← "Z"
        "Y" :
          OUTPUT "FILEOP"
          OUTPUT "DROP"
          FRAME ← "Z"
        "G" :
          OUTPUT "CREATE"
          OUTPUT "DECLARE"
          FRAME ← "Z"
        "H" :
          OUTPUT "SETFIELD"
          FRAME ← "Z"
        "N" :
          OUTPUT "NEWOBJECT"
          FRAME ← "Z"
        "M" :
          OUTPUT "CALLMETHOD"
          FRAME ← "Z"
      ENDCASE
      IF LEFT(FRAME, 3) = "IF:" THEN
        OUTPUT "I:" & MID(FRAME, 4, LENGTH(FRAME))
        FRAME ← "Z"
      ENDIF
      IF LEFT(FRAME, 3) = "JF:" THEN
        OUTPUT "INDEX"
        OUTPUT "I:" & MID(FRAME, 4, LENGTH(FRAME))
        OUTPUT "FIELD"
        FRAME ← "Z"
      ENDIF
      IF LEFT(FRAME, 2) = "R:" THEN
        RECORD_LINE ← "CALLROUTINE:" & MID(FRAME, 3, LENGTH(FRAME))
        OUTPUT RECORD_LINE
        FRAME ← "Z"
      ENDIF
      IF LEFT(FRAME, 5) = "REFE:" THEN
        FRAME_LENGTH ← LENGTH(FRAME)
        ATOM ← MID(FRAME, 6, FRAME_LENGTH)
        OUTPUT "I:" & ATOM
        OUTPUT "REFNAME"
        FRAME ← "Z"
      ENDIF
      IF FRAME <> "Z" THEN
      CASE OF FRAME
        "B" : OUTPUT "BINARY"
        "P" : OUTPUT "PUSH"
        "C" : OUTPUT "CALLBUILTIN"
        "V" : OUTPUT "UNARY"
        "Q" : OUTPUT "OUTPUT"
        OTHERWISE :
              FRAME_LENGTH ← LENGTH(FRAME)
              EXPR ← MID(FRAME, 3, FRAME_LENGTH)
              WHILE LEFT(EXPR, 1) = " "
                EXPR ← MID(EXPR, 2, LENGTH(EXPR))
              ENDWHILE
              WHILE RIGHT(EXPR, 1) = " "
                EXPR ← LEFT(EXPR, LENGTH(EXPR) - 1)
              ENDWHILE
              SPLIT_OUTER ← 1
              WHILE SPLIT_OUTER = 1
                SPLIT_OUTER ← 0
                IF LEFT(EXPR, 1) = "(" THEN
                  IF RIGHT(EXPR, 1) = ")" THEN
                    SPLIT_OUTER ← 1
                    DEPTH ← 0
                    IN_STRING ← 0
                    INDEX ← 1
                    WHILE INDEX <= LENGTH(EXPR)
                      CHARACTER ← MID(EXPR, INDEX, 1)
                      IF CHARACTER = CHR(34) THEN
                        IF IN_STRING = 0 THEN
                          IN_STRING ← 1
                        ELSE
                          IN_STRING ← 0
                        ENDIF
                      ELSE
                        IF IN_STRING = 0 THEN
                          IF CHARACTER = "(" THEN
                            DEPTH ← DEPTH + 1
                          ENDIF
                          IF CHARACTER = ")" THEN
                            DEPTH ← DEPTH - 1
                          ENDIF
                          IF DEPTH = 0 THEN
                            IF INDEX < LENGTH(EXPR) THEN
                              SPLIT_OUTER ← 0
                            ENDIF
                          ENDIF
                        ENDIF
                      ENDIF
                      INDEX ← INDEX + 1
                    ENDWHILE
                    IF SPLIT_OUTER = 1 THEN
                      NAME_LENGTH ← LENGTH(EXPR)
                      NAME_LENGTH ← NAME_LENGTH - 2
                      EXPR ← MID(EXPR, 2, NAME_LENGTH)
                    ENDIF
                  ENDIF
                ENDIF
              ENDWHILE
          OP_POSITION ← 0
          OP_LENGTH ← 0
          OPERATOR ← ""
          BEST_PRECEDENCE ← 99
          IN_STRING ← 0
          DEPTH ← 0
          INDEX ← 1
          WHILE INDEX <= LENGTH(EXPR)
            CHARACTER ← MID(EXPR, INDEX, 1)
            IF CHARACTER = CHR(34) THEN
              IF IN_STRING = 0 THEN
                IN_STRING ← 1
              ELSE
                IN_STRING ← 0
              ENDIF
            ELSE
              IF IN_STRING = 0 THEN
                IF CHARACTER = "(" THEN
                  DEPTH ← DEPTH + 1
                ENDIF
                IF CHARACTER = "[" THEN
                  DEPTH ← DEPTH + 1
                ENDIF
                IF CHARACTER = ")" THEN
                  DEPTH ← DEPTH - 1
                ENDIF
                IF CHARACTER = "]" THEN
                  DEPTH ← DEPTH - 1
                ENDIF
                IF DEPTH = 0 THEN
                  CANDIDATE ← ""
                  CANDIDATE_LENGTH ← 0
                  IF MID(EXPR, INDEX, 5) = " DIV " THEN
                    CANDIDATE ← "DIV"
                    CANDIDATE_LENGTH ← 5
                  ENDIF
                  IF MID(EXPR, INDEX, 5) = " MOD " THEN
                    CANDIDATE ← "MOD"
                    CANDIDATE_LENGTH ← 5
                  ENDIF
                  IF MID(EXPR, INDEX, 5) = " AND " THEN
                    CANDIDATE ← "AND"
                    CANDIDATE_LENGTH ← 5
                  ENDIF
                  IF CANDIDATE = "" THEN
                    IF MID(EXPR, INDEX, 4) = " OR " THEN
                      CANDIDATE ← "OR"
                      CANDIDATE_LENGTH ← 4
                    ENDIF
                    IF MID(EXPR, INDEX, 4) = " IN " THEN
                      CANDIDATE ← "IN"
                      CANDIDATE_LENGTH ← 4
                    ENDIF
                    IF MID(EXPR, INDEX, 4) = " <= " THEN
                      CANDIDATE ← "<="
                      CANDIDATE_LENGTH ← 4
                    ENDIF
                    IF MID(EXPR, INDEX, 4) = " >= " THEN
                      CANDIDATE ← ">="
                      CANDIDATE_LENGTH ← 4
                    ENDIF
                    IF MID(EXPR, INDEX, 4) = " <> " THEN
                      CANDIDATE ← "<>"
                      CANDIDATE_LENGTH ← 4
                    ENDIF
                  ENDIF
                  IF CANDIDATE = "" THEN
                    IF MID(EXPR, INDEX, 3) = " = " THEN
                      CANDIDATE ← "="
                    ENDIF
                    IF MID(EXPR, INDEX, 3) = " < " THEN
                      CANDIDATE ← "<"
                    ENDIF
                    IF MID(EXPR, INDEX, 3) = " > " THEN
                      CANDIDATE ← ">"
                    ENDIF
                    IF MID(EXPR, INDEX, 3) = " + " THEN
                      CANDIDATE ← "+"
                    ENDIF
                    IF MID(EXPR, INDEX, 3) = " - " THEN
                      CANDIDATE ← "-"
                    ENDIF
                    IF MID(EXPR, INDEX, 3) = " & " THEN
                      CANDIDATE ← "&"
                    ENDIF
                    IF MID(EXPR, INDEX, 3) = " * " THEN
                      CANDIDATE ← "*"
                    ENDIF
                    IF MID(EXPR, INDEX, 3) = " / " THEN
                      CANDIDATE ← "/"
                    ENDIF
                    IF CANDIDATE <> "" THEN
                      CANDIDATE_LENGTH ← 3
                    ENDIF
                  ENDIF
                  IF CANDIDATE = "" THEN
                    IF MID(EXPR, INDEX, 2) = "<=" OR MID(EXPR, INDEX, 2) = ">=" OR MID(EXPR, INDEX, 2) = "<>" THEN
                      CANDIDATE ← MID(EXPR, INDEX, 2)
                      CANDIDATE_LENGTH ← 2
                    ELSE
                      IF CHARACTER = "=" OR CHARACTER = "<" OR CHARACTER = ">" OR CHARACTER = "+" OR CHARACTER = "-" OR CHARACTER = "&" OR CHARACTER = "*" OR CHARACTER = "/" THEN
                        CANDIDATE ← CHARACTER
                        CANDIDATE_LENGTH ← 1
                        IF CHARACTER = "=" OR CHARACTER = ">" THEN
                          IF INDEX > 1 THEN
                            IF MID(EXPR, INDEX - 1, 1) = "<" OR MID(EXPR, INDEX - 1, 1) = ">" THEN
                              CANDIDATE ← ""
                            ENDIF
                          ENDIF
                        ENDIF
                        IF CHARACTER = "+" OR CHARACTER = "-" THEN
                          IF INDEX = 1 THEN
                            CANDIDATE ← ""
                          ELSE
                            SCAN ← INDEX - 1
                            WHILE SCAN > 0 AND MID(EXPR, SCAN, 1) = " " 
                              SCAN ← SCAN - 1
                            ENDWHILE
                            IF SCAN = 0 THEN
                              CANDIDATE ← ""
                            ELSE
                              IF MID(EXPR, SCAN, 1) = "(" OR MID(EXPR, SCAN, 1) = "+" OR MID(EXPR, SCAN, 1) = "-" OR MID(EXPR, SCAN, 1) = "*" OR MID(EXPR, SCAN, 1) = "/" OR MID(EXPR, SCAN, 1) = "=" OR MID(EXPR, SCAN, 1) = "," THEN
                                CANDIDATE ← ""
                              ENDIF
                            ENDIF
                          ENDIF
                        ENDIF
                        IF CHARACTER = "/" AND LENGTH(EXPR) = 10 THEN
                          IF MID(EXPR, 3, 1) = "/" AND MID(EXPR, 6, 1) = "/" THEN
                            CANDIDATE ← ""
                          ENDIF
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                  IF CANDIDATE <> "" THEN
                    CANDIDATE_PRECEDENCE ← 3
                    CASE OF CANDIDATE
                      "OR" : CANDIDATE_PRECEDENCE ← 1
                      "AND" : CANDIDATE_PRECEDENCE ← 2
                      "&" : CANDIDATE_PRECEDENCE ← 4
                      "+" : CANDIDATE_PRECEDENCE ← 5
                      "-" : CANDIDATE_PRECEDENCE ← 5
                      "*" : CANDIDATE_PRECEDENCE ← 6
                      "/" : CANDIDATE_PRECEDENCE ← 6
                      "DIV" : CANDIDATE_PRECEDENCE ← 6
                      "MOD" : CANDIDATE_PRECEDENCE ← 6
                    ENDCASE
                    IF CANDIDATE_PRECEDENCE <= BEST_PRECEDENCE THEN
                      BEST_PRECEDENCE ← CANDIDATE_PRECEDENCE
                      OPERATOR ← CANDIDATE
                      OP_POSITION ← INDEX
                      OP_LENGTH ← CANDIDATE_LENGTH
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
            INDEX ← INDEX + 1
          ENDWHILE
          PART_COUNT ← 1
          LEFT_PART ← EXPR
          IF OP_POSITION > 0 THEN
            PART_COUNT ← 0
            NAME_LENGTH ← OP_POSITION - 1
            LEFT_PART ← LEFT(EXPR, NAME_LENGTH)
            START_POSITION ← OP_POSITION + OP_LENGTH
            EXPR_LENGTH ← LENGTH(EXPR)
            RIGHT_PART ← MID(EXPR, START_POSITION, EXPR_LENGTH)
            OUTPUT "O:" & OPERATOR
            WORK ← WORK & CHR(30)
            WORK ← WORK & "B"
            WORK ← WORK & CHR(30)
            WORK ← WORK & "E:"
            WORK ← WORK & RIGHT_PART
            WORK ← WORK & CHR(30)
            WORK ← WORK & "E:"
            WORK ← WORK & LEFT_PART
          ELSE
            OPERATOR ← ""
            OP_LENGTH ← 0
            IF LEFT(EXPR, 4) = "NOT " THEN
              OPERATOR ← "NOT"
              OP_LENGTH ← 4
            ENDIF
            IF LEFT(EXPR, 1) = "-" THEN
              OPERATOR ← "-"
              OP_LENGTH ← 1
            ENDIF
            IF LEFT(EXPR, 1) = "+" THEN
              OPERATOR ← "+"
              OP_LENGTH ← 1
            ENDIF
            IF LEFT(EXPR, 1) = "^" THEN
              OPERATOR ← "^"
              OP_LENGTH ← 1
            ENDIF
            IF OPERATOR <> "" THEN
              PART_COUNT ← 0
              OUTPUT "U:" & OPERATOR
              START_POSITION ← OP_LENGTH + 1
              EXPR_LENGTH ← LENGTH(EXPR)
              RIGHT_PART ← MID(EXPR, START_POSITION, EXPR_LENGTH)
              WORK ← WORK & CHR(30)
              WORK ← WORK & "V"
              WORK ← WORK & CHR(30)
              IF OPERATOR = "^" THEN
                WORK ← WORK & "REFE:"
              ELSE
                WORK ← WORK & "E:"
              ENDIF
              WORK ← WORK & RIGHT_PART
            ENDIF
          ENDIF
          PART_INDEX ← 1
          WHILE PART_INDEX <= PART_COUNT
            ATOM ← LEFT_PART
            IF PART_INDEX = 2 THEN
              ATOM ← RIGHT_PART
            ENDIF
            IF ATOM = "TRUE" THEN
              OUTPUT "K:1"
              OUTPUT "BOOL"
            ELSE
              IF ATOM = "FALSE" THEN
                OUTPUT "K:0"
                OUTPUT "BOOL"
              ELSE
                IF ATOM = "NULL" THEN
                  OUTPUT "NULL"
                ELSE
            IF LEFT(ATOM, 1) = CHR(34) OR LEFT(ATOM, 1) = CHR(39) THEN
              NAME_LENGTH ← LENGTH(ATOM)
              NAME_LENGTH ← NAME_LENGTH - 2
              RECORD_LINE ← MID(ATOM, 2, NAME_LENGTH)
              OUTPUT "I:" & RECORD_LINE
              OUTPUT "STR"
            ELSE
              IF IS_NUM(ATOM) THEN
                OUTPUT "I:STR_TO_NUM"
                OUTPUT "ARGS"
                OUTPUT "I:" & ATOM
                OUTPUT "STR"
                OUTPUT "PUSH"
                OUTPUT "CALLBUILTIN"
              ELSE
                IF RIGHT(ATOM, 1) = "^" THEN
                  NAME_LENGTH ← LENGTH(ATOM)
                  NAME_LENGTH ← NAME_LENGTH - 1
                  TARGET_NAME ← LEFT(ATOM, NAME_LENGTH)
                  OUTPUT "I:" & TARGET_NAME
                  OUTPUT "GET"
                  OUTPUT "DEREF"
                ELSE
                IF LENGTH(ATOM) = 10 AND MID(ATOM, 3, 1) = "/" AND MID(ATOM, 6, 1) = "/" THEN
                  DATE_CALL ← "SETDATE("
                  SCAN ← 1
                  WHILE SCAN <= LENGTH(ATOM)
                    CHARACTER ← MID(ATOM, SCAN, 1)
                    IF CHARACTER = "/" THEN
                      DATE_CALL ← DATE_CALL & ","
                    ELSE
                      DATE_CALL ← DATE_CALL & CHARACTER
                    ENDIF
                    SCAN ← SCAN + 1
                  ENDWHILE
                  DATE_CALL ← DATE_CALL & ")"
                  WORK ← WORK & CHR(30)
                  WORK ← WORK & "E:"
                  WORK ← WORK & DATE_CALL
                ELSE
                OPEN_INDEX ← 0
                INDEX_POSITION ← 0
                SCAN ← 1
                WHILE SCAN <= LENGTH(ATOM)
                  IF MID(ATOM, SCAN, 1) = "(" THEN
                    IF OPEN_INDEX = 0 THEN
                      OPEN_INDEX ← SCAN
                    ENDIF
                  ENDIF
                  IF MID(ATOM, SCAN, 1) = "[" THEN
                    IF OPEN_INDEX = 0 THEN
                      OPEN_INDEX ← SCAN
                      INDEX_POSITION ← 1
                    ENDIF
                  ENDIF
                  SCAN ← SCAN + 1
                ENDWHILE
                IF OPEN_INDEX = 0 THEN
                  FIELD_POSITION ← 0
                  SCAN ← 1
                  WHILE SCAN <= LENGTH(ATOM)
                    IF MID(ATOM, SCAN, 1) = "." THEN
                      FIELD_POSITION ← SCAN
                    ENDIF
                    SCAN ← SCAN + 1
                  ENDWHILE
                  IF FIELD_POSITION = 0 THEN
                    OUTPUT "I:" & ATOM
                    OUTPUT "GET"
                  ELSE
                    NAME_LENGTH ← FIELD_POSITION - 1
                    TARGET_NAME ← LEFT(ATOM, NAME_LENGTH)
                    START_POSITION ← FIELD_POSITION + 1
                    LINE_LENGTH ← LENGTH(ATOM)
                    FIELD_NAME ← MID(ATOM, START_POSITION, LINE_LENGTH)
                    OUTPUT "I:" & TARGET_NAME
                    OUTPUT "GET"
                    OUTPUT "I:" & FIELD_NAME
                    OUTPUT "FIELD"
                  ENDIF
                ELSE
                  NAME_LENGTH ← OPEN_INDEX - 1
                  FUNCTION_NAME ← LEFT(ATOM, NAME_LENGTH)
                  CALL_INDEX ← -1
                  METHOD_MODE ← 0
                  IF INDEX_POSITION = 0 THEN
                    IF LEFT(FUNCTION_NAME, 4) = "NEW " THEN
                      METHOD_MODE ← 1
                      LINE_LENGTH ← LENGTH(FUNCTION_NAME)
                      METHOD_NAME ← MID(FUNCTION_NAME, 5, LINE_LENGTH)
                    ELSE
                      FIELD_POSITION ← 0
                      SCAN ← 1
                      WHILE SCAN <= LENGTH(FUNCTION_NAME)
                        IF MID(FUNCTION_NAME, SCAN, 1) = "." THEN
                          FIELD_POSITION ← SCAN
                        ENDIF
                        SCAN ← SCAN + 1
                      ENDWHILE
                      IF FIELD_POSITION > 0 THEN
                        METHOD_MODE ← 2
                        NAME_LENGTH ← FIELD_POSITION - 1
                        TARGET_NAME ← LEFT(FUNCTION_NAME, NAME_LENGTH)
                        START_POSITION ← FIELD_POSITION + 1
                        LINE_LENGTH ← LENGTH(FUNCTION_NAME)
                        METHOD_NAME ← MID(FUNCTION_NAME, START_POSITION, LINE_LENGTH)
                      ENDIF
                    ENDIF
                  ENDIF
                  IF INDEX_POSITION = 0 AND METHOD_MODE = 0 THEN
                    MAP_KEY ← "|" & FUNCTION_NAME
                    MAP_KEY ← MAP_KEY & "="
                    SCAN ← 1
                    WHILE SCAN <= LENGTH(ROUTINE_MAP)
                      IF MID(ROUTINE_MAP, SCAN, LENGTH(MAP_KEY)) = MAP_KEY THEN
                        START_POSITION ← SCAN + LENGTH(MAP_KEY)
                        CALL_INDEX ← ASC(MID(ROUTINE_MAP, START_POSITION, 1))
                        CALL_INDEX ← CALL_INDEX - 1
                      ENDIF
                      SCAN ← SCAN + 1
                    ENDWHILE
                  ENDIF
                  CALL_FLAGS ← ""
                  IF CALL_INDEX >= 0 THEN
                    SCAN ← 1
                    WHILE SCAN <= LENGTH(ROUTINE_REF_MAP)
                      IF MID(ROUTINE_REF_MAP, SCAN, LENGTH(MAP_KEY)) = MAP_KEY THEN
                        START_POSITION ← SCAN + LENGTH(MAP_KEY)
                        CHARACTER ← MID(ROUTINE_REF_MAP, START_POSITION, 1)
                        WHILE CHARACTER <> CHR(30)
                          CALL_FLAGS ← CALL_FLAGS & CHARACTER
                          START_POSITION ← START_POSITION + 1
                          CHARACTER ← MID(ROUTINE_REF_MAP, START_POSITION, 1)
                        ENDWHILE
                      ENDIF
                      SCAN ← SCAN + 1
                    ENDWHILE
                  ENDIF
                  IF METHOD_MODE = 1 THEN
                    OUTPUT "I:" & METHOD_NAME
                  ELSE
                    IF METHOD_MODE = 2 THEN
                      OUTPUT "I:" & TARGET_NAME
                      OUTPUT "GET"
                      OUTPUT "I:" & METHOD_NAME
                    ELSE
                      IF CALL_INDEX = -1 THEN
                        OUTPUT "I:" & FUNCTION_NAME
                      ENDIF
                    ENDIF
                  ENDIF
                  IF INDEX_POSITION = 1 THEN
                    OUTPUT "GET"
                  ENDIF
                  OUTPUT "ARGS"
                  START_POSITION ← OPEN_INDEX + 1
                  ARG_LENGTH ← LENGTH(ATOM)
                  ARG_LENGTH ← ARG_LENGTH - START_POSITION
                  INDEX_FIELD ← 0
                  IF INDEX_POSITION = 1 THEN
                    TYPE_CLOSE ← 0
                    SCAN ← OPEN_INDEX
                    WHILE SCAN <= LENGTH(ATOM)
                      IF MID(ATOM, SCAN, 1) = "]" THEN
                        TYPE_CLOSE ← SCAN
                      ENDIF
                      SCAN ← SCAN + 1
                    ENDWHILE
                    ARG_LENGTH ← TYPE_CLOSE - START_POSITION
                    IF TYPE_CLOSE < LENGTH(ATOM) THEN
                      INDEX_FIELD ← 1
                      START_POSITION ← TYPE_CLOSE + 2
                      LINE_LENGTH ← LENGTH(ATOM)
                      FIELD_NAME ← MID(ATOM, START_POSITION, LINE_LENGTH)
                      START_POSITION ← OPEN_INDEX + 1
                    ENDIF
                  ENDIF
                  ARGUMENTS ← MID(ATOM, START_POSITION, ARG_LENGTH)
                  WORK ← WORK & CHR(30)
                  IF INDEX_POSITION = 1 THEN
                    IF INDEX_FIELD = 1 THEN
                      WORK ← WORK & "JF:"
                      WORK ← WORK & FIELD_NAME
                    ELSE
                      WORK ← WORK & "J"
                    ENDIF
                  ELSE
                    IF METHOD_MODE = 1 THEN
                      WORK ← WORK & "N"
                    ELSE
                      IF METHOD_MODE = 2 THEN
                        WORK ← WORK & "M"
                      ELSE
                        IF CALL_INDEX = -1 THEN
                          WORK ← WORK & "C"
                        ELSE
                          WORK ← WORK & "R:"
                          WORK ← WORK & NUM_TO_STR(CALL_INDEX)
                        ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                  ARG_POSITION ← LENGTH(ARGUMENTS)
                  ARG_NUMBER ← LENGTH(CALL_FLAGS)
                  ARGUMENT ← ""
                  ARG_DEPTH ← 0
                  ARG_IN_STRING ← 0
                  WHILE ARG_POSITION >= 1
                    CHARACTER ← MID(ARGUMENTS, ARG_POSITION, 1)
                    IF CHARACTER = CHR(34) THEN
                      IF ARG_IN_STRING = 0 THEN
                        ARG_IN_STRING ← 1
                      ELSE
                        ARG_IN_STRING ← 0
                      ENDIF
                    ENDIF
                    IF ARG_IN_STRING = 0 THEN
                      IF CHARACTER = ")" THEN
                        ARG_DEPTH ← ARG_DEPTH + 1
                      ENDIF
                      IF CHARACTER = "]" THEN
                        ARG_DEPTH ← ARG_DEPTH + 1
                      ENDIF
                      IF CHARACTER = "(" THEN
                        ARG_DEPTH ← ARG_DEPTH - 1
                      ENDIF
                      IF CHARACTER = "[" THEN
                        ARG_DEPTH ← ARG_DEPTH - 1
                      ENDIF
                    ENDIF
                    IF CHARACTER = "," THEN
                      IF ARG_DEPTH = 0 AND ARG_IN_STRING = 0 THEN
                        WHILE LEFT(ARGUMENT, 1) = " "
                          ARGUMENT ← MID(ARGUMENT, 2, LENGTH(ARGUMENT))
                        ENDWHILE
                        WHILE RIGHT(ARGUMENT, 1) = " "
                          ARG_LENGTH ← LENGTH(ARGUMENT)
                          ARG_LENGTH ← ARG_LENGTH - 1
                          ARGUMENT ← LEFT(ARGUMENT, ARG_LENGTH)
                        ENDWHILE
                        WORK ← WORK & CHR(30)
                        WORK ← WORK & "P"
                        WORK ← WORK & CHR(30)
                        IS_BYREF ← 0
                        IF MID(CALL_FLAGS, ARG_NUMBER, 1) = "1" THEN
                          IS_BYREF ← 1
                        ENDIF
                        IF METHOD_MODE > 0 THEN
                          IF IS_NUM(ARGUMENT) = FALSE AND LEFT(ARGUMENT, 1) <> CHR(34) AND LEFT(ARGUMENT, 1) <> CHR(39) THEN
                            IF ARGUMENT <> "TRUE" AND ARGUMENT <> "FALSE" AND ARGUMENT <> "NULL" THEN
                              IS_BYREF ← 1
                            ENDIF
                          ENDIF
                        ENDIF
                        IF IS_BYREF = 1 THEN
                          WORK ← WORK & "REFE:"
                        ELSE
                          WORK ← WORK & "E:"
                        ENDIF
                        WORK ← WORK & ARGUMENT
                        ARGUMENT ← ""
                        ARG_NUMBER ← ARG_NUMBER - 1
                      ELSE
                        ARGUMENT ← CHARACTER & ARGUMENT
                      ENDIF
                    ELSE
                      ARGUMENT ← CHARACTER & ARGUMENT
                    ENDIF
                    ARG_POSITION ← ARG_POSITION - 1
                  ENDWHILE
                  WHILE LEFT(ARGUMENT, 1) = " "
                    ARGUMENT ← MID(ARGUMENT, 2, LENGTH(ARGUMENT))
                  ENDWHILE
                  WHILE RIGHT(ARGUMENT, 1) = " "
                    ARG_LENGTH ← LENGTH(ARGUMENT)
                    ARG_LENGTH ← ARG_LENGTH - 1
                    ARGUMENT ← LEFT(ARGUMENT, ARG_LENGTH)
                  ENDWHILE
                  IF ARGUMENT <> "" THEN
                    WORK ← WORK & CHR(30)
                    WORK ← WORK & "P"
                    WORK ← WORK & CHR(30)
                    IS_BYREF ← 0
                    IF MID(CALL_FLAGS, ARG_NUMBER, 1) = "1" THEN
                      IS_BYREF ← 1
                    ENDIF
                    IF METHOD_MODE > 0 THEN
                      IF IS_NUM(ARGUMENT) = FALSE AND LEFT(ARGUMENT, 1) <> CHR(34) AND LEFT(ARGUMENT, 1) <> CHR(39) THEN
                        IF ARGUMENT <> "TRUE" AND ARGUMENT <> "FALSE" AND ARGUMENT <> "NULL" THEN
                          IS_BYREF ← 1
                        ENDIF
                      ENDIF
                    ENDIF
                    IF IS_BYREF = 1 THEN
                      WORK ← WORK & "REFE:"
                    ELSE
                      WORK ← WORK & "E:"
                    ENDIF
                    WORK ← WORK & ARGUMENT
                  ENDIF
                ENDIF
                ENDIF
                ENDIF
              ENDIF
            ENDIF
                ENDIF
              ENDIF
            ENDIF
            PART_INDEX ← PART_INDEX + 1
          ENDWHILE
      ENDCASE
      ENDIF
    ENDWHILE
    CASE OF MODE
      "ASSIGN" : OUTPUT "SET"
      "ASSIGN_FIELD" : OUTPUT "SETFIELD"
      "ASSIGN_DEREF" : OUTPUT "SETDEREF"
      "CONSTANT" : OUTPUT "DECLARE"
      "IF" : OUTPUT "IF"
      "WHILE" : OUTPUT "WHILE_TEST"
      "UNTIL" : OUTPUT "UNTIL_TEST"
      "RETURN" : OUTPUT "RETURN"
      "CALLSTMT" : OUTPUT "DROP"
    ENDCASE
  ENDIF
ENDWHILE

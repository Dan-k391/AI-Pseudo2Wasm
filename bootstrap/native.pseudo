// Self-hosted native lowering from the core compiler's stack IR.
// Scalars, strings, arrays, records, routines, and frames use WASM memory.
// Constructs outside this backend use the self-hosted compatibility module.
DECLARE IR : STRING
DECLARE PREFIX_HEX : STRING
DECLARE PREFIX : STRING
DECLARE WASM : STRING
DECLARE CODE : STRING
DECLARE BODY : STRING
DECLARE SECTION_DATA : STRING
DECLARE PAYLOAD : STRING
DECLARE EXPORTS : STRING
DECLARE GLOBALS : STRING
DECLARE STATIC_DATA : STRING
DECLARE DATA_PAYLOAD : STRING
DECLARE CONCAT_BODY : STRING
DECLARE EQUALS_BODY : STRING
DECLARE LINES : ARRAY[1:40000] OF STRING
DECLARE SKIP_TO : ARRAY[1:40000] OF INTEGER
DECLARE SYMBOL_NAMES : ARRAY[1:1024] OF STRING
DECLARE SYMBOL_TYPES : ARRAY[1:1024] OF STRING
DECLARE SYMBOL_OFFSETS : ARRAY[1:1024] OF INTEGER
DECLARE SYMBOL_SCOPE : ARRAY[1:1024] OF INTEGER
DECLARE SYMBOL_BYREF : ARRAY[1:1024] OF INTEGER
DECLARE SYMBOL_PARAM : ARRAY[1:1024] OF INTEGER
DECLARE PROMOTED_LOCAL : ARRAY[1:1024] OF INTEGER
DECLARE ROUTINE_PROMOTED_COUNT : ARRAY[1:256] OF INTEGER
DECLARE ROUTINE_NEEDS_FRAME : ARRAY[1:256] OF BOOLEAN
DECLARE TYPE_NAMES : ARRAY[1:256] OF STRING
DECLARE TYPE_SPECS : ARRAY[1:256] OF STRING
DECLARE CONSTANT_NAMES : ARRAY[1:256] OF STRING
DECLARE CONSTANT_VALUES : ARRAY[1:256] OF INTEGER
DECLARE ROUTINE_NAMES : ARRAY[1:256] OF STRING
DECLARE ROUTINE_KINDS : ARRAY[1:256] OF STRING
DECLARE ROUTINE_RETURNS : ARRAY[1:256] OF STRING
DECLARE ROUTINE_SIZES : ARRAY[1:256] OF INTEGER
DECLARE ROUTINE_BODIES : ARRAY[1:256] OF STRING
DECLARE ROUTINE_PARAM_COUNTS : ARRAY[1:256] OF INTEGER
DECLARE PARAM_NAMES : ARRAY[1:4096] OF STRING
DECLARE PARAM_TYPES : ARRAY[1:4096] OF STRING
DECLARE PARAM_BYREF : ARRAY[1:4096] OF INTEGER
DECLARE STRING_NAMES : ARRAY[1:2048] OF STRING
DECLARE STRING_OFFSETS : ARRAY[1:2048] OF INTEGER
DECLARE STACK_KIND : ARRAY[0:2048] OF STRING
DECLARE STACK_TEXT : ARRAY[0:2048] OF STRING
DECLARE STACK_CODE : ARRAY[0:2048] OF STRING
DECLARE STACK_TYPE : ARRAY[0:2048] OF STRING
DECLARE STACK_MARK : ARRAY[0:2048] OF INTEGER
DECLARE ARG_CODE : ARRAY[0:2048] OF STRING
DECLARE ARG_TYPE : ARRAY[0:2048] OF STRING
DECLARE ARG_TEXT : ARRAY[0:2048] OF STRING
DECLARE ARG_KIND : ARRAY[0:2048] OF STRING
DECLARE LABEL_NAMES : ARRAY[1:256] OF STRING
DECLARE LOOP_FOR : ARRAY[1:256] OF BOOLEAN
DECLARE FILL_ACTIVE : ARRAY[1:256] OF BOOLEAN
DECLARE FILL_DEPTH : INTEGER
DECLARE FILL_MATCHED : BOOLEAN
DECLARE LOOP_DEPTH : INTEGER
DECLARE RANGE_SYMBOL : ARRAY[1:256] OF INTEGER
DECLARE RANGE_LOW : ARRAY[1:256] OF INTEGER
DECLARE RANGE_HIGH : ARRAY[1:256] OF INTEGER
DECLARE RANGE_LOCAL : ARRAY[1:256] OF INTEGER
DECLARE RANGE_INDEX_LOCAL : ARRAY[1:256] OF INTEGER
DECLARE RANGE_STEP : ARRAY[1:256] OF INTEGER
DECLARE RANGE_MAX_DEPTH : ARRAY[1:257] OF INTEGER
DECLARE RANGE_FOUND_LOW : INTEGER
DECLARE RANGE_FOUND_HIGH : INTEGER
DECLARE RANGE_START_VALUE : INTEGER
DECLARE RANGE_END_NAME : STRING
DECLARE RANGE_DIRECTION : INTEGER
DECLARE LARGE_LITERAL : BOOLEAN
DECLARE SLOW_CONCAT : BOOLEAN
DECLARE BOOTSTRAP_MODE : BOOLEAN
DECLARE RELEASE_MODE : BOOLEAN
DECLARE OPTIMIZE_MODE : BOOLEAN
DECLARE CAN_PROMOTE : BOOLEAN
DECLARE PROMOTED_COUNT : INTEGER
DECLARE LINE : STRING
DECLARE NAME : STRING
DECLARE VALUE_CODE : STRING
DECLARE LEFT_CODE : STRING
DECLARE RIGHT_CODE : STRING
DECLARE LEFT_TYPE : STRING
DECLARE RIGHT_TYPE : STRING
DECLARE OPERATOR : STRING
DECLARE CHARACTER : STRING
DECLARE POSITION : INTEGER
DECLARE START_AT : INTEGER
DECLARE LINE_COUNT : INTEGER
DECLARE SYMBOL_COUNT : INTEGER
DECLARE ROUTINE_COUNT : INTEGER
DECLARE CURRENT_ROUTINE : INTEGER
DECLARE TYPE_COUNT : INTEGER
DECLARE CONSTANT_COUNT : INTEGER
DECLARE GLOBAL_SIZE : INTEGER
DECLARE FRAME_BASE : INTEGER
DECLARE BASE_LOCAL : INTEGER
DECLARE RESULT_LOCAL : INTEGER
DECLARE TEMP_A : INTEGER
DECLARE TEMP_B : INTEGER
DECLARE TEMP_INDEX : INTEGER
DECLARE MAIN_CODE : STRING
DECLARE STRING_COUNT : INTEGER
DECLARE STACK_SIZE : INTEGER
DECLARE ARG_COUNT : INTEGER
DECLARE LABEL_COUNT : INTEGER
DECLARE INDEX : INTEGER
DECLARE J : INTEGER
DECLARE K : INTEGER
DECLARE ADDRESS : INTEGER
DECLARE NUMBER_VALUE : INTEGER
DECLARE UNSUPPORTED : INTEGER
DECLARE UNSUPPORTED_REASON : STRING
DECLARE FAIL_INDEX : INTEGER
DECLARE SOURCE_LINE : INTEGER
DECLARE RESULT_TYPE : STRING
DECLARE OP_CODE : INTEGER
DECLARE LENGTH_VALUE : INTEGER
DECLARE SCAN : INTEGER
DECLARE SPEC_SIZE : INTEGER
DECLARE CONSTANT_INDEX : INTEGER
DECLARE PARAM_SLOT : INTEGER
DECLARE PARAM_COUNT : INTEGER
DECLARE PARAM_TEXT : STRING
DECLARE PARAM_FIELD : STRING
DECLARE PART : STRING
DECLARE P : INTEGER
DECLARE Q : INTEGER
DECLARE COMMA : INTEGER
DECLARE SECOND_COMMA : INTEGER
DECLARE ROUTINE_NUMBER : INTEGER
DECLARE ROUTINE_TYPE_SECTION : STRING
DECLARE ROUTINE_FUNCTION_SECTION : STRING
DECLARE ROUTINE_EXPORT_SECTION : STRING
DECLARE GLOBAL_BASE : INTEGER
DECLARE HEAP_BASE : INTEGER
DECLARE MEMORY_PAGES : INTEGER
DECLARE STRING_BYTES : STRING
DECLARE IMPORT_BODY : STRING

FUNCTION ULEB(N : INTEGER) RETURNS STRING
  DECLARE ENCODED : STRING
  DECLARE BYTE_VALUE : INTEGER
  REPEAT
    BYTE_VALUE ← N MOD 128
    N ← N DIV 128
    IF N > 0 THEN
      BYTE_VALUE ← BYTE_VALUE + 128
    ENDIF
    ENCODED ← ENCODED & CHR(BYTE_VALUE)
  UNTIL N = 0
  RETURN ENCODED
ENDFUNCTION

FUNCTION SLEB(N : INTEGER) RETURNS STRING
  DECLARE ENCODED : STRING
  DECLARE BYTE_VALUE : INTEGER
  REPEAT
    BYTE_VALUE ← N MOD 128
    N ← N DIV 128
    IF N > 0 OR BYTE_VALUE >= 64 THEN
      BYTE_VALUE ← BYTE_VALUE + 128
    ENDIF
    ENCODED ← ENCODED & CHR(BYTE_VALUE)
  UNTIL N = 0 AND BYTE_VALUE < 128
  RETURN ENCODED
ENDFUNCTION

FUNCTION NUMBER_CODE(N : INTEGER) RETURNS STRING
  IF N < 0 THEN
    RETURN CHR(65) & SLEB(0 - N) & CHR(183) & CHR(154)
  ENDIF
  RETURN CHR(65) & SLEB(N) & CHR(183)
ENDFUNCTION

FUNCTION I32_CONST(N : INTEGER) RETURNS STRING
  IF N = -1 THEN
    RETURN CHR(65) & CHR(127)
  ENDIF
  IF N < 0 THEN
    RETURN CHR(65) & CHR(0) & CHR(65) & SLEB(0 - N) & CHR(107)
  ENDIF
  RETURN CHR(65) & SLEB(N)
ENDFUNCTION

FUNCTION FIND_SYMBOL(SEARCH_NAME : STRING) RETURNS INTEGER
  DECLARE ITEM : INTEGER
  IF CURRENT_ROUTINE > 0 THEN
    FOR ITEM ← 1 TO SYMBOL_COUNT
      IF SYMBOL_SCOPE[ITEM] = CURRENT_ROUTINE AND SYMBOL_NAMES[ITEM] = SEARCH_NAME THEN
        RETURN ITEM
      ENDIF
    NEXT ITEM
  ENDIF
  FOR ITEM ← 1 TO SYMBOL_COUNT
    IF SYMBOL_SCOPE[ITEM] = 0 AND SYMBOL_NAMES[ITEM] = SEARCH_NAME THEN
      RETURN ITEM
    ENDIF
  NEXT ITEM
  RETURN 0
ENDFUNCTION

FUNCTION SYMBOL_EXISTS_IN_SCOPE(SEARCH_NAME : STRING, SEARCH_SCOPE : INTEGER) RETURNS BOOLEAN
  DECLARE ITEM : INTEGER
  FOR ITEM ← 1 TO SYMBOL_COUNT
    IF SYMBOL_SCOPE[ITEM] = SEARCH_SCOPE AND SYMBOL_NAMES[ITEM] = SEARCH_NAME THEN
      RETURN TRUE
    ENDIF
  NEXT ITEM
  RETURN FALSE
ENDFUNCTION

FUNCTION ADDRESS_CODE(SYMBOL_ID : INTEGER) RETURNS STRING
  IF SYMBOL_SCOPE[SYMBOL_ID] = 0 THEN
    RETURN CHR(65) & SLEB(GLOBAL_BASE + SYMBOL_OFFSETS[SYMBOL_ID])
  ENDIF
  IF SYMBOL_BYREF[SYMBOL_ID] = 1 THEN
    RETURN CHR(32) & ULEB(SYMBOL_PARAM[SYMBOL_ID])
  ENDIF
  RETURN CHR(32) & ULEB(BASE_LOCAL) & CHR(65) & SLEB(SYMBOL_OFFSETS[SYMBOL_ID]) & CHR(106)
ENDFUNCTION

FUNCTION FIND_ROUTINE(SEARCH_NAME : STRING) RETURNS INTEGER
  DECLARE ITEM : INTEGER
  FOR ITEM ← 1 TO ROUTINE_COUNT
    IF ROUTINE_NAMES[ITEM] = SEARCH_NAME THEN
      RETURN ITEM
    ENDIF
  NEXT ITEM
  RETURN 0
ENDFUNCTION

FUNCTION ROUTINE_PROLOGUE(ROUTINE_ID : INTEGER) RETURNS STRING
  DECLARE RESULT : STRING
  DECLARE ITEM : INTEGER
  DECLARE FRAME_SIZE : INTEGER
  IF NOT ROUTINE_NEEDS_FRAME[ROUTINE_ID] THEN
    RETURN ""
  ENDIF
  FRAME_SIZE ← ROUTINE_SIZES[ROUTINE_ID]
  RESULT ← CHR(35) & CHR(0) & CHR(33) & ULEB(BASE_LOCAL)
  RESULT ← RESULT & CHR(35) & CHR(0) & CHR(65) & SLEB(FRAME_SIZE) & CHR(106) & CHR(36) & CHR(0)
  RESULT ← RESULT & CHR(35) & CHR(0) & CHR(65) & SLEB(HEAP_BASE) & CHR(75) & CHR(4) & CHR(64)
  RESULT ← RESULT & CHR(65) & CHR(7) & CHR(65) & CHR(1) & CHR(16) & CHR(5) & CHR(0) & CHR(11)
  IF FRAME_SIZE > 0 THEN
    RESULT ← RESULT & CHR(32) & ULEB(BASE_LOCAL) & CHR(65) & CHR(0) & CHR(65) & SLEB(FRAME_SIZE)
    RESULT ← RESULT & CHR(252) & CHR(11) & CHR(0)
  ENDIF
  FOR ITEM ← 1 TO SYMBOL_COUNT
    IF SYMBOL_SCOPE[ITEM] = ROUTINE_ID AND SYMBOL_PARAM[ITEM] >= 0 AND SYMBOL_BYREF[ITEM] = 0 AND PROMOTED_LOCAL[ITEM] = 0 THEN
      IF SYMBOL_NAMES[ITEM] = PARAM_NAMES[(ROUTINE_ID - 1) * 16 + SYMBOL_PARAM[ITEM] + 1] THEN
        RESULT ← RESULT & CHR(32) & ULEB(BASE_LOCAL) & CHR(65) & SLEB(SYMBOL_OFFSETS[ITEM]) & CHR(106)
        RESULT ← RESULT & CHR(32) & ULEB(SYMBOL_PARAM[ITEM]) & CHR(57) & CHR(3) & CHR(0)
      ENDIF
    ENDIF
  NEXT ITEM
  RETURN RESULT
ENDFUNCTION

FUNCTION ROUTINE_EPILOGUE(VALUE_EXPR : STRING) RETURNS STRING
  IF NOT ROUTINE_NEEDS_FRAME[CURRENT_ROUTINE] THEN
    RETURN VALUE_EXPR
  ENDIF
  RETURN VALUE_EXPR & CHR(33) & ULEB(RESULT_LOCAL) & CHR(32) & ULEB(BASE_LOCAL) & CHR(36) & CHR(0) & CHR(32) & ULEB(RESULT_LOCAL)
ENDFUNCTION

FUNCTION FIND_TYPE(SEARCH_NAME : STRING) RETURNS INTEGER
  DECLARE ITEM : INTEGER
  FOR ITEM ← 1 TO TYPE_COUNT
    IF TYPE_NAMES[ITEM] = SEARCH_NAME THEN
      RETURN ITEM
    ENDIF
  NEXT ITEM
  RETURN 0
ENDFUNCTION

FUNCTION RESOLVED_SPEC(TYPE_TEXT : STRING) RETURNS STRING
  DECLARE ITEM : INTEGER
  DECLARE LEVEL : INTEGER
  IF LEFT(TYPE_TEXT, 1) = CHR(31) THEN
    TYPE_TEXT ← MID(TYPE_TEXT, 2, LENGTH(TYPE_TEXT))
  ENDIF
  LEVEL ← 0
  ITEM ← FIND_TYPE(TYPE_TEXT)
  WHILE ITEM > 0 AND LEVEL < 16
    TYPE_TEXT ← TYPE_SPECS[ITEM]
    IF LEFT(TYPE_TEXT, 1) = CHR(31) THEN
      TYPE_TEXT ← MID(TYPE_TEXT, 2, LENGTH(TYPE_TEXT))
    ENDIF
    ITEM ← FIND_TYPE(TYPE_TEXT)
    LEVEL ← LEVEL + 1
  ENDWHILE
  RETURN TYPE_TEXT
ENDFUNCTION

FUNCTION INTEGER_LITERAL(TEXT_VALUE : STRING) RETURNS BOOLEAN
  DECLARE P : INTEGER
  DECLARE C : INTEGER
  P ← 1
  IF LENGTH(TEXT_VALUE) = 0 THEN
    RETURN FALSE
  ENDIF
  IF LEFT(TEXT_VALUE, 1) = "-" OR LEFT(TEXT_VALUE, 1) = "+" THEN
    P ← 2
  ENDIF
  IF P > LENGTH(TEXT_VALUE) THEN
    RETURN FALSE
  ENDIF
  WHILE P <= LENGTH(TEXT_VALUE)
    C ← ASC(MID(TEXT_VALUE, P, 1))
    IF C < 48 OR C > 57 THEN
      RETURN FALSE
    ENDIF
    P ← P + 1
  ENDWHILE
  RETURN TRUE
ENDFUNCTION

FUNCTION BOUND_VALUE(TEXT_VALUE : STRING) RETURNS INTEGER
  DECLARE ITEM : INTEGER
  DECLARE P : INTEGER
  DECLARE LEFT_VALUE : INTEGER
  DECLARE RIGHT_VALUE : INTEGER
  DECLARE C : STRING
  WHILE LEFT(TEXT_VALUE, 1) = " "
    TEXT_VALUE ← MID(TEXT_VALUE, 2, LENGTH(TEXT_VALUE))
  ENDWHILE
  WHILE RIGHT(TEXT_VALUE, 1) = " "
    TEXT_VALUE ← LEFT(TEXT_VALUE, LENGTH(TEXT_VALUE) - 1)
  ENDWHILE
  P ← LENGTH(TEXT_VALUE)
  WHILE P > 1
    C ← MID(TEXT_VALUE, P, 1)
    IF C = "+" OR C = "-" THEN
      LEFT_VALUE ← BOUND_VALUE(LEFT(TEXT_VALUE, P - 1))
      RIGHT_VALUE ← BOUND_VALUE(MID(TEXT_VALUE, P + 1, LENGTH(TEXT_VALUE)))
      IF LEFT_VALUE = -2147483647 OR RIGHT_VALUE = -2147483647 THEN
        RETURN -2147483647
      ENDIF
      IF C = "+" THEN
        RETURN LEFT_VALUE + RIGHT_VALUE
      ELSE
        RETURN LEFT_VALUE - RIGHT_VALUE
      ENDIF
    ENDIF
    P ← P - 1
  ENDWHILE
  P ← LENGTH(TEXT_VALUE)
  WHILE P > 1
    C ← MID(TEXT_VALUE, P, 1)
    IF C = "*" OR C = "/" THEN
      LEFT_VALUE ← BOUND_VALUE(LEFT(TEXT_VALUE, P - 1))
      RIGHT_VALUE ← BOUND_VALUE(MID(TEXT_VALUE, P + 1, LENGTH(TEXT_VALUE)))
      IF LEFT_VALUE = -2147483647 OR RIGHT_VALUE = -2147483647 OR RIGHT_VALUE = 0 THEN
        RETURN -2147483647
      ENDIF
      IF C = "*" THEN
        RETURN LEFT_VALUE * RIGHT_VALUE
      ELSE
        RETURN LEFT_VALUE DIV RIGHT_VALUE
      ENDIF
    ENDIF
    P ← P - 1
  ENDWHILE
  IF INTEGER_LITERAL(TEXT_VALUE) THEN
    RETURN STR_TO_NUM(TEXT_VALUE)
  ENDIF
  FOR ITEM ← 1 TO CONSTANT_COUNT
    IF CONSTANT_NAMES[ITEM] = TEXT_VALUE THEN
      RETURN CONSTANT_VALUES[ITEM]
    ENDIF
  NEXT ITEM
  RETURN -2147483647
ENDFUNCTION

FUNCTION TYPE_SIZE(TYPE_TEXT : STRING, LEVEL : INTEGER) RETURNS INTEGER
  DECLARE SPEC : STRING
  DECLARE REST : STRING
  DECLARE FIELD : STRING
  DECLARE PART : STRING
  DECLARE ELEMENT : STRING
  DECLARE P : INTEGER
  DECLARE Q : INTEGER
  DECLARE LO : INTEGER
  DECLARE HI : INTEGER
  DECLARE TOTAL : INTEGER
  DECLARE SUB_SIZE : INTEGER
  IF LEVEL > 16 THEN
    RETURN 0
  ENDIF
  SPEC ← RESOLVED_SPEC(TYPE_TEXT)
  IF SPEC = "INTEGER" OR SPEC = "REAL" OR SPEC = "BOOLEAN" OR SPEC = "STRING" THEN
    RETURN 8
  ENDIF
  IF LEFT(SPEC, 6) = "ARRAY|" THEN
    REST ← MID(SPEC, 7, LENGTH(SPEC))
    P ← 1
    WHILE P <= LENGTH(REST) AND MID(REST, P, 1) <> "|"
      P ← P + 1
    ENDWHILE
    IF P > LENGTH(REST) THEN
      RETURN 0
    ENDIF
    ELEMENT ← MID(REST, P + 1, LENGTH(REST))
    REST ← LEFT(REST, P - 1) & ","
    TOTAL ← 1
    P ← 1
    WHILE P <= LENGTH(REST)
      Q ← P
      WHILE MID(REST, Q, 1) <> ","
        Q ← Q + 1
      ENDWHILE
      PART ← MID(REST, P, Q - P)
      LO ← 1
      WHILE LO <= LENGTH(PART) AND MID(PART, LO, 1) <> ":"
        LO ← LO + 1
      ENDWHILE
      IF LO > LENGTH(PART) THEN
        RETURN 0
      ENDIF
      HI ← BOUND_VALUE(MID(PART, LO + 1, LENGTH(PART)))
      LO ← BOUND_VALUE(LEFT(PART, LO - 1))
      IF LO = -2147483647 OR HI = -2147483647 OR HI < LO OR HI - LO > 100000 THEN
        RETURN 0
      ENDIF
      TOTAL ← TOTAL * (HI - LO + 1)
      IF TOTAL > 1000000 THEN
        RETURN 0
      ENDIF
      P ← Q + 1
    ENDWHILE
    SUB_SIZE ← TYPE_SIZE(ELEMENT, LEVEL + 1)
    RETURN TOTAL * SUB_SIZE
  ENDIF
  IF LEFT(SPEC, 7) = "RECORD:" THEN
    REST ← MID(SPEC, 8, LENGTH(SPEC))
    TOTAL ← 0
    P ← 1
    WHILE P <= LENGTH(REST)
      Q ← P
      WHILE Q <= LENGTH(REST) AND MID(REST, Q, 1) <> ";"
        Q ← Q + 1
      ENDWHILE
      FIELD ← MID(REST, P, Q - P)
      IF FIELD <> "" THEN
        LO ← 1
        WHILE LO <= LENGTH(FIELD) AND MID(FIELD, LO, 1) <> ","
          LO ← LO + 1
        ENDWHILE
        IF LO > LENGTH(FIELD) THEN
          RETURN 0
        ENDIF
        SUB_SIZE ← TYPE_SIZE(MID(FIELD, LO + 1, LENGTH(FIELD)), LEVEL + 1)
        IF SUB_SIZE = 0 THEN
          RETURN 0
        ENDIF
        TOTAL ← TOTAL + SUB_SIZE
      ENDIF
      P ← Q + 1
    ENDWHILE
    RETURN TOTAL
  ENDIF
  RETURN 0
ENDFUNCTION

FUNCTION ELEMENT_TYPE(TYPE_TEXT : STRING) RETURNS STRING
  DECLARE SPEC : STRING
  DECLARE P : INTEGER
  SPEC ← RESOLVED_SPEC(TYPE_TEXT)
  IF LEFT(SPEC, 6) <> "ARRAY|" THEN
    RETURN ""
  ENDIF
  P ← 7
  WHILE P <= LENGTH(SPEC) AND MID(SPEC, P, 1) <> "|"
    P ← P + 1
  ENDWHILE
  RETURN MID(SPEC, P + 1, LENGTH(SPEC))
ENDFUNCTION

FUNCTION FIELD_OFFSET(TYPE_TEXT : STRING, SEARCH_FIELD : STRING) RETURNS INTEGER
  DECLARE SPEC : STRING
  DECLARE REST : STRING
  DECLARE PART : STRING
  DECLARE P : INTEGER
  DECLARE Q : INTEGER
  DECLARE COMMA : INTEGER
  DECLARE OFFSET_VALUE : INTEGER
  SPEC ← RESOLVED_SPEC(TYPE_TEXT)
  IF LEFT(SPEC, 7) <> "RECORD:" THEN
    RETURN -1
  ENDIF
  REST ← MID(SPEC, 8, LENGTH(SPEC))
  P ← 1
  WHILE P <= LENGTH(REST)
    Q ← P
    WHILE Q <= LENGTH(REST) AND MID(REST, Q, 1) <> ";"
      Q ← Q + 1
    ENDWHILE
    PART ← MID(REST, P, Q - P)
    COMMA ← 1
    WHILE COMMA <= LENGTH(PART) AND MID(PART, COMMA, 1) <> ","
      COMMA ← COMMA + 1
    ENDWHILE
    IF LEFT(PART, COMMA - 1) = SEARCH_FIELD THEN
      RETURN OFFSET_VALUE
    ENDIF
    OFFSET_VALUE ← OFFSET_VALUE + TYPE_SIZE(MID(PART, COMMA + 1, LENGTH(PART)), 0)
    P ← Q + 1
  ENDWHILE
  RETURN -1
ENDFUNCTION

FUNCTION FIELD_TYPE(TYPE_TEXT : STRING, SEARCH_FIELD : STRING) RETURNS STRING
  DECLARE SPEC : STRING
  DECLARE REST : STRING
  DECLARE PART : STRING
  DECLARE P : INTEGER
  DECLARE Q : INTEGER
  DECLARE COMMA : INTEGER
  SPEC ← RESOLVED_SPEC(TYPE_TEXT)
  IF LEFT(SPEC, 7) <> "RECORD:" THEN
    RETURN ""
  ENDIF
  REST ← MID(SPEC, 8, LENGTH(SPEC))
  P ← 1
  WHILE P <= LENGTH(REST)
    Q ← P
    WHILE Q <= LENGTH(REST) AND MID(REST, Q, 1) <> ";"
      Q ← Q + 1
    ENDWHILE
    PART ← MID(REST, P, Q - P)
    COMMA ← 1
    WHILE COMMA <= LENGTH(PART) AND MID(PART, COMMA, 1) <> ","
      COMMA ← COMMA + 1
    ENDWHILE
    IF LEFT(PART, COMMA - 1) = SEARCH_FIELD THEN
      RETURN MID(PART, COMMA + 1, LENGTH(PART))
    ENDIF
    P ← Q + 1
  ENDWHILE
  RETURN ""
ENDFUNCTION

FUNCTION ARRAY_ADDRESS(BASE_CODE : STRING, TYPE_TEXT : STRING, FIRST_ARG : INTEGER, LAST_ARG : INTEGER) RETURNS STRING
  DECLARE SPEC : STRING
  DECLARE REST : STRING
  DECLARE PART : STRING
  DECLARE RESULT : STRING
  DECLARE ELEMENT : STRING
  DECLARE P : INTEGER
  DECLARE Q : INTEGER
  DECLARE COLON : INTEGER
  DECLARE ARG_INDEX : INTEGER
  DECLARE LO : INTEGER
  DECLARE HI : INTEGER
  DECLARE ELEMENT_SIZE : INTEGER
  DECLARE DIMENSION_INDEX : INTEGER
  DECLARE CONSTANT_INDEX : INTEGER
  DECLARE CHECK_CODE : STRING
  DECLARE GUARD_SLOT : INTEGER
  DECLARE INDEX_SLOT : INTEGER
  DECLARE DEPTH : INTEGER
  SPEC ← RESOLVED_SPEC(TYPE_TEXT)
  IF LEFT(SPEC, 6) <> "ARRAY|" THEN
    UNSUPPORTED ← 1
    RETURN ""
  ENDIF
  P ← 7
  WHILE P <= LENGTH(SPEC) AND MID(SPEC, P, 1) <> "|"
    P ← P + 1
  ENDWHILE
  ELEMENT ← MID(SPEC, P + 1, LENGTH(SPEC))
  REST ← MID(SPEC, 7, P - 7) & ","
  RESULT ← BASE_CODE & CHR(65) & CHR(0)
  ARG_INDEX ← FIRST_ARG
  DIMENSION_INDEX ← 0
  P ← 1
  WHILE P <= LENGTH(REST)
    Q ← P
    WHILE MID(REST, Q, 1) <> ","
      Q ← Q + 1
    ENDWHILE
    PART ← MID(REST, P, Q - P)
    COLON ← 1
    WHILE COLON <= LENGTH(PART) AND MID(PART, COLON, 1) <> ":"
      COLON ← COLON + 1
    ENDWHILE
    LO ← BOUND_VALUE(LEFT(PART, COLON - 1))
    HI ← BOUND_VALUE(MID(PART, COLON + 1, LENGTH(PART)))
    IF ARG_INDEX > LAST_ARG OR LO = -2147483647 OR HI = -2147483647 OR ARG_TYPE[ARG_INDEX] = "STRING" THEN
      UNSUPPORTED ← 1
      RETURN ""
    ENDIF
    IF NOT OPTIMIZE_MODE OR DIMENSION_INDEX > 0 THEN
      RESULT ← RESULT & CHR(65) & SLEB(HI - LO + 1) & CHR(108)
    ENDIF
    CONSTANT_INDEX ← -2147483647
    IF OPTIMIZE_MODE AND LEFT(ARG_TEXT[ARG_INDEX], 6) = "CONST:" THEN
      CONSTANT_INDEX ← STR_TO_NUM(MID(ARG_TEXT[ARG_INDEX], 7, LENGTH(ARG_TEXT[ARG_INDEX])))
    ENDIF
    IF CONSTANT_INDEX >= LO AND CONSTANT_INDEX <= HI THEN
      RESULT ← RESULT & CHR(65) & SLEB(CONSTANT_INDEX - LO) & CHR(106)
    ELSE
      GUARD_SLOT ← -1
      INDEX_SLOT ← -1
      IF OPTIMIZE_MODE AND RELEASE_MODE AND FILL_DEPTH <= 256 THEN
        FOR DEPTH ← 1 TO FILL_DEPTH
          IF RANGE_SYMBOL[DEPTH] > 0 AND ARG_TEXT[ARG_INDEX] = SYMBOL_NAMES[RANGE_SYMBOL[DEPTH]] THEN
            IF RANGE_LOW[DEPTH] >= LO AND RANGE_HIGH[DEPTH] <= HI THEN
              GUARD_SLOT ← RANGE_LOCAL[DEPTH]
              INDEX_SLOT ← RANGE_INDEX_LOCAL[DEPTH]
            ENDIF
          ENDIF
        NEXT DEPTH
      ENDIF
      IF GUARD_SLOT >= 0 THEN
        RESULT ← RESULT & CHR(32) & ULEB(GUARD_SLOT) & CHR(4) & CHR(127)
        RESULT ← RESULT & CHR(32) & ULEB(INDEX_SLOT) & CHR(5)
      ENDIF
      RESULT ← RESULT & ARG_CODE[ARG_INDEX] & CHR(33) & ULEB(TEMP_INDEX)
      IF OPTIMIZE_MODE AND RELEASE_MODE AND HI - LO < 1024 THEN
        CHECK_CODE ← CHR(32) & ULEB(TEMP_INDEX) & NUMBER_CODE(LO) & CHR(99)
        CHECK_CODE ← CHECK_CODE & CHR(32) & ULEB(TEMP_INDEX) & NUMBER_CODE(HI) & CHR(100) & CHR(114)
        CHECK_CODE ← CHECK_CODE & CHR(32) & ULEB(TEMP_INDEX) & CHR(157) & CHR(32) & ULEB(TEMP_INDEX) & CHR(98) & CHR(114)
        RESULT ← RESULT & CHECK_CODE & CHR(4) & CHR(64)
        RESULT ← RESULT & CHR(65) & CHR(2) & CHR(65) & SLEB(SOURCE_LINE) & CHR(16) & CHR(5) & CHR(0) & CHR(11)
      ELSE
        RESULT ← RESULT & CHR(32) & ULEB(TEMP_INDEX) & NUMBER_CODE(LO) & CHR(99) & CHR(4) & CHR(64)
        RESULT ← RESULT & CHR(65) & CHR(2) & CHR(65) & SLEB(SOURCE_LINE) & CHR(16) & CHR(5) & CHR(0) & CHR(11)
        RESULT ← RESULT & CHR(32) & ULEB(TEMP_INDEX) & NUMBER_CODE(HI) & CHR(100) & CHR(4) & CHR(64)
        RESULT ← RESULT & CHR(65) & CHR(2) & CHR(65) & SLEB(SOURCE_LINE) & CHR(16) & CHR(5) & CHR(0) & CHR(11)
        RESULT ← RESULT & CHR(32) & ULEB(TEMP_INDEX) & CHR(157) & CHR(32) & ULEB(TEMP_INDEX) & CHR(98) & CHR(4) & CHR(64)
        RESULT ← RESULT & CHR(65) & CHR(2) & CHR(65) & SLEB(SOURCE_LINE) & CHR(16) & CHR(5) & CHR(0) & CHR(11)
      ENDIF
      RESULT ← RESULT & CHR(32) & ULEB(TEMP_INDEX) & CHR(170)
      IF GUARD_SLOT >= 0 THEN
        RESULT ← RESULT & CHR(11)
      ENDIF
      IF NOT OPTIMIZE_MODE OR LO <> 0 THEN
        RESULT ← RESULT & I32_CONST(LO) & CHR(107)
      ENDIF
      RESULT ← RESULT & CHR(106)
    ENDIF
    ARG_INDEX ← ARG_INDEX + 1
    DIMENSION_INDEX ← DIMENSION_INDEX + 1
    P ← Q + 1
  ENDWHILE
  IF ARG_INDEX <> LAST_ARG + 1 THEN
    UNSUPPORTED ← 1
    RETURN ""
  ENDIF
  ELEMENT_SIZE ← TYPE_SIZE(ELEMENT, 0)
  IF OPTIMIZE_MODE AND ELEMENT_SIZE = 8 THEN
    RESULT ← RESULT & CHR(65) & CHR(3) & CHR(116) & CHR(106)
  ELSE
    RESULT ← RESULT & CHR(65) & SLEB(ELEMENT_SIZE) & CHR(108) & CHR(106)
  ENDIF
  RETURN RESULT
ENDFUNCTION

FUNCTION INDEX_CODE(TEXT_VALUE : STRING) RETURNS STRING
  DECLARE P : INTEGER
  DECLARE ITEM : INTEGER
  DECLARE LEFT_CODE : STRING
  DECLARE RIGHT_CODE : STRING
  DECLARE OPERATOR : STRING
  WHILE LEFT(TEXT_VALUE, 1) = " "
    TEXT_VALUE ← MID(TEXT_VALUE, 2, LENGTH(TEXT_VALUE))
  ENDWHILE
  WHILE RIGHT(TEXT_VALUE, 1) = " "
    TEXT_VALUE ← LEFT(TEXT_VALUE, LENGTH(TEXT_VALUE) - 1)
  ENDWHILE
  ITEM ← BOUND_VALUE(TEXT_VALUE)
  IF ITEM <> -2147483647 THEN
    RETURN NUMBER_CODE(ITEM)
  ENDIF
  P ← LENGTH(TEXT_VALUE)
  WHILE P > 1
    OPERATOR ← MID(TEXT_VALUE, P, 1)
    IF OPERATOR = "+" OR OPERATOR = "-" THEN
      LEFT_CODE ← INDEX_CODE(LEFT(TEXT_VALUE, P - 1))
      RIGHT_CODE ← INDEX_CODE(MID(TEXT_VALUE, P + 1, LENGTH(TEXT_VALUE)))
      IF OPERATOR = "+" THEN
        RETURN LEFT_CODE & RIGHT_CODE & CHR(160)
      ENDIF
      RETURN LEFT_CODE & RIGHT_CODE & CHR(161)
    ENDIF
    P ← P - 1
  ENDWHILE
  ITEM ← FIND_SYMBOL(TEXT_VALUE)
  IF ITEM > 0 AND RESOLVED_SPEC(SYMBOL_TYPES[ITEM]) <> "STRING" THEN
    IF PROMOTED_LOCAL[ITEM] > 0 THEN
      RETURN CHR(32) & ULEB(PROMOTED_LOCAL[ITEM] - 1)
    ENDIF
    RETURN ADDRESS_CODE(ITEM) & CHR(43) & CHR(3) & CHR(0)
  ENDIF
  UNSUPPORTED ← 1
  RETURN NUMBER_CODE(0)
ENDFUNCTION

FUNCTION REFERENCE_ADDRESS(TEXT_VALUE : STRING) RETURNS STRING
  DECLARE P : INTEGER
  DECLARE Q : INTEGER
  DECLARE START_INDEX : INTEGER
  DECLARE SLOT : INTEGER
  DECLARE FIELD_NAME : STRING
  DECLARE RESULT : STRING
  DECLARE CURRENT_TYPE : STRING
  DECLARE FIELD_RESULT_TYPE : STRING
  DECLARE CONSTANT_VALUE : INTEGER
  P ← 1
  WHILE P <= LENGTH(TEXT_VALUE) AND MID(TEXT_VALUE, P, 1) <> "[" AND MID(TEXT_VALUE, P, 1) <> "."
    P ← P + 1
  ENDWHILE
  SLOT ← FIND_SYMBOL(LEFT(TEXT_VALUE, P - 1))
  IF SLOT = 0 THEN
    UNSUPPORTED ← 1
    RETURN ""
  ENDIF
  RESULT ← ADDRESS_CODE(SLOT)
  CURRENT_TYPE ← SYMBOL_TYPES[SLOT]
  WHILE P <= LENGTH(TEXT_VALUE)
    IF MID(TEXT_VALUE, P, 1) = "[" THEN
      P ← P + 1
      START_INDEX ← ARG_COUNT + 1
      Q ← P
      WHILE Q <= LENGTH(TEXT_VALUE) AND MID(TEXT_VALUE, Q, 1) <> "]"
        IF MID(TEXT_VALUE, Q, 1) = "," THEN
          ARG_COUNT ← ARG_COUNT + 1
          ARG_CODE[ARG_COUNT] ← INDEX_CODE(MID(TEXT_VALUE, P, Q - P))
          ARG_TYPE[ARG_COUNT] ← "INTEGER"
          ARG_TEXT[ARG_COUNT] ← ""
          CONSTANT_VALUE ← BOUND_VALUE(MID(TEXT_VALUE, P, Q - P))
          IF CONSTANT_VALUE <> -2147483647 THEN
            ARG_TEXT[ARG_COUNT] ← "CONST:" & NUM_TO_STR(CONSTANT_VALUE)
          ENDIF
          P ← Q + 1
        ENDIF
        Q ← Q + 1
      ENDWHILE
      IF Q > LENGTH(TEXT_VALUE) OR ARG_COUNT >= 2048 THEN
        UNSUPPORTED ← 1
        RETURN ""
      ENDIF
      ARG_COUNT ← ARG_COUNT + 1
      ARG_CODE[ARG_COUNT] ← INDEX_CODE(MID(TEXT_VALUE, P, Q - P))
      ARG_TYPE[ARG_COUNT] ← "INTEGER"
      ARG_TEXT[ARG_COUNT] ← ""
      CONSTANT_VALUE ← BOUND_VALUE(MID(TEXT_VALUE, P, Q - P))
      IF CONSTANT_VALUE <> -2147483647 THEN
        ARG_TEXT[ARG_COUNT] ← "CONST:" & NUM_TO_STR(CONSTANT_VALUE)
      ENDIF
      RESULT ← ARRAY_ADDRESS(RESULT, CURRENT_TYPE, START_INDEX, ARG_COUNT)
      ARG_COUNT ← START_INDEX - 1
      CURRENT_TYPE ← ELEMENT_TYPE(CURRENT_TYPE)
      P ← Q + 1
    ELSE
      IF MID(TEXT_VALUE, P, 1) = "." THEN
        P ← P + 1
        Q ← P
        WHILE Q <= LENGTH(TEXT_VALUE) AND MID(TEXT_VALUE, Q, 1) <> "." AND MID(TEXT_VALUE, Q, 1) <> "["
          Q ← Q + 1
        ENDWHILE
        FIELD_NAME ← MID(TEXT_VALUE, P, Q - P)
        SLOT ← FIELD_OFFSET(CURRENT_TYPE, FIELD_NAME)
        FIELD_RESULT_TYPE ← FIELD_TYPE(CURRENT_TYPE, FIELD_NAME)
        IF SLOT < 0 OR FIELD_RESULT_TYPE = "" THEN
          UNSUPPORTED ← 1
          RETURN ""
        ENDIF
        RESULT ← RESULT & CHR(65) & SLEB(SLOT) & CHR(106)
        CURRENT_TYPE ← FIELD_RESULT_TYPE
        P ← Q
      ELSE
        UNSUPPORTED ← 1
        RETURN ""
      ENDIF
    ENDIF
  ENDWHILE
  RESULT_TYPE ← CURRENT_TYPE
  RETURN RESULT
ENDFUNCTION

// A canonical FOR counter starting at an integer literal remains integral if
// its body only reads it. Check the loop's captured end once, then let direct
// array indexes bypass the repeated per-access bounds and fraction checks.
// The ordinary checked path remains for a nonmatching end or array extent.
FUNCTION RANGE_GUARD_SLOT(DEPTH : INTEGER) RETURNS INTEGER
  IF CURRENT_ROUTINE = 0 THEN
    RETURN 3 + PROMOTED_COUNT + 2 * (DEPTH - 1)
  ENDIF
  RETURN ROUTINE_PARAM_COUNTS[CURRENT_ROUTINE] + 5 + ROUTINE_PROMOTED_COUNT[CURRENT_ROUTINE] + 2 * (DEPTH - 1)
ENDFUNCTION

FUNCTION SAFE_FOR_RANGE(AT : INTEGER) RETURNS INTEGER
  DECLARE MARKER : STRING
  DECLARE COUNTER_NAME : STRING
  DECLARE END_NAME : STRING
  DECLARE STEP_NAME : STRING
  DECLARE START_VALUE : INTEGER
  DECLARE COUNTER_ID : INTEGER
  DECLARE END_ID : INTEGER
  DECLARE STEP_ID : INTEGER
  DECLARE SYMBOL_ID : INTEGER
  DECLARE SCAN_AT : INTEGER
  DECLARE END_AT : INTEGER
  DECLARE DEPTH : INTEGER
  DECLARE COLON : INTEGER
  DECLARE SPEC : STRING
  DECLARE BOUNDS : STRING
  DECLARE PART : STRING
  DECLARE P : INTEGER
  DECLARE Q : INTEGER
  DECLARE R : INTEGER
  DECLARE LO : INTEGER
  DECLARE HI : INTEGER
  DECLARE HAS_ARRAY : BOOLEAN
  RANGE_FOUND_LOW ← 0
  RANGE_FOUND_HIGH ← -1
  RANGE_START_VALUE ← 0
  RANGE_END_NAME ← ""
  RANGE_DIRECTION ← 0
  IF AT < 2 OR AT + 8 > LINE_COUNT OR LEFT(LINES[AT - 1], 12) <> "M:FOR_RANGE:" THEN
    RETURN 0
  ENDIF
  MARKER ← MID(LINES[AT - 1], 13, LENGTH(LINES[AT - 1]))
  COLON ← 1
  WHILE COLON <= LENGTH(MARKER) AND MID(MARKER, COLON, 1) <> ":"
    COLON ← COLON + 1
  ENDWHILE
  IF COLON > LENGTH(MARKER) THEN
    RETURN 0
  ENDIF
  COUNTER_NAME ← LEFT(MARKER, COLON - 1)
  START_VALUE ← STR_TO_NUM(MID(MARKER, COLON + 1, LENGTH(MARKER)))
  IF LINES[AT + 2] <> "I:" & COUNTER_NAME OR LINES[AT + 3] <> "GET" OR LINES[AT + 5] <> "GET" OR LINES[AT + 7] <> "GET" THEN
    RETURN 0
  ENDIF
  IF LINES[AT + 8] = "FOR_TEST_UP" THEN
    RANGE_DIRECTION ← 1
  ELSE
    IF LINES[AT + 8] = "FOR_TEST_DOWN" THEN
      RANGE_DIRECTION ← -1
    ELSE
      RETURN 0
    ENDIF
  ENDIF
  END_NAME ← MID(LINES[AT + 4], 3, LENGTH(LINES[AT + 4]))
  STEP_NAME ← MID(LINES[AT + 6], 3, LENGTH(LINES[AT + 6]))
  COUNTER_ID ← FIND_SYMBOL(COUNTER_NAME)
  END_ID ← FIND_SYMBOL(END_NAME)
  STEP_ID ← FIND_SYMBOL(STEP_NAME)
  IF COUNTER_ID = 0 OR END_ID = 0 OR STEP_ID = 0 THEN
    RETURN 0
  ENDIF
  IF PROMOTED_LOCAL[COUNTER_ID] = 0 OR PROMOTED_LOCAL[END_ID] = 0 OR PROMOTED_LOCAL[STEP_ID] = 0 THEN
    RETURN 0
  ENDIF
  DEPTH ← 1
  SCAN_AT ← AT + 1
  WHILE SCAN_AT <= LINE_COUNT AND DEPTH > 0
    IF LINES[SCAN_AT] = "WHILE" THEN
      DEPTH ← DEPTH + 1
    ENDIF
    IF LINES[SCAN_AT] = "ENDWHILE" THEN
      DEPTH ← DEPTH - 1
    ENDIF
    SCAN_AT ← SCAN_AT + 1
  ENDWHILE
  END_AT ← SCAN_AT - 1
  IF DEPTH <> 0 OR END_AT < AT + 17 THEN
    RETURN 0
  ENDIF
  IF LINES[END_AT - 8] <> "I:" & COUNTER_NAME OR LINES[END_AT - 7] <> "O:+" OR LINES[END_AT - 6] <> "I:" & COUNTER_NAME OR LINES[END_AT - 5] <> "GET" THEN
    RETURN 0
  ENDIF
  IF LINES[END_AT - 4] <> "I:" & STEP_NAME OR LINES[END_AT - 3] <> "GET" OR LINES[END_AT - 2] <> "BINARY" OR LINES[END_AT - 1] <> "SET" THEN
    RETURN 0
  ENDIF
  HAS_ARRAY ← FALSE
  FOR SCAN_AT ← AT + 9 TO END_AT - 9
    IF LEFT(LINES[SCAN_AT], 2) = "I:" THEN
      MARKER ← MID(LINES[SCAN_AT], 3, LENGTH(LINES[SCAN_AT]))
      IF MARKER = COUNTER_NAME OR MARKER = END_NAME OR MARKER = STEP_NAME THEN
        IF LINES[SCAN_AT + 1] <> "GET" THEN
          RETURN 0
        ENDIF
      ENDIF
      SYMBOL_ID ← FIND_SYMBOL(MARKER)
      IF SYMBOL_ID > 0 THEN
        SPEC ← RESOLVED_SPEC(SYMBOL_TYPES[SYMBOL_ID])
        IF LEFT(SPEC, 6) = "ARRAY|" THEN
          P ← 7
          WHILE P <= LENGTH(SPEC) AND MID(SPEC, P, 1) <> "|"
            P ← P + 1
          ENDWHILE
          BOUNDS ← MID(SPEC, 7, P - 7) & ","
          P ← 1
          WHILE P <= LENGTH(BOUNDS)
            Q ← P
            WHILE MID(BOUNDS, Q, 1) <> ","
              Q ← Q + 1
            ENDWHILE
            PART ← MID(BOUNDS, P, Q - P)
            R ← 1
            WHILE R <= LENGTH(PART) AND MID(PART, R, 1) <> ":"
              R ← R + 1
            ENDWHILE
            LO ← BOUND_VALUE(LEFT(PART, R - 1))
            HI ← BOUND_VALUE(MID(PART, R + 1, LENGTH(PART)))
            IF LO = -2147483647 OR HI = -2147483647 OR LO > HI THEN
              RETURN 0
            ENDIF
            IF NOT HAS_ARRAY THEN
              RANGE_FOUND_LOW ← LO
              RANGE_FOUND_HIGH ← HI
              HAS_ARRAY ← TRUE
            ELSE
              IF LO > RANGE_FOUND_LOW THEN
                RANGE_FOUND_LOW ← LO
              ENDIF
              IF HI < RANGE_FOUND_HIGH THEN
                RANGE_FOUND_HIGH ← HI
              ENDIF
            ENDIF
            P ← Q + 1
          ENDWHILE
        ENDIF
      ENDIF
    ENDIF
  NEXT SCAN_AT
  IF NOT HAS_ARRAY OR RANGE_FOUND_LOW > RANGE_FOUND_HIGH OR START_VALUE < RANGE_FOUND_LOW OR START_VALUE > RANGE_FOUND_HIGH THEN
    RETURN 0
  ENDIF
  IF RANGE_FOUND_LOW < -2147483646 OR RANGE_FOUND_HIGH > 2147483646 THEN
    RETURN 0
  ENDIF
  RANGE_END_NAME ← END_NAME
  RANGE_START_VALUE ← START_VALUE
  RETURN COUNTER_ID
ENDFUNCTION

// Version a simple zero-fill FOR loop. The fast branch is used only when its
// dynamic extent fits the declared array; otherwise the original loop runs.
FUNCTION ZERO_FILL_PREFIX(AT : INTEGER) RETURNS STRING
  DECLARE LOOP_NAME : STRING
  DECLARE END_NAME : STRING
  DECLARE STEP_NAME : STRING
  DECLARE ARRAY_NAME : STRING
  DECLARE LOOP_ID : INTEGER
  DECLARE END_ID : INTEGER
  DECLARE STEP_ID : INTEGER
  DECLARE ARRAY_ID : INTEGER
  DECLARE SPEC : STRING
  DECLARE BOUNDS : STRING
  DECLARE START_CODE : STRING
  DECLARE END_CODE : STRING
  DECLARE STEP_CODE : STRING
  DECLARE RESULT : STRING
  DECLARE P : INTEGER
  DECLARE Q : INTEGER
  DECLARE HI : INTEGER
  FILL_MATCHED ← FALSE
  IF AT + 28 > LINE_COUNT OR LEFT(LINES[AT + 1], 2) <> "T:" OR LEFT(LINES[AT + 9], 2) <> "T:" OR LEFT(LINES[AT + 19], 2) <> "T:" THEN
    RETURN ""
  ENDIF
  IF LEFT(LINES[AT + 2], 2) <> "I:" OR LEFT(LINES[AT + 4], 2) <> "I:" OR LEFT(LINES[AT + 6], 2) <> "I:" OR LEFT(LINES[AT + 10], 2) <> "I:" THEN
    RETURN ""
  ENDIF
  LOOP_NAME ← MID(LINES[AT + 2], 3, LENGTH(LINES[AT + 2]))
  END_NAME ← MID(LINES[AT + 4], 3, LENGTH(LINES[AT + 4]))
  STEP_NAME ← MID(LINES[AT + 6], 3, LENGTH(LINES[AT + 6]))
  ARRAY_NAME ← MID(LINES[AT + 10], 3, LENGTH(LINES[AT + 10]))
  IF LINES[AT + 3] <> "GET" OR LINES[AT + 5] <> "GET" OR LINES[AT + 7] <> "GET" OR LINES[AT + 8] <> "FOR_TEST_UP" THEN
    RETURN ""
  ENDIF
  IF LINES[AT + 11] <> "GET" OR LINES[AT + 12] <> "ARGS" OR LINES[AT + 13] <> "I:" & LOOP_NAME OR LINES[AT + 14] <> "GET" OR LINES[AT + 15] <> "PUSH" THEN
    RETURN ""
  ENDIF
  IF LINES[AT + 16] <> "K:0" OR LINES[AT + 17] <> "BOOL" OR LINES[AT + 18] <> "SETINDEX" THEN
    RETURN ""
  ENDIF
  IF LINES[AT + 20] <> "I:" & LOOP_NAME OR LINES[AT + 21] <> "O:+" OR LINES[AT + 22] <> "I:" & LOOP_NAME OR LINES[AT + 23] <> "GET" THEN
    RETURN ""
  ENDIF
  IF LINES[AT + 24] <> "I:" & STEP_NAME OR LINES[AT + 25] <> "GET" OR LINES[AT + 26] <> "BINARY" OR LINES[AT + 27] <> "SET" OR LINES[AT + 28] <> "ENDWHILE" THEN
    RETURN ""
  ENDIF
  LOOP_ID ← FIND_SYMBOL(LOOP_NAME)
  END_ID ← FIND_SYMBOL(END_NAME)
  STEP_ID ← FIND_SYMBOL(STEP_NAME)
  ARRAY_ID ← FIND_SYMBOL(ARRAY_NAME)
  IF LOOP_ID = 0 OR END_ID = 0 OR STEP_ID = 0 OR ARRAY_ID = 0 THEN
    RETURN ""
  ENDIF
  IF SYMBOL_SCOPE[ARRAY_ID] <> 0 OR SYMBOL_BYREF[ARRAY_ID] = 1 OR RESOLVED_SPEC(ELEMENT_TYPE(SYMBOL_TYPES[ARRAY_ID])) <> "BOOLEAN" THEN
    RETURN ""
  ENDIF
  SPEC ← RESOLVED_SPEC(SYMBOL_TYPES[ARRAY_ID])
  IF LEFT(SPEC, 6) <> "ARRAY|" THEN
    RETURN ""
  ENDIF
  BOUNDS ← MID(SPEC, 7, LENGTH(SPEC))
  Q ← 1
  WHILE Q <= LENGTH(BOUNDS) AND MID(BOUNDS, Q, 1) <> "|"
    IF MID(BOUNDS, Q, 1) = "," THEN
      RETURN ""
    ENDIF
    Q ← Q + 1
  ENDWHILE
  IF Q > LENGTH(BOUNDS) THEN
    RETURN ""
  ENDIF
  BOUNDS ← LEFT(BOUNDS, Q - 1)
  P ← 1
  WHILE P <= LENGTH(BOUNDS) AND MID(BOUNDS, P, 1) <> ":"
    P ← P + 1
  ENDWHILE
  IF P > LENGTH(BOUNDS) OR BOUND_VALUE(LEFT(BOUNDS, P - 1)) <> 0 THEN
    RETURN ""
  ENDIF
  HI ← BOUND_VALUE(MID(BOUNDS, P + 1, LENGTH(BOUNDS)))
  IF HI < 0 OR HI >= 100000000 THEN
    RETURN ""
  ENDIF
  START_CODE ← INDEX_CODE(LOOP_NAME)
  END_CODE ← INDEX_CODE(END_NAME)
  STEP_CODE ← INDEX_CODE(STEP_NAME)
  RESULT ← START_CODE & NUMBER_CODE(0) & CHR(97)
  RESULT ← RESULT & END_CODE & NUMBER_CODE(0) & CHR(102) & CHR(113)
  RESULT ← RESULT & END_CODE & NUMBER_CODE(HI) & CHR(101) & CHR(113)
  RESULT ← RESULT & END_CODE & CHR(157) & END_CODE & CHR(97) & CHR(113)
  RESULT ← RESULT & STEP_CODE & NUMBER_CODE(1) & CHR(97) & CHR(113)
  RESULT ← RESULT & CHR(4) & CHR(64)
  RESULT ← RESULT & ADDRESS_CODE(ARRAY_ID) & CHR(65) & CHR(0)
  RESULT ← RESULT & END_CODE & CHR(170) & CHR(65) & CHR(1) & CHR(106) & CHR(65) & CHR(3) & CHR(116)
  RESULT ← RESULT & CHR(252) & CHR(11) & CHR(0)
  IF PROMOTED_LOCAL[LOOP_ID] > 0 THEN
    RESULT ← RESULT & END_CODE & NUMBER_CODE(1) & CHR(160) & CHR(33) & ULEB(PROMOTED_LOCAL[LOOP_ID] - 1)
  ELSE
    RESULT ← RESULT & ADDRESS_CODE(LOOP_ID) & END_CODE & NUMBER_CODE(1) & CHR(160) & CHR(57) & CHR(3) & CHR(0)
  ENDIF
  FILL_MATCHED ← TRUE
  RETURN RESULT & CHR(5)
ENDFUNCTION

FUNCTION FIND_STRING(SEARCH_TEXT : STRING) RETURNS INTEGER
  DECLARE ITEM : INTEGER
  FOR ITEM ← 1 TO STRING_COUNT
    IF STRING_NAMES[ITEM] = SEARCH_TEXT THEN
      RETURN ITEM
    ENDIF
  NEXT ITEM
  RETURN 0
ENDFUNCTION

FUNCTION HEX_BYTES(TEXT_VALUE : STRING) RETURNS STRING
  DECLARE RESULT : STRING
  DECLARE P : INTEGER
  DECLARE A : INTEGER
  DECLARE B : INTEGER
  DECLARE C : STRING
  P ← 1
  WHILE P < LENGTH(TEXT_VALUE)
    C ← MID(TEXT_VALUE, P, 1)
    A ← ASC(C)
    IF A >= 65 THEN
      A ← A - 55
    ELSE
      A ← A - 48
    ENDIF
    C ← MID(TEXT_VALUE, P + 1, 1)
    B ← ASC(C)
    IF B >= 65 THEN
      B ← B - 55
    ELSE
      B ← B - 48
    ENDIF
    RESULT ← RESULT & CHR(A * 16 + B)
    P ← P + 2
  ENDWHILE
  RETURN RESULT
ENDFUNCTION

FUNCTION IMPORT_ENTRY(IMPORT_NAME : STRING, TYPE_INDEX : INTEGER) RETURNS STRING
  RETURN CHR(3) & "env" & ULEB(LENGTH(IMPORT_NAME)) & IMPORT_NAME & CHR(0) & ULEB(TYPE_INDEX)
ENDFUNCTION

FUNCTION UTF8(TEXT_VALUE : STRING) RETURNS STRING
  DECLARE RESULT : STRING
  DECLARE P : INTEGER
  DECLARE CODEPOINT : INTEGER
  P ← 1
  WHILE P <= LENGTH(TEXT_VALUE)
    CODEPOINT ← ASC(MID(TEXT_VALUE, P, 2))
    IF CODEPOINT > 65535 THEN
      P ← P + 2
    ELSE
      P ← P + 1
    ENDIF
    IF CODEPOINT >= 55296 AND CODEPOINT <= 57343 THEN
      CODEPOINT ← 65533
    ENDIF
    IF CODEPOINT < 128 THEN
      RESULT ← RESULT & CHR(CODEPOINT)
    ELSE
      IF CODEPOINT < 2048 THEN
        RESULT ← RESULT & CHR(192 + CODEPOINT DIV 64)
        RESULT ← RESULT & CHR(128 + CODEPOINT MOD 64)
      ELSE
        IF CODEPOINT < 65536 THEN
          RESULT ← RESULT & CHR(224 + CODEPOINT DIV 4096)
          RESULT ← RESULT & CHR(128 + (CODEPOINT DIV 64) MOD 64)
          RESULT ← RESULT & CHR(128 + CODEPOINT MOD 64)
        ELSE
          RESULT ← RESULT & CHR(240 + CODEPOINT DIV 262144)
          RESULT ← RESULT & CHR(128 + (CODEPOINT DIV 4096) MOD 64)
          RESULT ← RESULT & CHR(128 + (CODEPOINT DIV 64) MOD 64)
          RESULT ← RESULT & CHR(128 + CODEPOINT MOD 64)
        ENDIF
      ENDIF
    ENDIF
  ENDWHILE
  RETURN RESULT
ENDFUNCTION

INPUT IR
IR ← IR & CHR(10)
POSITION ← 1
WHILE POSITION <= LENGTH(IR)
  IF LINE_COUNT >= 40000 THEN
    UNSUPPORTED ← 1
    POSITION ← LENGTH(IR) + 1
  ELSE
    LINE_COUNT ← LINE_COUNT + 1
    LINE ← ""
    CHARACTER ← MID(IR, POSITION, 1)
    WHILE CHARACTER <> CHR(10)
      LINE ← LINE & CHARACTER
      POSITION ← POSITION + 1
      CHARACTER ← MID(IR, POSITION, 1)
    ENDWHILE
    LINES[LINE_COUNT] ← LINE
    POSITION ← POSITION + 1
  ENDIF
ENDWHILE

// Repeated concatenation copies the entire left operand. Prefer the rope
// compatibility runtime for unbounded loops and large fixed loops.
FOR INDEX ← 1 TO LINE_COUNT
  LINE ← LINES[INDEX]
  IF LINE = "M:NATIVE_BOOTSTRAP" THEN
    BOOTSTRAP_MODE ← TRUE
  ENDIF
  IF LINE = "M:RELEASE" THEN
    RELEASE_MODE ← TRUE
  ENDIF
  IF LINE = "M:OPT_SPEED" THEN
    OPTIMIZE_MODE ← TRUE
  ENDIF
  IF LINE = "WHILE" THEN
    LOOP_DEPTH ← LOOP_DEPTH + 1
    IF LOOP_DEPTH <= 256 THEN
      LOOP_FOR[LOOP_DEPTH] ← FALSE
    ENDIF
  ENDIF
  IF (LINE = "FOR_TEST" OR LINE = "FOR_TEST_UP" OR LINE = "FOR_TEST_DOWN") AND LOOP_DEPTH > 0 AND LOOP_DEPTH <= 256 THEN
    LOOP_FOR[LOOP_DEPTH] ← TRUE
  ENDIF
  IF LINE = "O:&" AND LOOP_DEPTH > 0 AND LOOP_DEPTH <= 256 THEN
    IF LOOP_FOR[LOOP_DEPTH] = FALSE THEN
      SLOW_CONCAT ← TRUE
    ENDIF
  ENDIF
  IF LINE = "ENDWHILE" THEN
    LOOP_DEPTH ← LOOP_DEPTH - 1
  ENDIF
  IF LEFT(LINE, 2) = "I:" THEN
    PART ← MID(LINE, 3, LENGTH(LINE))
    IF INTEGER_LITERAL(PART) THEN
      IF STR_TO_NUM(PART) > 256 OR STR_TO_NUM(PART) < -256 THEN
        LARGE_LITERAL ← TRUE
      ENDIF
    ENDIF
  ENDIF
NEXT INDEX
IF SLOW_CONCAT OR LARGE_LITERAL THEN
  FOR INDEX ← 1 TO LINE_COUNT
    IF LINES[INDEX] = "O:&" AND LARGE_LITERAL THEN
      SLOW_CONCAT ← TRUE
    ENDIF
  NEXT INDEX
ENDIF
IF SLOW_CONCAT AND BOOTSTRAP_MODE = FALSE THEN
  UNSUPPORTED ← 1
  UNSUPPORTED_REASON ← "repeated-string-concat"
ENDIF

// Resolve type aliases and numeric constants from metadata emitted in CAIE.
FOR INDEX ← 1 TO LINE_COUNT
  LINE ← LINES[INDEX]
  IF LEFT(LINE, 8) = "M:CLASS:" OR LEFT(LINE, 9) = "M:METHOD:" THEN
    UNSUPPORTED ← 1
  ENDIF
  IF LEFT(LINE, 10) = "M:ROUTINE:" THEN
    IF ROUTINE_COUNT >= 256 THEN
      UNSUPPORTED ← 1
    ELSE
      ROUTINE_COUNT ← ROUTINE_COUNT + 1
      P ← 11
      Q ← P
      WHILE Q <= LENGTH(LINE) AND MID(LINE, Q, 1) <> ":"
        Q ← Q + 1
      ENDWHILE
      ROUTINE_KINDS[ROUTINE_COUNT] ← MID(LINE, P, Q - P)
      P ← Q + 1
      Q ← P
      WHILE Q <= LENGTH(LINE) AND MID(LINE, Q, 1) <> ":"
        Q ← Q + 1
      ENDWHILE
      ROUTINE_NAMES[ROUTINE_COUNT] ← MID(LINE, P, Q - P)
      P ← Q + 1
      Q ← P
      WHILE Q <= LENGTH(LINE) AND MID(LINE, Q, 1) <> ":"
        Q ← Q + 1
      ENDWHILE
      ROUTINE_RETURNS[ROUTINE_COUNT] ← MID(LINE, P, Q - P)
      PARAM_TEXT ← MID(LINE, Q + 1, LENGTH(LINE))
      P ← 1
      WHILE P <= LENGTH(PARAM_TEXT)
        Q ← P
        WHILE Q <= LENGTH(PARAM_TEXT) AND MID(PARAM_TEXT, Q, 1) <> ";"
          Q ← Q + 1
        ENDWHILE
        PART ← MID(PARAM_TEXT, P, Q - P)
        IF PART <> "" THEN
          ROUTINE_PARAM_COUNTS[ROUTINE_COUNT] ← ROUTINE_PARAM_COUNTS[ROUTINE_COUNT] + 1
          PARAM_COUNT ← ROUTINE_PARAM_COUNTS[ROUTINE_COUNT]
          IF PARAM_COUNT > 16 THEN
            UNSUPPORTED ← 1
          ELSE
            PARAM_SLOT ← (ROUTINE_COUNT - 1) * 16 + PARAM_COUNT
            COMMA ← 1
            WHILE COMMA <= LENGTH(PART) AND MID(PART, COMMA, 1) <> ","
              COMMA ← COMMA + 1
            ENDWHILE
            SECOND_COMMA ← COMMA + 1
            WHILE SECOND_COMMA <= LENGTH(PART) AND MID(PART, SECOND_COMMA, 1) <> ","
              SECOND_COMMA ← SECOND_COMMA + 1
            ENDWHILE
            PARAM_NAMES[PARAM_SLOT] ← LEFT(PART, COMMA - 1)
            PARAM_TYPES[PARAM_SLOT] ← MID(PART, COMMA + 1, SECOND_COMMA - COMMA - 1)
            IF MID(PART, SECOND_COMMA + 1, 1) = "1" THEN
              PARAM_BYREF[PARAM_SLOT] ← 1
            ENDIF
          ENDIF
        ENDIF
        P ← Q + 1
      ENDWHILE
    ENDIF
  ENDIF
  IF LEFT(LINE, 7) = "M:TYPE:" THEN
    SCAN ← 8
    WHILE SCAN <= LENGTH(LINE) AND MID(LINE, SCAN, 1) <> ":"
      SCAN ← SCAN + 1
    ENDWHILE
    IF TYPE_COUNT >= 256 OR SCAN > LENGTH(LINE) THEN
      UNSUPPORTED ← 1
    ELSE
      TYPE_COUNT ← TYPE_COUNT + 1
      TYPE_NAMES[TYPE_COUNT] ← MID(LINE, 8, SCAN - 8)
      TYPE_SPECS[TYPE_COUNT] ← MID(LINE, SCAN + 1, LENGTH(LINE))
    ENDIF
  ENDIF
  IF LEFT(LINE, 8) = "M:CONST:" THEN
    SCAN ← 9
    WHILE SCAN <= LENGTH(LINE) AND MID(LINE, SCAN, 1) <> ":"
      SCAN ← SCAN + 1
    ENDWHILE
    IF CONSTANT_COUNT >= 256 OR SCAN > LENGTH(LINE) OR INTEGER_LITERAL(MID(LINE, SCAN + 1, LENGTH(LINE))) = FALSE THEN
      UNSUPPORTED ← 1
    ELSE
      CONSTANT_COUNT ← CONSTANT_COUNT + 1
      CONSTANT_NAMES[CONSTANT_COUNT] ← MID(LINE, 9, SCAN - 9)
      CONSTANT_VALUES[CONSTANT_COUNT] ← STR_TO_NUM(MID(LINE, SCAN + 1, LENGTH(LINE)))
    ENDIF
  ENDIF
NEXT INDEX
IF UNSUPPORTED = 1 THEN
  UNSUPPORTED_REASON ← "metadata"
ENDIF

FOR INDEX ← 1 TO CONSTANT_COUNT
  IF SYMBOL_COUNT >= 1024 THEN
    UNSUPPORTED ← 1
  ELSE
    SYMBOL_COUNT ← SYMBOL_COUNT + 1
    SYMBOL_NAMES[SYMBOL_COUNT] ← CONSTANT_NAMES[INDEX]
    SYMBOL_TYPES[SYMBOL_COUNT] ← "INTEGER"
    SYMBOL_OFFSETS[SYMBOL_COUNT] ← GLOBAL_SIZE
    GLOBAL_SIZE ← GLOBAL_SIZE + 8
  ENDIF
NEXT INDEX

FOR ROUTINE_NUMBER ← 1 TO ROUTINE_COUNT
  FOR P ← 1 TO ROUTINE_PARAM_COUNTS[ROUTINE_NUMBER]
    PARAM_SLOT ← (ROUTINE_NUMBER - 1) * 16 + P
    SPEC_SIZE ← TYPE_SIZE(PARAM_TYPES[PARAM_SLOT], 0)
    IF SPEC_SIZE = 0 OR (PARAM_BYREF[PARAM_SLOT] = 0 AND SPEC_SIZE <> 8) OR SYMBOL_COUNT >= 1024 THEN
      UNSUPPORTED ← 1
    ELSE
      SYMBOL_COUNT ← SYMBOL_COUNT + 1
      SYMBOL_NAMES[SYMBOL_COUNT] ← PARAM_NAMES[PARAM_SLOT]
      SYMBOL_TYPES[SYMBOL_COUNT] ← PARAM_TYPES[PARAM_SLOT]
      SYMBOL_SCOPE[SYMBOL_COUNT] ← ROUTINE_NUMBER
      SYMBOL_BYREF[SYMBOL_COUNT] ← PARAM_BYREF[PARAM_SLOT]
      SYMBOL_PARAM[SYMBOL_COUNT] ← P - 1
      IF PARAM_BYREF[PARAM_SLOT] = 0 THEN
        SYMBOL_OFFSETS[SYMBOL_COUNT] ← ROUTINE_SIZES[ROUTINE_NUMBER]
        ROUTINE_SIZES[ROUTINE_NUMBER] ← ROUTINE_SIZES[ROUTINE_NUMBER] + 8
      ENDIF
    ENDIF
  NEXT P
NEXT ROUTINE_NUMBER
IF UNSUPPORTED = 1 AND UNSUPPORTED_REASON = "" THEN
  UNSUPPORTED_REASON ← "parameters"
ENDIF

// Declarations carry a name and two equal type tokens before CREATE.
FOR INDEX ← 1 TO LINE_COUNT
  LINE ← LINES[INDEX]
  IF LEFT(LINE, 2) = "R:" THEN
    CURRENT_ROUTINE ← 0
    NAME ← MID(LINE, 3, LENGTH(LINE))
    FOR J ← 1 TO ROUTINE_COUNT
      IF ROUTINE_NAMES[J] = NAME THEN
        CURRENT_ROUTINE ← J
      ENDIF
    NEXT J
    IF CURRENT_ROUTINE = 0 THEN
      UNSUPPORTED ← 1
    ENDIF
  ENDIF
  IF LINE = "ENDROUTINE" THEN
    CURRENT_ROUTINE ← 0
  ENDIF
  IF LINE = "DECLARE" OR LINE = "LOOPDECLARE" THEN
    START_AT ← INDEX - 1
    WHILE START_AT > 0 AND LEFT(LINES[START_AT], 2) <> "T:"
      START_AT ← START_AT - 1
    ENDWHILE
    CONSTANT_INDEX ← 0
    FOR J ← START_AT + 1 TO INDEX - 1
      IF LINES[J] = "I:$CONSTANT" THEN
        CONSTANT_INDEX ← 1
        SKIP_TO[J - 1] ← INDEX
      ENDIF
    NEXT J
    IF CONSTANT_INDEX = 1 THEN
      // Constant storage was allocated from M:CONST metadata.
      START_AT ← INDEX
    ELSE
      SCAN ← INDEX - 2
      K ← 0
      WHILE SCAN >= START_AT + 4 AND K = 0
        IF LINES[SCAN] = "ARGS" AND LEFT(LINES[SCAN - 1], 2) = "I:" AND LINES[SCAN - 1] = LINES[SCAN - 2] AND LEFT(LINES[SCAN - 3], 2) = "I:" THEN
          K ← SCAN
        ELSE
          SCAN ← SCAN - 1
        ENDIF
      ENDWHILE
      IF K > 0 THEN
        NAME ← MID(LINES[K - 3], 3, LENGTH(LINES[K - 3]))
        RESULT_TYPE ← MID(LINES[K - 2], 3, LENGTH(LINES[K - 2]))
        SPEC_SIZE ← TYPE_SIZE(RESULT_TYPE, 0)
        IF SPEC_SIZE = 0 OR SYMBOL_EXISTS_IN_SCOPE(NAME, CURRENT_ROUTINE) OR SYMBOL_COUNT >= 1024 THEN
          UNSUPPORTED ← 1
          IF UNSUPPORTED_REASON = "" THEN
            UNSUPPORTED_REASON ← "declaration:" & NAME & ":" & RESULT_TYPE & ":" & NUM_TO_STR(SPEC_SIZE)
          ENDIF
        ELSE
          SYMBOL_COUNT ← SYMBOL_COUNT + 1
          SYMBOL_NAMES[SYMBOL_COUNT] ← NAME
          SYMBOL_TYPES[SYMBOL_COUNT] ← RESULT_TYPE
          SYMBOL_SCOPE[SYMBOL_COUNT] ← CURRENT_ROUTINE
          SYMBOL_PARAM[SYMBOL_COUNT] ← -1
          IF CURRENT_ROUTINE = 0 THEN
            SYMBOL_OFFSETS[SYMBOL_COUNT] ← GLOBAL_SIZE
            GLOBAL_SIZE ← GLOBAL_SIZE + SPEC_SIZE
          ELSE
            SYMBOL_OFFSETS[SYMBOL_COUNT] ← ROUTINE_SIZES[CURRENT_ROUTINE]
            ROUTINE_SIZES[CURRENT_ROUTINE] ← ROUTINE_SIZES[CURRENT_ROUTINE] + SPEC_SIZE
          ENDIF
          SKIP_TO[K - 3] ← INDEX
        ENDIF
      ELSE
        UNSUPPORTED ← 1
        IF UNSUPPORTED_REASON = "" THEN
          UNSUPPORTED_REASON ← "declaration-pattern:" & NUM_TO_STR(INDEX)
        ENDIF
      ENDIF
    ENDIF
    IF INDEX < 6 THEN
      UNSUPPORTED ← 1
    ENDIF
  ENDIF
NEXT INDEX
IF UNSUPPORTED = 1 AND UNSUPPORTED_REASON = "" THEN
  UNSUPPORTED_REASON ← "declarations"
ENDIF
CURRENT_ROUTINE ← 0

FOR INDEX ← 2 TO LINE_COUNT
  IF LINES[INDEX] = "STR" AND LEFT(LINES[INDEX - 1], 2) = "I:" THEN
    NAME ← MID(LINES[INDEX - 1], 3, LENGTH(LINES[INDEX - 1]))
    IF FIND_STRING(NAME) = 0 THEN
      IF STRING_COUNT >= 2048 THEN
        UNSUPPORTED ← 1
      ELSE
        STRING_BYTES ← UTF8(NAME)
        STRING_COUNT ← STRING_COUNT + 1
        STRING_NAMES[STRING_COUNT] ← NAME
        STRING_OFFSETS[STRING_COUNT] ← 8 + LENGTH(STATIC_DATA)
        LENGTH_VALUE ← LENGTH(STRING_BYTES)
        FOR J ← 1 TO 4
          STATIC_DATA ← STATIC_DATA & CHR(LENGTH_VALUE MOD 256)
          LENGTH_VALUE ← LENGTH_VALUE DIV 256
        NEXT J
        STATIC_DATA ← STATIC_DATA & STRING_BYTES
        WHILE LENGTH(STATIC_DATA) MOD 4 <> 0
          STATIC_DATA ← STATIC_DATA & CHR(0)
        ENDWHILE
      ENDIF
    ENDIF
  ENDIF
NEXT INDEX
GLOBAL_BASE ← 8 + LENGTH(STATIC_DATA)
WHILE GLOBAL_BASE MOD 8 <> 0
  GLOBAL_BASE ← GLOBAL_BASE + 1
ENDWHILE
FRAME_BASE ← GLOBAL_BASE + GLOBAL_SIZE
HEAP_BASE ← FRAME_BASE + 1048576
WHILE HEAP_BASE MOD 8 <> 0
  HEAP_BASE ← HEAP_BASE + 1
ENDWHILE
MEMORY_PAGES ← (HEAP_BASE + 65536 + 65535) DIV 65536
FOR INDEX ← 1 TO ROUTINE_COUNT
  IF ROUTINE_SIZES[INDEX] > 1048576 THEN
    UNSUPPORTED ← 1
  ENDIF
NEXT INDEX

// The fixed host ABI contains only I/O, errors, random values and text built-ins.
ROUTINE_TYPE_SECTION ← HEX_BYTES("60017C0060017F0060027F7F0060000060027F7F017C60027F7F006000017F60017C017C60017C0060017F017C6000017C60017C017C60017C017C60017C017C")
FOR ROUTINE_NUMBER ← 1 TO ROUTINE_COUNT
  PARAM_COUNT ← ROUTINE_PARAM_COUNTS[ROUTINE_NUMBER]
  ROUTINE_TYPE_SECTION ← ROUTINE_TYPE_SECTION & CHR(96) & ULEB(PARAM_COUNT)
  FOR P ← 1 TO PARAM_COUNT
    PARAM_SLOT ← (ROUTINE_NUMBER - 1) * 16 + P
    IF PARAM_BYREF[PARAM_SLOT] = 1 THEN
      ROUTINE_TYPE_SECTION ← ROUTINE_TYPE_SECTION & CHR(127)
    ELSE
      ROUTINE_TYPE_SECTION ← ROUTINE_TYPE_SECTION & CHR(124)
    ENDIF
  NEXT P
  ROUTINE_TYPE_SECTION ← ROUTINE_TYPE_SECTION & CHR(1) & CHR(124)
NEXT ROUTINE_NUMBER
ROUTINE_TYPE_SECTION ← ROUTINE_TYPE_SECTION & HEX_BYTES("60027C7C017C60027C7C017C60000060037C7C7C017C")
SECTION_DATA ← ULEB(ROUTINE_COUNT + 18) & ROUTINE_TYPE_SECTION
PREFIX_HEX ← ""
IMPORT_BODY ← ULEB(22) & HEX_BYTES(MID(PREFIX_HEX, 9, LENGTH(PREFIX_HEX)))
IMPORT_BODY ← IMPORT_BODY & IMPORT_ENTRY("chr", 7) & IMPORT_ENTRY("asc", 7)
IMPORT_BODY ← IMPORT_BODY & IMPORT_ENTRY("left", 14 + ROUTINE_COUNT) & IMPORT_ENTRY("right", 14 + ROUTINE_COUNT)
IMPORT_BODY ← IMPORT_BODY & IMPORT_ENTRY("mid", 17 + ROUTINE_COUNT)
IMPORT_BODY ← IMPORT_BODY & IMPORT_ENTRY("strToNum", 7) & IMPORT_ENTRY("isNum", 7)
IMPORT_BODY ← IMPORT_BODY & IMPORT_ENTRY("materialize", 7)
PREFIX ← CHR(0) & "asm" & CHR(1) & CHR(0) & CHR(0) & CHR(0) & CHR(1) & ULEB(LENGTH(SECTION_DATA)) & SECTION_DATA
PREFIX ← PREFIX & CHR(2) & ULEB(LENGTH(IMPORT_BODY)) & IMPORT_BODY

// Routines can keep scalar parameters and locals in WASM locals when no
// statement takes an address or reads input into an address. Globals are
// promoted only in main-only release builds, then copied back to memory.
CAN_PROMOTE ← TRUE
IF CAN_PROMOTE THEN
  FOR INDEX ← 1 TO LINE_COUNT
    IF LINES[INDEX] = "REFNAME" OR LINES[INDEX] = "INPUT" THEN
      CAN_PROMOTE ← FALSE
    ENDIF
  NEXT INDEX
ENDIF
IF CAN_PROMOTE THEN
  FOR J ← CONSTANT_COUNT + 1 TO SYMBOL_COUNT
    RESULT_TYPE ← RESOLVED_SPEC(SYMBOL_TYPES[J])
    IF RESULT_TYPE = "INTEGER" OR RESULT_TYPE = "REAL" OR RESULT_TYPE = "BOOLEAN" THEN
      IF SYMBOL_SCOPE[J] = 0 AND ROUTINE_COUNT = 0 AND RELEASE_MODE THEN
        PROMOTED_COUNT ← PROMOTED_COUNT + 1
        PROMOTED_LOCAL[J] ← PROMOTED_COUNT + 3
      ELSE
        IF SYMBOL_SCOPE[J] > 0 AND SYMBOL_BYREF[J] = 0 THEN
          IF SYMBOL_PARAM[J] >= 0 THEN
            PROMOTED_LOCAL[J] ← SYMBOL_PARAM[J] + 1
          ELSE
            ROUTINE_NUMBER ← SYMBOL_SCOPE[J]
            ROUTINE_PROMOTED_COUNT[ROUTINE_NUMBER] ← ROUTINE_PROMOTED_COUNT[ROUTINE_NUMBER] + 1
            PROMOTED_LOCAL[J] ← ROUTINE_PARAM_COUNTS[ROUTINE_NUMBER] + 5 + ROUTINE_PROMOTED_COUNT[ROUTINE_NUMBER]
          ENDIF
        ENDIF
      ENDIF
    ENDIF
  NEXT J
ENDIF
FOR J ← 1 TO SYMBOL_COUNT
  IF SYMBOL_SCOPE[J] > 0 AND SYMBOL_BYREF[J] = 0 AND PROMOTED_LOCAL[J] = 0 THEN
    ROUTINE_NUMBER ← SYMBOL_SCOPE[J]
    ROUTINE_NEEDS_FRAME[ROUTINE_NUMBER] ← TRUE
  ENDIF
NEXT J

// Guarded builds cache the budget once. Release builds retain the source line
// for errors but omit the step counter and limit branch from hot loops.
IF RELEASE_MODE = FALSE THEN
  CODE ← CHR(16) & CHR(6) & CHR(36) & CHR(3)
ENDIF
FOR J ← 1 TO CONSTANT_COUNT
  CODE ← CODE & CHR(65) & SLEB(GLOBAL_BASE + SYMBOL_OFFSETS[J]) & NUMBER_CODE(CONSTANT_VALUES[J]) & CHR(57) & CHR(3) & CHR(0)
NEXT J
TEMP_A ← 0
TEMP_B ← 1
TEMP_INDEX ← 2
INDEX ← 1
WHILE INDEX <= LINE_COUNT AND UNSUPPORTED = 0
  LINE ← LINES[INDEX]
  IF LEFT(LINE, 2) = "M:" THEN
    LINE ← ""
  ENDIF
  IF LEFT(LINE, 2) = "R:" THEN
    CURRENT_ROUTINE ← FIND_ROUTINE(MID(LINE, 3, LENGTH(LINE)))
    IF CURRENT_ROUTINE = 0 THEN
      UNSUPPORTED ← 1
    ELSE
      MAIN_CODE ← CODE
      PARAM_COUNT ← ROUTINE_PARAM_COUNTS[CURRENT_ROUTINE]
      TEMP_A ← PARAM_COUNT
      TEMP_B ← PARAM_COUNT + 1
      TEMP_INDEX ← PARAM_COUNT + 2
      BASE_LOCAL ← PARAM_COUNT + 3
      RESULT_LOCAL ← PARAM_COUNT + 4
      CODE ← ROUTINE_PROLOGUE(CURRENT_ROUTINE)
    ENDIF
    LINE ← ""
  ENDIF
  IF LINE = "RETURN" THEN
    IF CURRENT_ROUTINE = 0 THEN
      UNSUPPORTED ← 1
    ELSE
      VALUE_CODE ← NUMBER_CODE(0)
      IF STACK_SIZE > 0 THEN
        IF STACK_KIND[STACK_SIZE] = "VALUE" THEN
          VALUE_CODE ← STACK_CODE[STACK_SIZE]
          STACK_SIZE ← STACK_SIZE - 1
        ENDIF
      ENDIF
      CODE ← CODE & ROUTINE_EPILOGUE(VALUE_CODE) & CHR(15)
    ENDIF
    LINE ← ""
  ENDIF
  IF LINE = "ENDROUTINE" THEN
    IF CURRENT_ROUTINE = 0 THEN
      UNSUPPORTED ← 1
    ELSE
      CODE ← CODE & ROUTINE_EPILOGUE(NUMBER_CODE(0)) & CHR(11)
      BODY ← CHR(5) & CHR(1) & CHR(124) & CHR(1) & CHR(124) & CHR(1) & CHR(124) & CHR(1) & CHR(127) & CHR(1) & CHR(124)
      IF ROUTINE_PROMOTED_COUNT[CURRENT_ROUTINE] > 0 THEN
        BODY ← CHR(6) & CHR(1) & CHR(124) & CHR(1) & CHR(124) & CHR(1) & CHR(124) & CHR(1) & CHR(127) & CHR(1) & CHR(124) & ULEB(ROUTINE_PROMOTED_COUNT[CURRENT_ROUTINE]) & CHR(124)
      ENDIF
      IF RANGE_MAX_DEPTH[CURRENT_ROUTINE + 1] > 0 THEN
        BODY ← CHR(ASC(LEFT(BODY, 1)) + 1) & MID(BODY, 2, LENGTH(BODY))
        BODY ← BODY & ULEB(2 * RANGE_MAX_DEPTH[CURRENT_ROUTINE + 1]) & CHR(127)
      ENDIF
      BODY ← BODY & CODE
      ROUTINE_BODIES[CURRENT_ROUTINE] ← BODY
      CODE ← MAIN_CODE
      CURRENT_ROUTINE ← 0
      TEMP_A ← 0
      TEMP_B ← 1
      TEMP_INDEX ← 2
      BASE_LOCAL ← 0
      RESULT_LOCAL ← 0
    ENDIF
    LINE ← ""
  ENDIF
  IF LEFT(LINE, 12) = "CALLROUTINE:" THEN
    ROUTINE_NUMBER ← STR_TO_NUM(MID(LINE, 13, LENGTH(LINE))) + 1
    IF ROUTINE_NUMBER < 1 OR ROUTINE_NUMBER > ROUTINE_COUNT OR STACK_SIZE < 1 OR STACK_KIND[STACK_SIZE] <> "ARGS" THEN
      UNSUPPORTED ← 1
    ELSE
      J ← STACK_MARK[STACK_SIZE]
      IF ARG_COUNT - J <> ROUTINE_PARAM_COUNTS[ROUTINE_NUMBER] THEN
        UNSUPPORTED ← 1
      ELSE
        VALUE_CODE ← ""
        FOR P ← 1 TO ROUTINE_PARAM_COUNTS[ROUTINE_NUMBER]
          PARAM_SLOT ← (ROUTINE_NUMBER - 1) * 16 + P
          IF PARAM_BYREF[PARAM_SLOT] = 1 THEN
            IF ARG_KIND[J + P] <> "ADDRESS" OR RESOLVED_SPEC(ARG_TYPE[J + P]) <> RESOLVED_SPEC(PARAM_TYPES[PARAM_SLOT]) THEN
              UNSUPPORTED ← 1
            ENDIF
          ELSE
            IF ARG_KIND[J + P] <> "VALUE" THEN
              UNSUPPORTED ← 1
            ENDIF
            IF (RESOLVED_SPEC(ARG_TYPE[J + P]) = "STRING") <> (RESOLVED_SPEC(PARAM_TYPES[PARAM_SLOT]) = "STRING") THEN
              UNSUPPORTED ← 1
            ENDIF
          ENDIF
          VALUE_CODE ← VALUE_CODE & ARG_CODE[J + P]
        NEXT P
        STACK_CODE[STACK_SIZE] ← VALUE_CODE & CHR(16) & ULEB(22 + ROUTINE_NUMBER - 1)
        STACK_KIND[STACK_SIZE] ← "VALUE"
        STACK_TYPE[STACK_SIZE] ← ROUTINE_RETURNS[ROUTINE_NUMBER]
        IF STACK_TYPE[STACK_SIZE] = "" THEN
          STACK_TYPE[STACK_SIZE] ← "REAL"
        ENDIF
        ARG_COUNT ← J
      ENDIF
    ENDIF
    LINE ← ""
  ENDIF
  IF LINE = "DROP" THEN
    IF STACK_SIZE < 1 OR STACK_KIND[STACK_SIZE] <> "VALUE" THEN
      UNSUPPORTED ← 1
    ELSE
      CODE ← CODE & STACK_CODE[STACK_SIZE] & CHR(26)
      STACK_SIZE ← STACK_SIZE - 1
    ENDIF
    LINE ← ""
  ENDIF
  IF LINE = "INDEX" OR LINE = "SETINDEX" THEN
    IF LINE = "INDEX" THEN
      K ← STACK_SIZE - 1
    ELSE
      K ← STACK_SIZE - 2
    ENDIF
    IF K < 1 OR STACK_KIND[K] <> "ADDRESS" OR STACK_KIND[K + 1] <> "ARGS" THEN
      UNSUPPORTED ← 1
    ELSE
      J ← STACK_MARK[K + 1]
      VALUE_CODE ← ARRAY_ADDRESS(STACK_CODE[K], STACK_TYPE[K], J + 1, ARG_COUNT)
      RESULT_TYPE ← ELEMENT_TYPE(STACK_TYPE[K])
      IF RESULT_TYPE = "" OR TYPE_SIZE(RESULT_TYPE, 0) = 0 THEN
        UNSUPPORTED ← 1
      ELSE
        IF LINE = "INDEX" THEN
          IF TYPE_SIZE(RESULT_TYPE, 0) = 8 AND (RESOLVED_SPEC(RESULT_TYPE) = "INTEGER" OR RESOLVED_SPEC(RESULT_TYPE) = "REAL" OR RESOLVED_SPEC(RESULT_TYPE) = "BOOLEAN" OR RESOLVED_SPEC(RESULT_TYPE) = "STRING") THEN
            STACK_CODE[K] ← VALUE_CODE & CHR(43) & CHR(3) & CHR(0)
            STACK_KIND[K] ← "VALUE"
          ELSE
            STACK_CODE[K] ← VALUE_CODE
            STACK_KIND[K] ← "ADDRESS"
          ENDIF
          STACK_TYPE[K] ← RESULT_TYPE
          STACK_SIZE ← K
        ELSE
          IF STACK_KIND[K + 2] <> "VALUE" OR TYPE_SIZE(RESULT_TYPE, 0) <> 8 THEN
            UNSUPPORTED ← 1
          ELSE
            CODE ← CODE & VALUE_CODE & STACK_CODE[K + 2] & CHR(57) & CHR(3) & CHR(0)
            STACK_SIZE ← K - 1
          ENDIF
        ENDIF
      ENDIF
      ARG_COUNT ← J
    ENDIF
    LINE ← ""
  ENDIF
  IF LINE = "FIELD" OR LINE = "SETFIELD" THEN
    IF LINE = "FIELD" THEN
      K ← STACK_SIZE - 1
    ELSE
      K ← STACK_SIZE - 2
    ENDIF
    IF K < 1 OR STACK_KIND[K] <> "ADDRESS" OR STACK_KIND[K + 1] <> "RAW" THEN
      UNSUPPORTED ← 1
    ELSE
      ADDRESS ← FIELD_OFFSET(STACK_TYPE[K], STACK_TEXT[K + 1])
      RESULT_TYPE ← FIELD_TYPE(STACK_TYPE[K], STACK_TEXT[K + 1])
      IF ADDRESS < 0 OR RESULT_TYPE = "" OR TYPE_SIZE(RESULT_TYPE, 0) = 0 THEN
        UNSUPPORTED ← 1
      ELSE
        VALUE_CODE ← STACK_CODE[K] & CHR(65) & SLEB(ADDRESS) & CHR(106)
        IF LINE = "FIELD" THEN
          IF TYPE_SIZE(RESULT_TYPE, 0) = 8 AND (RESOLVED_SPEC(RESULT_TYPE) = "INTEGER" OR RESOLVED_SPEC(RESULT_TYPE) = "REAL" OR RESOLVED_SPEC(RESULT_TYPE) = "BOOLEAN" OR RESOLVED_SPEC(RESULT_TYPE) = "STRING") THEN
            STACK_CODE[K] ← VALUE_CODE & CHR(43) & CHR(3) & CHR(0)
            STACK_KIND[K] ← "VALUE"
          ELSE
            STACK_CODE[K] ← VALUE_CODE
            STACK_KIND[K] ← "ADDRESS"
          ENDIF
          STACK_TYPE[K] ← RESULT_TYPE
          STACK_SIZE ← K
        ELSE
          IF STACK_KIND[K + 2] <> "VALUE" OR TYPE_SIZE(RESULT_TYPE, 0) <> 8 THEN
            UNSUPPORTED ← 1
          ELSE
            CODE ← CODE & VALUE_CODE & STACK_CODE[K + 2] & CHR(57) & CHR(3) & CHR(0)
            STACK_SIZE ← K - 1
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    LINE ← ""
  ENDIF
  IF LEFT(LINE, 2) = "T:" THEN
    SOURCE_LINE ← STR_TO_NUM(MID(LINE, 3, LENGTH(LINE)))
    CODE ← CODE & CHR(65) & SLEB(SOURCE_LINE) & CHR(36) & CHR(2)
    IF RELEASE_MODE = FALSE THEN
      CODE ← CODE & CHR(35) & CHR(1) & CHR(65) & CHR(1) & CHR(106) & CHR(36) & CHR(1)
      CODE ← CODE & CHR(35) & CHR(1) & CHR(35) & CHR(3) & CHR(75) & CHR(4) & CHR(64)
      CODE ← CODE & CHR(65) & CHR(1) & CHR(65) & SLEB(SOURCE_LINE) & CHR(16) & CHR(5) & CHR(0) & CHR(11)
    ENDIF
  ELSE
    IF LEFT(LINE, 2) = "I:" THEN
      IF SKIP_TO[INDEX] > 0 THEN
        INDEX ← SKIP_TO[INDEX]
      ELSE
        STACK_SIZE ← STACK_SIZE + 1
        IF STACK_SIZE > 2048 THEN
          UNSUPPORTED ← 1
        ELSE
          STACK_KIND[STACK_SIZE] ← "RAW"
          STACK_TEXT[STACK_SIZE] ← MID(LINE, 3, LENGTH(LINE))
          STACK_CODE[STACK_SIZE] ← ""
          STACK_TYPE[STACK_SIZE] ← ""
        ENDIF
      ENDIF
    ELSE
      IF LEFT(LINE, 2) = "K:" THEN
        STACK_SIZE ← STACK_SIZE + 1
        STACK_KIND[STACK_SIZE] ← "VALUE"
        STACK_TYPE[STACK_SIZE] ← "BOOLEAN"
        IF LINE = "K:1" THEN
          STACK_CODE[STACK_SIZE] ← NUMBER_CODE(1)
        ELSE
          STACK_CODE[STACK_SIZE] ← NUMBER_CODE(0)
        ENDIF
      ELSE
      IF LEFT(LINE, 2) = "O:" OR LEFT(LINE, 2) = "U:" THEN
        STACK_SIZE ← STACK_SIZE + 1
        STACK_KIND[STACK_SIZE] ← "OP"
        STACK_TEXT[STACK_SIZE] ← MID(LINE, 3, LENGTH(LINE))
      ELSE
        IF LINE = "ARGS" THEN
          STACK_SIZE ← STACK_SIZE + 1
          STACK_KIND[STACK_SIZE] ← "ARGS"
          STACK_MARK[STACK_SIZE] ← ARG_COUNT
        ELSE
          IF LINE = "STR" THEN
            IF STACK_SIZE < 1 OR STACK_KIND[STACK_SIZE] <> "RAW" THEN
              UNSUPPORTED ← 1
            ELSE
              J ← FIND_STRING(STACK_TEXT[STACK_SIZE])
              IF J = 0 THEN
                UNSUPPORTED ← 1
              ELSE
                STACK_CODE[STACK_SIZE] ← NUMBER_CODE(STRING_OFFSETS[J])
              ENDIF
              STACK_KIND[STACK_SIZE] ← "VALUE"
              STACK_TYPE[STACK_SIZE] ← "STRING"
            ENDIF
          ELSE
            IF LINE = "GET" OR LINE = "REFNAME" THEN
              IF STACK_SIZE < 1 OR STACK_KIND[STACK_SIZE] <> "RAW" THEN
                UNSUPPORTED ← 1
              ELSE
                IF LINE = "REFNAME" THEN
                  STACK_CODE[STACK_SIZE] ← REFERENCE_ADDRESS(STACK_TEXT[STACK_SIZE])
                  STACK_TYPE[STACK_SIZE] ← RESULT_TYPE
                  STACK_KIND[STACK_SIZE] ← "ADDRESS"
                ELSE
                  J ← FIND_SYMBOL(STACK_TEXT[STACK_SIZE])
                  IF J = 0 THEN
                    UNSUPPORTED ← 1
                  ELSE
                    IF PROMOTED_LOCAL[J] > 0 THEN
                      STACK_CODE[STACK_SIZE] ← CHR(32) & ULEB(PROMOTED_LOCAL[J] - 1)
                    ELSE
                      STACK_CODE[STACK_SIZE] ← ADDRESS_CODE(J)
                    ENDIF
                    STACK_TYPE[STACK_SIZE] ← SYMBOL_TYPES[J]
                    RESULT_TYPE ← RESOLVED_SPEC(SYMBOL_TYPES[J])
                    IF LEFT(RESULT_TYPE, 6) = "ARRAY|" OR LEFT(RESULT_TYPE, 7) = "RECORD:" THEN
                      STACK_KIND[STACK_SIZE] ← "ADDRESS"
                    ELSE
                      IF PROMOTED_LOCAL[J] = 0 THEN
                        STACK_CODE[STACK_SIZE] ← STACK_CODE[STACK_SIZE] & CHR(43) & CHR(3) & CHR(0)
                      ENDIF
                      STACK_KIND[STACK_SIZE] ← "VALUE"
                    ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ELSE
              IF LINE = "PUSH" THEN
                IF STACK_SIZE < 2 OR STACK_KIND[STACK_SIZE - 1] <> "ARGS" OR ARG_COUNT >= 2048 THEN
                  UNSUPPORTED ← 1
                ELSE
                  ARG_COUNT ← ARG_COUNT + 1
                  ARG_CODE[ARG_COUNT] ← STACK_CODE[STACK_SIZE]
                  ARG_TYPE[ARG_COUNT] ← STACK_TYPE[STACK_SIZE]
                  ARG_TEXT[ARG_COUNT] ← STACK_TEXT[STACK_SIZE]
                  ARG_KIND[ARG_COUNT] ← STACK_KIND[STACK_SIZE]
                  STACK_SIZE ← STACK_SIZE - 1
                ENDIF
              ELSE
                IF LINE = "CALLBUILTIN" THEN
                  IF STACK_SIZE < 2 OR STACK_KIND[STACK_SIZE] <> "ARGS" OR STACK_KIND[STACK_SIZE - 1] <> "RAW" THEN
                    UNSUPPORTED ← 1
                  ELSE
                    J ← STACK_MARK[STACK_SIZE]
                    NAME ← STACK_TEXT[STACK_SIZE - 1]
                    CASE OF NAME
                      "STR_TO_NUM" :
                        IF ARG_COUNT <> J + 1 OR ARG_TYPE[ARG_COUNT] <> "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          IF INTEGER_LITERAL(ARG_TEXT[ARG_COUNT]) THEN
                            NUMBER_VALUE ← STR_TO_NUM(ARG_TEXT[ARG_COUNT])
                            IF NUMBER_VALUE >= -2147483647 AND NUMBER_VALUE <= 2147483647 THEN
                              STACK_CODE[STACK_SIZE - 1] ← NUMBER_CODE(NUMBER_VALUE)
                              STACK_TEXT[STACK_SIZE - 1] ← "CONST:" & NUM_TO_STR(NUMBER_VALUE)
                            ELSE
                              STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[ARG_COUNT] & CHR(16) & CHR(19)
                            ENDIF
                          ELSE
                            STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[ARG_COUNT] & CHR(16) & CHR(19)
                          ENDIF
                          STACK_TYPE[STACK_SIZE - 1] ← "REAL"
                        ENDIF
                      "INT" :
                        IF ARG_COUNT <> J + 1 OR ARG_TYPE[ARG_COUNT] = "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[ARG_COUNT] & CHR(157)
                          STACK_TYPE[STACK_SIZE - 1] ← "INTEGER"
                        ENDIF
                      "NUM_TO_STR" :
                        IF ARG_COUNT <> J + 1 OR ARG_TYPE[ARG_COUNT] = "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[ARG_COUNT] & CHR(16) & CHR(7)
                          STACK_TYPE[STACK_SIZE - 1] ← "STRING"
                        ENDIF
                      "UCASE" :
                        IF ARG_COUNT <> J + 1 OR ARG_TYPE[ARG_COUNT] <> "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[ARG_COUNT] & CHR(16) & CHR(11)
                          STACK_TYPE[STACK_SIZE - 1] ← "STRING"
                        ENDIF
                      "TO_UPPER" :
                        IF ARG_COUNT <> J + 1 OR ARG_TYPE[ARG_COUNT] <> "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[ARG_COUNT] & CHR(16) & CHR(11)
                          STACK_TYPE[STACK_SIZE - 1] ← "STRING"
                        ENDIF
                      "LCASE" :
                        IF ARG_COUNT <> J + 1 OR ARG_TYPE[ARG_COUNT] <> "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[ARG_COUNT] & CHR(16) & CHR(12)
                          STACK_TYPE[STACK_SIZE - 1] ← "STRING"
                        ENDIF
                      "TO_LOWER" :
                        IF ARG_COUNT <> J + 1 OR ARG_TYPE[ARG_COUNT] <> "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[ARG_COUNT] & CHR(16) & CHR(12)
                          STACK_TYPE[STACK_SIZE - 1] ← "STRING"
                        ENDIF
                      "LENGTH" :
                        IF ARG_COUNT <> J + 1 OR ARG_TYPE[ARG_COUNT] <> "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[ARG_COUNT] & CHR(16) & CHR(13)
                          STACK_TYPE[STACK_SIZE - 1] ← "INTEGER"
                        ENDIF
                      "CHR" :
                        IF ARG_COUNT <> J + 1 OR ARG_TYPE[ARG_COUNT] = "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[ARG_COUNT] & CHR(16) & CHR(14)
                          STACK_TYPE[STACK_SIZE - 1] ← "STRING"
                        ENDIF
                      "ASC" :
                        IF ARG_COUNT <> J + 1 OR ARG_TYPE[ARG_COUNT] <> "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[ARG_COUNT] & CHR(16) & CHR(15)
                          STACK_TYPE[STACK_SIZE - 1] ← "INTEGER"
                        ENDIF
                      "LEFT" :
                        IF ARG_COUNT <> J + 2 OR ARG_TYPE[J + 1] <> "STRING" OR ARG_TYPE[J + 2] = "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[J + 1] & ARG_CODE[J + 2] & CHR(16) & CHR(16)
                          STACK_TYPE[STACK_SIZE - 1] ← "STRING"
                        ENDIF
                      "RIGHT" :
                        IF ARG_COUNT <> J + 2 OR ARG_TYPE[J + 1] <> "STRING" OR ARG_TYPE[J + 2] = "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[J + 1] & ARG_CODE[J + 2] & CHR(16) & CHR(17)
                          STACK_TYPE[STACK_SIZE - 1] ← "STRING"
                        ENDIF
                      "MID" :
                        IF ARG_COUNT <> J + 3 OR ARG_TYPE[J + 1] <> "STRING" OR ARG_TYPE[J + 2] = "STRING" OR ARG_TYPE[J + 3] = "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[J + 1] & ARG_CODE[J + 2] & ARG_CODE[J + 3] & CHR(16) & CHR(18)
                          STACK_TYPE[STACK_SIZE - 1] ← "STRING"
                        ENDIF
                      "IS_NUM" :
                        IF ARG_COUNT <> J + 1 OR ARG_TYPE[ARG_COUNT] <> "STRING" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← ARG_CODE[ARG_COUNT] & CHR(16) & CHR(20)
                          STACK_TYPE[STACK_SIZE - 1] ← "BOOLEAN"
                        ENDIF
                      "RAND" :
                        IF ARG_COUNT <> J THEN
                          UNSUPPORTED ← 1
                        ELSE
                          STACK_CODE[STACK_SIZE - 1] ← CHR(16) & CHR(10)
                          STACK_TYPE[STACK_SIZE - 1] ← "REAL"
                        ENDIF
                      OTHERWISE : UNSUPPORTED ← 1
                    ENDCASE
                    STACK_KIND[STACK_SIZE - 1] ← "VALUE"
                    STACK_SIZE ← STACK_SIZE - 1
                    ARG_COUNT ← J
                  ENDIF
                ELSE
                  IF LINE = "INPUT" THEN
                    IF STACK_SIZE < 1 OR STACK_KIND[STACK_SIZE] <> "ADDRESS" OR LABEL_COUNT >= 256 THEN
                      UNSUPPORTED ← 1
                    ELSE
                      LABEL_COUNT ← LABEL_COUNT + 1
                      LABEL_NAMES[LABEL_COUNT] ← STACK_TEXT[STACK_SIZE]
                      CODE ← CODE & STACK_CODE[STACK_SIZE]
                      IF STACK_TYPE[STACK_SIZE] = "STRING" THEN
                        CODE ← CODE & CHR(65) & SLEB(LABEL_COUNT - 1) & CHR(16) & CHR(9)
                      ELSE
                        IF STACK_TYPE[STACK_SIZE] = "BOOLEAN" THEN
                          CODE ← CODE & CHR(65) & CHR(2)
                        ELSE
                          IF STACK_TYPE[STACK_SIZE] = "INTEGER" THEN
                            CODE ← CODE & CHR(65) & CHR(0)
                          ELSE
                            CODE ← CODE & CHR(65) & CHR(1)
                          ENDIF
                        ENDIF
                        CODE ← CODE & CHR(65) & SLEB(LABEL_COUNT - 1) & CHR(16) & CHR(4)
                      ENDIF
                      CODE ← CODE & CHR(57) & CHR(3) & CHR(0)
                      STACK_SIZE ← STACK_SIZE - 1
                    ENDIF
                  ELSE
                  IF LINE = "SET" THEN
                    IF STACK_SIZE < 2 OR STACK_KIND[STACK_SIZE - 1] <> "RAW" OR STACK_KIND[STACK_SIZE] <> "VALUE" THEN
                      UNSUPPORTED ← 1
                    ELSE
                      J ← FIND_SYMBOL(STACK_TEXT[STACK_SIZE - 1])
                      IF J = 0 THEN
                        UNSUPPORTED ← 1
                      ELSE
                        IF (STACK_TYPE[STACK_SIZE] = "STRING") <> (SYMBOL_TYPES[J] = "STRING") OR (STACK_TYPE[STACK_SIZE] = "BOOLEAN") <> (SYMBOL_TYPES[J] = "BOOLEAN") THEN
                          UNSUPPORTED ← 1
                        ENDIF
                        IF PROMOTED_LOCAL[J] > 0 THEN
                          CODE ← CODE & STACK_CODE[STACK_SIZE] & CHR(33) & ULEB(PROMOTED_LOCAL[J] - 1)
                        ELSE
                          CODE ← CODE & ADDRESS_CODE(J) & STACK_CODE[STACK_SIZE] & CHR(57) & CHR(3) & CHR(0)
                        ENDIF
                      ENDIF
                      STACK_SIZE ← STACK_SIZE - 2
                    ENDIF
                  ELSE
                    IF LINE = "BINARY" THEN
                      IF STACK_SIZE < 3 OR STACK_KIND[STACK_SIZE - 2] <> "OP" OR STACK_KIND[STACK_SIZE - 1] <> "VALUE" OR STACK_KIND[STACK_SIZE] <> "VALUE" THEN
                        UNSUPPORTED ← 1
                      ELSE
                        OPERATOR ← STACK_TEXT[STACK_SIZE - 2]
                        OP_CODE ← 0
                        RESULT_TYPE ← "INTEGER"
                        CASE OF OPERATOR
                          "+" : OP_CODE ← 160
                          "-" : OP_CODE ← 161
                          "*" : OP_CODE ← 162
                          "/" : OP_CODE ← 163
                          "DIV" : OP_CODE ← 164
                          "MOD" : OP_CODE ← 165
                          "&" : OP_CODE ← 170
                          "AND" : OP_CODE ← 171
                          "OR" : OP_CODE ← 172
                          "=" : OP_CODE ← 97
                          "<>" : OP_CODE ← 98
                          "<" : OP_CODE ← 99
                          "<=" : OP_CODE ← 101
                          ">" : OP_CODE ← 100
                          ">=" : OP_CODE ← 102
                        ENDCASE
                        IF OP_CODE = 0 THEN
                          UNSUPPORTED ← 1
                        ELSE
                          IF STACK_TYPE[STACK_SIZE] = "STRING" OR STACK_TYPE[STACK_SIZE - 1] = "STRING" THEN
                            IF STACK_TYPE[STACK_SIZE] <> "STRING" OR STACK_TYPE[STACK_SIZE - 1] <> "STRING" THEN
                              UNSUPPORTED ← 1
                            ELSE
                              IF OPERATOR = "&" THEN
                                STACK_CODE[STACK_SIZE - 2] ← STACK_CODE[STACK_SIZE - 1] & STACK_CODE[STACK_SIZE] & CHR(16) & ULEB(22 + ROUTINE_COUNT)
                                RESULT_TYPE ← "STRING"
                              ELSE
                                IF OPERATOR = "=" OR OPERATOR = "<>" THEN
                                  STACK_CODE[STACK_SIZE - 2] ← STACK_CODE[STACK_SIZE - 1] & STACK_CODE[STACK_SIZE] & CHR(16) & ULEB(23 + ROUTINE_COUNT)
                                  IF OPERATOR = "<>" THEN
                                    STACK_CODE[STACK_SIZE - 2] ← STACK_CODE[STACK_SIZE - 2] & NUMBER_CODE(0) & CHR(97) & CHR(183)
                                  ENDIF
                                  RESULT_TYPE ← "BOOLEAN"
                                ELSE
                                  UNSUPPORTED ← 1
                                ENDIF
                              ENDIF
                            ENDIF
                          ELSE
                          IF OP_CODE = 171 OR OP_CODE = 172 THEN
                            IF STACK_TYPE[STACK_SIZE - 1] <> "BOOLEAN" OR STACK_TYPE[STACK_SIZE] <> "BOOLEAN" THEN
                              UNSUPPORTED ← 1
                            ELSE
                              VALUE_CODE ← STACK_CODE[STACK_SIZE - 1] & NUMBER_CODE(0) & CHR(98) & CHR(4) & CHR(124)
                              IF OP_CODE = 171 THEN
                                VALUE_CODE ← VALUE_CODE & STACK_CODE[STACK_SIZE] & NUMBER_CODE(0) & CHR(98) & CHR(183) & CHR(5) & NUMBER_CODE(0)
                              ELSE
                                VALUE_CODE ← VALUE_CODE & NUMBER_CODE(1) & CHR(5) & STACK_CODE[STACK_SIZE] & NUMBER_CODE(0) & CHR(98) & CHR(183)
                              ENDIF
                              STACK_CODE[STACK_SIZE - 2] ← VALUE_CODE & CHR(11)
                              RESULT_TYPE ← "BOOLEAN"
                            ENDIF
                          ELSE
                          IF OP_CODE >= 163 AND OP_CODE <= 165 THEN
                            LEFT_CODE ← STACK_CODE[STACK_SIZE - 1]
                            RIGHT_CODE ← STACK_CODE[STACK_SIZE]
                            VALUE_CODE ← LEFT_CODE & CHR(33) & ULEB(TEMP_A) & RIGHT_CODE & CHR(33) & ULEB(TEMP_B)
                            VALUE_CODE ← VALUE_CODE & CHR(32) & ULEB(TEMP_B) & NUMBER_CODE(0) & CHR(97) & CHR(4) & CHR(64)
                            VALUE_CODE ← VALUE_CODE & CHR(65) & CHR(3) & CHR(65) & SLEB(SOURCE_LINE) & CHR(16) & CHR(5) & CHR(0) & CHR(11)
                            IF OP_CODE = 165 THEN
                              VALUE_CODE ← VALUE_CODE & CHR(32) & ULEB(TEMP_A)
                            ENDIF
                            VALUE_CODE ← VALUE_CODE & CHR(32) & ULEB(TEMP_A) & CHR(32) & ULEB(TEMP_B) & CHR(163)
                            IF OP_CODE >= 164 THEN
                              VALUE_CODE ← VALUE_CODE & CHR(157)
                            ENDIF
                            IF OP_CODE = 165 THEN
                              VALUE_CODE ← VALUE_CODE & CHR(32) & ULEB(TEMP_B) & CHR(162) & CHR(161)
                            ENDIF
                            STACK_CODE[STACK_SIZE - 2] ← VALUE_CODE
                          ELSE
                            STACK_CODE[STACK_SIZE - 2] ← STACK_CODE[STACK_SIZE - 1] & STACK_CODE[STACK_SIZE] & CHR(OP_CODE)
                            // Multiplication by a literal one has no side effects.
                            IF OPERATOR = "*" THEN
                              IF STACK_CODE[STACK_SIZE] = NUMBER_CODE(1) THEN
                                STACK_CODE[STACK_SIZE - 2] ← STACK_CODE[STACK_SIZE - 1]
                              ELSE
                                IF STACK_CODE[STACK_SIZE - 1] = NUMBER_CODE(1) THEN
                                  STACK_CODE[STACK_SIZE - 2] ← STACK_CODE[STACK_SIZE]
                                ENDIF
                              ENDIF
                            ENDIF
                          ENDIF
                          IF OP_CODE < 103 AND STACK_TYPE[STACK_SIZE] <> "STRING" THEN
                            STACK_CODE[STACK_SIZE - 2] ← STACK_CODE[STACK_SIZE - 2] & CHR(183)
                            RESULT_TYPE ← "BOOLEAN"
                          ENDIF
                          IF OPERATOR = "/" THEN
                            RESULT_TYPE ← "REAL"
                          ENDIF
                          ENDIF
                          ENDIF
                          STACK_TYPE[STACK_SIZE - 2] ← RESULT_TYPE
                          STACK_KIND[STACK_SIZE - 2] ← "VALUE"
                        ENDIF
                        STACK_SIZE ← STACK_SIZE - 2
                      ENDIF
                    ELSE
                      IF LINE = "FOR_TEST" OR LINE = "FOR_TEST_UP" OR LINE = "FOR_TEST_DOWN" THEN
                        IF STACK_SIZE < 3 OR STACK_KIND[STACK_SIZE] <> "VALUE" OR STACK_KIND[STACK_SIZE - 1] <> "VALUE" OR STACK_KIND[STACK_SIZE - 2] <> "VALUE" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          LEFT_CODE ← STACK_CODE[STACK_SIZE - 2]
                          RIGHT_CODE ← STACK_CODE[STACK_SIZE - 1]
                          VALUE_CODE ← STACK_CODE[STACK_SIZE]
                          IF OPTIMIZE_MODE AND (LINE = "FOR_TEST_UP" OR LINE = "FOR_TEST_DOWN") THEN
                            IF LINE = "FOR_TEST_UP" THEN
                              CODE ← CODE & LEFT_CODE & RIGHT_CODE & CHR(101) & CHR(69) & CHR(13) & CHR(1)
                            ELSE
                              CODE ← CODE & LEFT_CODE & RIGHT_CODE & CHR(102) & CHR(69) & CHR(13) & CHR(1)
                            ENDIF
                          ELSE
                            IF VALUE_CODE = NUMBER_CODE(1) THEN
                              CODE ← CODE & LEFT_CODE & RIGHT_CODE & CHR(101) & CHR(69) & CHR(13) & CHR(1)
                            ELSE
                              IF VALUE_CODE = NUMBER_CODE(-1) OR VALUE_CODE = NUMBER_CODE(1) & CHR(154) THEN
                                CODE ← CODE & LEFT_CODE & RIGHT_CODE & CHR(102) & CHR(69) & CHR(13) & CHR(1)
                              ELSE
                                CODE ← CODE & VALUE_CODE & NUMBER_CODE(0) & CHR(97) & CHR(4) & CHR(64)
                                CODE ← CODE & CHR(65) & CHR(6) & CHR(65) & SLEB(SOURCE_LINE) & CHR(16) & CHR(5) & CHR(0) & CHR(11)
                                CODE ← CODE & VALUE_CODE & NUMBER_CODE(0) & CHR(100) & CHR(4) & CHR(127)
                                CODE ← CODE & LEFT_CODE & RIGHT_CODE & CHR(101) & CHR(5)
                                CODE ← CODE & LEFT_CODE & RIGHT_CODE & CHR(102) & CHR(11) & CHR(69) & CHR(13) & CHR(1)
                              ENDIF
                            ENDIF
                          ENDIF
                          STACK_SIZE ← STACK_SIZE - 3
                        ENDIF
                      ELSE
                      IF LINE = "OUTPUT" THEN
                        IF STACK_SIZE < 1 OR STACK_KIND[STACK_SIZE] <> "ARGS" THEN
                          UNSUPPORTED ← 1
                        ELSE
                          J ← STACK_MARK[STACK_SIZE]
                          FOR K ← J + 1 TO ARG_COUNT
                            IF ARG_TYPE[K] = "STRING" THEN
                              CODE ← CODE & ARG_CODE[K] & CHR(16) & CHR(8)
                            ELSE
                              CODE ← CODE & ARG_CODE[K]
                              IF ARG_TYPE[K] = "BOOLEAN" THEN
                                CODE ← CODE & NUMBER_CODE(0) & CHR(98) & CHR(16) & CHR(1)
                              ELSE
                                CODE ← CODE & CHR(16) & CHR(0)
                              ENDIF
                            ENDIF
                          NEXT K
                          CODE ← CODE & CHR(16) & CHR(3)
                          ARG_COUNT ← J
                          STACK_SIZE ← STACK_SIZE - 1
                        ENDIF
                      ELSE
                        IF LINE = "UNARY" THEN
                          IF STACK_SIZE < 2 OR STACK_KIND[STACK_SIZE - 1] <> "OP" OR STACK_KIND[STACK_SIZE] <> "VALUE" THEN
                            UNSUPPORTED ← 1
                          ELSE
                            OPERATOR ← STACK_TEXT[STACK_SIZE - 1]
                            STACK_CODE[STACK_SIZE - 1] ← STACK_CODE[STACK_SIZE]
                            STACK_TYPE[STACK_SIZE - 1] ← STACK_TYPE[STACK_SIZE]
                            STACK_KIND[STACK_SIZE - 1] ← "VALUE"
                            IF OPERATOR = "-" THEN
                              STACK_CODE[STACK_SIZE - 1] ← STACK_CODE[STACK_SIZE - 1] & CHR(154)
                            ELSE
                              IF OPERATOR = "NOT" THEN
                                STACK_CODE[STACK_SIZE - 1] ← STACK_CODE[STACK_SIZE - 1] & NUMBER_CODE(0) & CHR(97) & CHR(183)
                                STACK_TYPE[STACK_SIZE - 1] ← "BOOLEAN"
                              ELSE
                                IF OPERATOR <> "+" THEN
                                  UNSUPPORTED ← 1
                                ENDIF
                              ENDIF
                            ENDIF
                            STACK_SIZE ← STACK_SIZE - 1
                          ENDIF
                        ELSE
                        IF LINE = "IF" OR LINE = "WHILE_TEST" OR LINE = "UNTIL_TEST" THEN
                          IF STACK_SIZE < 1 OR STACK_KIND[STACK_SIZE] <> "VALUE" THEN
                            UNSUPPORTED ← 1
                          ELSE
                            CODE ← CODE & STACK_CODE[STACK_SIZE] & NUMBER_CODE(0) & CHR(98)
                            IF LINE = "IF" THEN
                              CODE ← CODE & CHR(4) & CHR(64)
                            ELSE
                              IF LINE = "WHILE_TEST" THEN
                                CODE ← CODE & CHR(69) & CHR(13) & CHR(1)
                              ELSE
                                CODE ← CODE & CHR(69) & CHR(13) & CHR(0) & CHR(11)
                              ENDIF
                            ENDIF
                            STACK_SIZE ← STACK_SIZE - 1
                          ENDIF
                        ELSE
                          CASE OF LINE
                            "WHILE" :
                              FILL_DEPTH ← FILL_DEPTH + 1
                              IF FILL_DEPTH <= 256 THEN
                                FILL_ACTIVE[FILL_DEPTH] ← FALSE
                                RANGE_SYMBOL[FILL_DEPTH] ← 0
                                IF OPTIMIZE_MODE AND RELEASE_MODE THEN
                                  CODE ← CODE & ZERO_FILL_PREFIX(INDEX)
                                  FILL_ACTIVE[FILL_DEPTH] ← FILL_MATCHED
                                  IF NOT FILL_MATCHED THEN
                                    J ← SAFE_FOR_RANGE(INDEX)
                                    IF J > 0 THEN
                                      RANGE_SYMBOL[FILL_DEPTH] ← J
                                      RANGE_LOW[FILL_DEPTH] ← RANGE_FOUND_LOW
                                      RANGE_HIGH[FILL_DEPTH] ← RANGE_FOUND_HIGH
                                      RANGE_LOCAL[FILL_DEPTH] ← RANGE_GUARD_SLOT(FILL_DEPTH)
                                      RANGE_INDEX_LOCAL[FILL_DEPTH] ← RANGE_LOCAL[FILL_DEPTH] + 1
                                      RANGE_STEP[FILL_DEPTH] ← RANGE_DIRECTION
                                      IF FILL_DEPTH > RANGE_MAX_DEPTH[CURRENT_ROUTINE + 1] THEN
                                        RANGE_MAX_DEPTH[CURRENT_ROUTINE + 1] ← FILL_DEPTH
                                      ENDIF
                                      IF RANGE_DIRECTION < 0 THEN
                                        CODE ← CODE & INDEX_CODE(RANGE_END_NAME) & NUMBER_CODE(RANGE_FOUND_LOW) & CHR(102)
                                      ELSE
                                        CODE ← CODE & INDEX_CODE(RANGE_END_NAME) & NUMBER_CODE(RANGE_FOUND_HIGH) & CHR(101)
                                      ENDIF
                                      CODE ← CODE & CHR(33) & ULEB(RANGE_LOCAL[FILL_DEPTH])
                                      CODE ← CODE & I32_CONST(RANGE_START_VALUE) & CHR(33) & ULEB(RANGE_INDEX_LOCAL[FILL_DEPTH])
                                    ENDIF
                                  ENDIF
                                ENDIF
                              ENDIF
                              CODE ← CODE & CHR(2) & CHR(64) & CHR(3) & CHR(64)
                            "REPEAT" : CODE ← CODE & CHR(3) & CHR(64)
                            "ENDWHILE" :
                              IF FILL_DEPTH > 0 AND FILL_DEPTH <= 256 THEN
                                IF RANGE_SYMBOL[FILL_DEPTH] > 0 THEN
                                  CODE ← CODE & CHR(32) & ULEB(RANGE_INDEX_LOCAL[FILL_DEPTH])
                                  CODE ← CODE & I32_CONST(RANGE_STEP[FILL_DEPTH]) & CHR(106)
                                  CODE ← CODE & CHR(33) & ULEB(RANGE_INDEX_LOCAL[FILL_DEPTH])
                                ENDIF
                              ENDIF
                              CODE ← CODE & CHR(12) & CHR(0) & CHR(11) & CHR(11)
                              IF FILL_DEPTH > 0 AND FILL_DEPTH <= 256 THEN
                                IF FILL_ACTIVE[FILL_DEPTH] THEN
                                  CODE ← CODE & CHR(11)
                                ENDIF
                                RANGE_SYMBOL[FILL_DEPTH] ← 0
                              ENDIF
                              FILL_DEPTH ← FILL_DEPTH - 1
                            "ELSE" : CODE ← CODE & CHR(5)
                            "ENDIF" : CODE ← CODE & CHR(11)
                            "BOOL" : UNSUPPORTED ← UNSUPPORTED
                            "NULL" : UNSUPPORTED ← UNSUPPORTED
                            "" : UNSUPPORTED ← UNSUPPORTED
                            OTHERWISE : UNSUPPORTED ← 1
                          ENDCASE
                        ENDIF
                        ENDIF
                      ENDIF
                      ENDIF
                    ENDIF
                  ENDIF
                  ENDIF
                ENDIF
              ENDIF
            ENDIF
          ENDIF
        ENDIF
      ENDIF
      ENDIF
    ENDIF
  ENDIF
  INDEX ← INDEX + 1
ENDWHILE

FAIL_INDEX ← INDEX
FOR INDEX ← 1 TO ROUTINE_COUNT
  IF ROUTINE_BODIES[INDEX] = "" THEN
    UNSUPPORTED ← 1
  ENDIF
NEXT INDEX
IF UNSUPPORTED = 1 OR STACK_SIZE <> 0 OR CURRENT_ROUTINE <> 0 THEN
  IF FAIL_INDEX >= 1 AND FAIL_INDEX <= LINE_COUNT THEN
    OUTPUT "N:UNSUPPORTED:" & UNSUPPORTED_REASON & ":" & NUM_TO_STR(FAIL_INDEX) & ":" & LINES[FAIL_INDEX]
  ELSE
    OUTPUT "N:UNSUPPORTED"
  ENDIF
ELSE
  FOR J ← 1 TO SYMBOL_COUNT
    IF PROMOTED_LOCAL[J] > 0 AND SYMBOL_SCOPE[J] = 0 THEN
      CODE ← CODE & ADDRESS_CODE(J) & CHR(32) & ULEB(PROMOTED_LOCAL[J] - 1) & CHR(57) & CHR(3) & CHR(0)
    ENDIF
  NEXT J
  BODY ← CHR(3) & CHR(1) & CHR(124) & CHR(1) & CHR(124) & CHR(1) & CHR(124)
  IF PROMOTED_COUNT > 0 THEN
    BODY ← CHR(4) & CHR(1) & CHR(124) & CHR(1) & CHR(124) & CHR(1) & CHR(124) & ULEB(PROMOTED_COUNT) & CHR(124)
  ENDIF
  IF RANGE_MAX_DEPTH[1] > 0 THEN
    BODY ← CHR(ASC(LEFT(BODY, 1)) + 1) & MID(BODY, 2, LENGTH(BODY))
    BODY ← BODY & ULEB(2 * RANGE_MAX_DEPTH[1]) & CHR(127)
  ENDIF
  BODY ← BODY & CODE & CHR(11)
  CONCAT_BODY ← HEX_BYTES("01067F2000AA21022001AA2103200228020041FFFFFFFF07712104200328020041FFFFFFFF077121052000100DAA2001100DAA6A210723042106200641146A3F004110744B0440410140001A0B200641146A24042006200420056A4180808080787236020020062002360204200620033602082006410036020C200620073602102006B80B")
  EQUALS_BODY ← HEX_BYTES("04017F017F017F017F20001015AA210220011015AA21032002280200220420032802004704404400000000000000000F0B41002105024003402005200449450D01200241046A20056A2D0000200341046A20056A2D00004704404400000000000000000F0B200541016A21050C000B0B44000000000000F03F0B")
  PAYLOAD ← ULEB(ROUTINE_COUNT + 3)
  ROUTINE_FUNCTION_SECTION ← ULEB(ROUTINE_COUNT + 3)
  FOR INDEX ← 1 TO ROUTINE_COUNT
    PAYLOAD ← PAYLOAD & ULEB(LENGTH(ROUTINE_BODIES[INDEX])) & ROUTINE_BODIES[INDEX]
    ROUTINE_FUNCTION_SECTION ← ROUTINE_FUNCTION_SECTION & ULEB(13 + INDEX)
  NEXT INDEX
  PAYLOAD ← PAYLOAD & ULEB(LENGTH(CONCAT_BODY)) & CONCAT_BODY & ULEB(LENGTH(EQUALS_BODY)) & EQUALS_BODY & ULEB(LENGTH(BODY)) & BODY
  ROUTINE_FUNCTION_SECTION ← ROUTINE_FUNCTION_SECTION & ULEB(14 + ROUTINE_COUNT) & ULEB(15 + ROUTINE_COUNT) & ULEB(16 + ROUTINE_COUNT)
  WASM ← PREFIX & CHR(3) & ULEB(LENGTH(ROUTINE_FUNCTION_SECTION)) & ROUTINE_FUNCTION_SECTION
  SECTION_DATA ← CHR(1) & CHR(0) & ULEB(MEMORY_PAGES)
  WASM ← WASM & CHR(5) & ULEB(LENGTH(SECTION_DATA)) & SECTION_DATA
  GLOBALS ← CHR(5)
  GLOBALS ← GLOBALS & CHR(127) & CHR(1) & CHR(65) & SLEB(FRAME_BASE) & CHR(11)
  GLOBALS ← GLOBALS & CHR(127) & CHR(1) & CHR(65) & CHR(0) & CHR(11)
  GLOBALS ← GLOBALS & CHR(127) & CHR(1) & CHR(65) & CHR(1) & CHR(11)
  GLOBALS ← GLOBALS & CHR(127) & CHR(1) & CHR(65) & SLEB(250000) & CHR(11)
  GLOBALS ← GLOBALS & CHR(127) & CHR(1) & CHR(65) & SLEB(HEAP_BASE) & CHR(11)
  WASM ← WASM & CHR(6) & ULEB(LENGTH(GLOBALS)) & GLOBALS
  EXPORTS ← ULEB(ROUTINE_COUNT + 5)
  FOR INDEX ← 1 TO ROUTINE_COUNT
    EXPORTS ← EXPORTS & ULEB(LENGTH(ROUTINE_NAMES[INDEX])) & ROUTINE_NAMES[INDEX] & CHR(0) & ULEB(21 + INDEX)
  NEXT INDEX
  EXPORTS ← EXPORTS & CHR(4) & "main" & CHR(0) & ULEB(24 + ROUTINE_COUNT)
  EXPORTS ← EXPORTS & CHR(6) & "memory" & CHR(2) & CHR(0)
  EXPORTS ← EXPORTS & CHR(5) & "steps" & CHR(3) & CHR(1)
  EXPORTS ← EXPORTS & CHR(4) & "line" & CHR(3) & CHR(2)
  EXPORTS ← EXPORTS & CHR(7) & "heapTop" & CHR(3) & CHR(4)
  WASM ← WASM & CHR(7) & ULEB(LENGTH(EXPORTS)) & EXPORTS
  WASM ← WASM & CHR(10) & ULEB(LENGTH(PAYLOAD)) & PAYLOAD
  DATA_PAYLOAD ← CHR(1) & CHR(0) & CHR(65) & CHR(8) & CHR(11) & ULEB(LENGTH(STATIC_DATA)) & STATIC_DATA
  WASM ← WASM & CHR(11) & ULEB(LENGTH(DATA_PAYLOAD)) & DATA_PAYLOAD
  OUTPUT "B:" & WASM
  OUTPUT "G:" & NUM_TO_STR(GLOBAL_BASE)
  OUTPUT "F:" & NUM_TO_STR(FRAME_BASE)
  OUTPUT "D:" & NUM_TO_STR(8 + LENGTH(STATIC_DATA))
  FOR INDEX ← 1 TO LABEL_COUNT
    OUTPUT "L:" & LABEL_NAMES[INDEX]
  NEXT INDEX
ENDIF

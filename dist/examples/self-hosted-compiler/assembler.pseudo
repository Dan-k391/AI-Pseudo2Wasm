// Assemble the core compiler's stack IR into a WebAssembly module.
// The embedded type/import header is the stable Pseudo2Wasm host ABI.
DECLARE PREFIX : STRING
DECLARE PREFIX_HEX : STRING
DECLARE IR : STRING
DECLARE LINE : STRING
DECLARE CHARACTER : STRING
DECLARE TEXT : STRING
DECLARE CODE : STRING
DECLARE BODY : STRING
DECLARE PAYLOAD : STRING
DECLARE WASM : STRING
DECLARE MODE : STRING
DECLARE POSITION : INTEGER
DECLARE INDEX : INTEGER
DECLARE LINE_LENGTH : INTEGER
DECLARE STRING_INDEX : INTEGER
DECLARE OP_INDEX : INTEGER
DECLARE CALL_INDEX : INTEGER
DECLARE VALUE : INTEGER
DECLARE BYTE_VALUE : INTEGER
DECLARE DEPTH : INTEGER
DECLARE ROUTINE_COUNT : INTEGER
DECLARE MAIN_CODE : STRING
DECLARE ROUTINE_BODIES : STRING
DECLARE ROUTINE_EXPORTS : STRING
DECLARE ROUTINE_NAME : STRING
DECLARE FUNCTION_PAYLOAD : STRING
DECLARE EXPORT_PAYLOAD : STRING
DECLARE SECTION_DATA : STRING
DECLARE STATIC_DATA : STRING
DECLARE DATA_PAYLOAD : STRING
DECLARE STRING_BYTES : STRING
DECLARE ROUTINE_MODE : INTEGER

// Section sizes and function indices use unsigned LEB128.
FUNCTION ULEB(N : INTEGER) RETURNS STRING
  DECLARE ENCODED : STRING
  DECLARE BYTE : INTEGER
  REPEAT
    BYTE ← N MOD 128
    N ← N DIV 128
    IF N > 0 THEN
      BYTE ← BYTE + 128
    ENDIF
    ENCODED ← ENCODED & CHR(BYTE)
  UNTIL N = 0
  RETURN ENCODED
ENDFUNCTION

// i32.const immediates use signed LEB128, including positive values above 63.
FUNCTION SLEB(N : INTEGER) RETURNS STRING
  DECLARE ENCODED : STRING
  DECLARE BYTE : INTEGER
  REPEAT
    BYTE ← N MOD 128
    N ← N DIV 128
    IF N > 0 OR BYTE >= 64 THEN
      BYTE ← BYTE + 128
    ENDIF
    ENCODED ← ENCODED & CHR(BYTE)
  UNTIL N = 0 AND BYTE < 128
  RETURN ENCODED
ENDFUNCTION

// Encode each literal in the module's linear-memory data segment.
FUNCTION UTF8(TEXT_VALUE : STRING) RETURNS STRING
  DECLARE RESULT : STRING
  DECLARE POSITION_UTF8 : INTEGER
  DECLARE CODEPOINT : INTEGER
  POSITION_UTF8 ← 1
  WHILE POSITION_UTF8 <= LENGTH(TEXT_VALUE)
    CODEPOINT ← ASC(MID(TEXT_VALUE, POSITION_UTF8, 2))
    IF CODEPOINT > 65535 THEN
      POSITION_UTF8 ← POSITION_UTF8 + 2
    ELSE
      POSITION_UTF8 ← POSITION_UTF8 + 1
    ENDIF
    IF CODEPOINT >= 55296 AND CODEPOINT <= 57343 THEN
      CODEPOINT ← 65533
    ENDIF
    IF CODEPOINT < 128 THEN
      RESULT ← RESULT & CHR(CODEPOINT)
    ELSE
      IF CODEPOINT < 2048 THEN
        RESULT ← RESULT & CHR(192 + CODEPOINT DIV 64)
        RESULT ← RESULT & CHR(128 + CODEPOINT MOD 64)
      ELSE
        IF CODEPOINT < 65536 THEN
          RESULT ← RESULT & CHR(224 + CODEPOINT DIV 4096)
          RESULT ← RESULT & CHR(128 + (CODEPOINT DIV 64) MOD 64)
          RESULT ← RESULT & CHR(128 + CODEPOINT MOD 64)
        ELSE
          RESULT ← RESULT & CHR(240 + CODEPOINT DIV 262144)
          RESULT ← RESULT & CHR(128 + (CODEPOINT DIV 4096) MOD 64)
          RESULT ← RESULT & CHR(128 + (CODEPOINT DIV 64) MOD 64)
          RESULT ← RESULT & CHR(128 + CODEPOINT MOD 64)
        ENDIF
      ENDIF
    ENDIF
  ENDWHILE
  RETURN RESULT
ENDFUNCTION
PREFIX_HEX ← ""
PREFIX ← ""
INDEX ← 1
WHILE INDEX < LENGTH(PREFIX_HEX)
  CHARACTER ← MID(PREFIX_HEX, INDEX, 1)
  BYTE_VALUE ← ASC(CHARACTER)
  IF BYTE_VALUE >= 65 THEN
    BYTE_VALUE ← BYTE_VALUE - 55
  ELSE
    BYTE_VALUE ← BYTE_VALUE - 48
  ENDIF
  VALUE ← BYTE_VALUE * 16
  CHARACTER ← MID(PREFIX_HEX, INDEX + 1, 1)
  BYTE_VALUE ← ASC(CHARACTER)
  IF BYTE_VALUE >= 65 THEN
    BYTE_VALUE ← BYTE_VALUE - 55
  ELSE
    BYTE_VALUE ← BYTE_VALUE - 48
  ENDIF
  PREFIX ← PREFIX & CHR(VALUE + BYTE_VALUE)
  INDEX ← INDEX + 2
ENDWHILE
INPUT IR
IR ← IR & CHR(10)
POSITION ← 1
STRING_INDEX ← 0
STATIC_DATA ← ""
CODE ← ""
DEPTH ← 0
ROUTINE_COUNT ← 0
ROUTINE_BODIES ← ""
ROUTINE_EXPORTS ← ""
ROUTINE_MODE ← 0
WHILE POSITION <= LENGTH(IR)
  LINE ← ""
  CHARACTER ← MID(IR, POSITION, 1)
  WHILE CHARACTER <> CHR(10)
    LINE ← LINE & CHARACTER
    POSITION ← POSITION + 1
    CHARACTER ← MID(IR, POSITION, 1)
  ENDWHILE
  POSITION ← POSITION + 1
  MODE ← ""
  IF LINE = "" THEN
    MODE ← "DONE"
  ENDIF
  IF LEFT(LINE, 2) = "I:" THEN
    LINE_LENGTH ← LENGTH(LINE)
    TEXT ← MID(LINE, 3, LINE_LENGTH)
    OUTPUT "S:" & TEXT
    STRING_BYTES ← UTF8(TEXT)
    VALUE ← LENGTH(STRING_BYTES)
    STATIC_DATA ← STATIC_DATA & CHR(VALUE MOD 256)
    VALUE ← VALUE DIV 256
    STATIC_DATA ← STATIC_DATA & CHR(VALUE MOD 256)
    VALUE ← VALUE DIV 256
    STATIC_DATA ← STATIC_DATA & CHR(VALUE MOD 256)
    VALUE ← VALUE DIV 256
    STATIC_DATA ← STATIC_DATA & CHR(VALUE MOD 256)
    STATIC_DATA ← STATIC_DATA & STRING_BYTES
    WHILE LENGTH(STATIC_DATA) MOD 4 <> 0
      STATIC_DATA ← STATIC_DATA & CHR(0)
    ENDWHILE
    VALUE ← STRING_INDEX
    STRING_INDEX ← STRING_INDEX + 1
    CODE ← CODE & CHR(65) & SLEB(VALUE)
    MODE ← "DONE"
  ENDIF
  IF LEFT(LINE, 2) = "O:" THEN
    LINE_LENGTH ← LENGTH(LINE)
    TEXT ← MID(LINE, 3, LINE_LENGTH)
    OP_INDEX ← 99
    CASE OF TEXT
      "OR" : OP_INDEX ← 0
      "AND" : OP_INDEX ← 1
      "=" : OP_INDEX ← 2
      "<>" : OP_INDEX ← 3
      "<" : OP_INDEX ← 4
      "<=" : OP_INDEX ← 5
      ">" : OP_INDEX ← 6
      ">=" : OP_INDEX ← 7
      "IN" : OP_INDEX ← 8
      "&" : OP_INDEX ← 9
      "+" : OP_INDEX ← 10
      "-" : OP_INDEX ← 11
      "*" : OP_INDEX ← 12
      "/" : OP_INDEX ← 13
      "DIV" : OP_INDEX ← 14
      "MOD" : OP_INDEX ← 15
    ENDCASE
    IF OP_INDEX = 99 THEN
      OUTPUT "E:Unknown operator " & TEXT
    ENDIF
    CODE ← CODE & CHR(65) & SLEB(OP_INDEX)
    MODE ← "DONE"
  ENDIF
  IF LEFT(LINE, 2) = "U:" THEN
    LINE_LENGTH ← LENGTH(LINE)
    TEXT ← MID(LINE, 3, LINE_LENGTH)
    OP_INDEX ← 99
    CASE OF TEXT
      "NOT" : OP_INDEX ← 0
      "-" : OP_INDEX ← 1
      "+" : OP_INDEX ← 2
      "^" : OP_INDEX ← 3
    ENDCASE
    IF OP_INDEX = 99 THEN
      OUTPUT "E:Unknown unary operator " & TEXT
    ENDIF
    CODE ← CODE & CHR(65)
    CODE ← CODE & CHR(OP_INDEX)
    MODE ← "DONE"
  ENDIF
  IF LEFT(LINE, 2) = "K:" THEN
    CODE ← CODE & CHR(65)
    IF LINE = "K:1" THEN
      CODE ← CODE & CHR(1)
    ELSE
      CODE ← CODE & CHR(0)
    ENDIF
    MODE ← "DONE"
  ENDIF
  IF LEFT(LINE, 2) = "T:" THEN
    LINE_LENGTH ← LENGTH(LINE)
    TEXT ← MID(LINE, 3, LINE_LENGTH)
    VALUE ← STR_TO_NUM(TEXT)
    CODE ← CODE & CHR(65) & SLEB(VALUE)
    CODE ← CODE & CHR(16)
    CODE ← CODE & CHR(0)
    MODE ← "DONE"
  ENDIF
  IF LEFT(LINE, 2) = "F:" THEN
    LINE_LENGTH ← LENGTH(LINE)
    TEXT ← MID(LINE, 3, LINE_LENGTH)
    OP_INDEX ← STR_TO_NUM(TEXT)
    CODE ← CODE & CHR(65)
    CODE ← CODE & CHR(OP_INDEX)
    MODE ← "DONE"
  ENDIF
  IF MODE = "" THEN
    CALL_INDEX ← 99
    CASE OF LINE
      "GET" : CALL_INDEX ← 4
      "SET" : CALL_INDEX ← 5
      "FIELD" : CALL_INDEX ← 17
      "SETFIELD" : CALL_INDEX ← 18
      "INDEX" : CALL_INDEX ← 15
      "SETINDEX" : CALL_INDEX ← 16
      "DEREF" : CALL_INDEX ← 28
      "SETDEREF" : CALL_INDEX ← 29
      "FILEOP" : CALL_INDEX ← 22
      "LOOPDECLARE" : CALL_INDEX ← 32
      "NEWOBJECT" : CALL_INDEX ← 30
      "CALLMETHOD" : CALL_INDEX ← 31
      "DECLARE" : CALL_INDEX ← 6
      "BINARY" : CALL_INDEX ← 7
      "UNARY" : CALL_INDEX ← 8
      "BOOL" : CALL_INDEX ← 3
      "ARGS" : CALL_INDEX ← 10
      "PUSH" : CALL_INDEX ← 11
      "CALLBUILTIN" : CALL_INDEX ← 12
      "OUTPUT" : CALL_INDEX ← 13
      "INPUT" : CALL_INDEX ← 14
      "CREATE" : CALL_INDEX ← 21
      "REFNAME" : CALL_INDEX ← 25
      "STR" : CALL_INDEX ← 2
    ENDCASE
    IF CALL_INDEX <> 99 THEN
      CODE ← CODE & CHR(16)
      CODE ← CODE & CHR(CALL_INDEX)
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    CASE OF LINE
      "IF" :
        CODE ← CODE & CHR(16) & CHR(9) & CHR(4) & CHR(64)
        DEPTH ← DEPTH + 1
        MODE ← "DONE"
      "NULL" :
        CODE ← CODE & CHR(208) & CHR(111)
        MODE ← "DONE"
      "ELSE" :
        CODE ← CODE & CHR(5)
        MODE ← "DONE"
      "ENDIF" :
        CODE ← CODE & CHR(11)
        DEPTH ← DEPTH - 1
        MODE ← "DONE"
      "WHILE" :
        CODE ← CODE & CHR(2) & CHR(64) & CHR(3) & CHR(64)
        DEPTH ← DEPTH + 1
        MODE ← "DONE"
      "WHILE_TEST" :
        CODE ← CODE & CHR(16) & CHR(9) & CHR(69) & CHR(13) & CHR(1)
        MODE ← "DONE"
      "FOR_TEST" :
        CODE ← CODE & CHR(16) & CHR(23) & CHR(69) & CHR(13) & CHR(1)
        MODE ← "DONE"
      "FOR_TEST_UP" :
        CODE ← CODE & CHR(16) & CHR(23) & CHR(69) & CHR(13) & CHR(1)
        MODE ← "DONE"
      "FOR_TEST_DOWN" :
        CODE ← CODE & CHR(16) & CHR(23) & CHR(69) & CHR(13) & CHR(1)
        MODE ← "DONE"
      "ENDWHILE" :
        CODE ← CODE & CHR(12) & CHR(0) & CHR(11) & CHR(11)
        DEPTH ← DEPTH - 1
        MODE ← "DONE"
      "REPEAT" :
        CODE ← CODE & CHR(3) & CHR(64)
        DEPTH ← DEPTH + 1
        MODE ← "DONE"
      "UNTIL_TEST" :
        CODE ← CODE & CHR(16) & CHR(9) & CHR(69) & CHR(13) & CHR(0) & CHR(11)
        DEPTH ← DEPTH - 1
        MODE ← "DONE"
    ENDCASE
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 2) = "R:" THEN
      IF ROUTINE_MODE = 1 THEN
        OUTPUT "E:Nested routine definition"
      ENDIF
      ROUTINE_MODE ← 1
      MAIN_CODE ← CODE
      CODE ← CHR(65) & SLEB(ROUTINE_COUNT)
      CODE ← CODE & CHR(32)
      CODE ← CODE & CHR(0)
      CODE ← CODE & CHR(16)
      CODE ← CODE & CHR(19)
      LINE_LENGTH ← LENGTH(LINE)
      ROUTINE_NAME ← MID(LINE, 3, LINE_LENGTH)
      ROUTINE_EXPORTS ← ROUTINE_EXPORTS & ULEB(LENGTH(ROUTINE_NAME))
      ROUTINE_EXPORTS ← ROUTINE_EXPORTS & ROUTINE_NAME
      ROUTINE_EXPORTS ← ROUTINE_EXPORTS & CHR(0)
      VALUE ← ROUTINE_COUNT + 33
      ROUTINE_EXPORTS ← ROUTINE_EXPORTS & ULEB(VALUE)
      ROUTINE_COUNT ← ROUTINE_COUNT + 1
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "ENDROUTINE" THEN
      CODE ← CODE & CHR(208)
      CODE ← CODE & CHR(111)
      CODE ← CODE & CHR(16)
      CODE ← CODE & CHR(20)
      BODY ← CHR(0) & CODE
      BODY ← BODY & CHR(11)
      ROUTINE_BODIES ← ROUTINE_BODIES & ULEB(LENGTH(BODY))
      ROUTINE_BODIES ← ROUTINE_BODIES & BODY
      CODE ← MAIN_CODE
      ROUTINE_MODE ← 0
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "RETURN" THEN
      CODE ← CODE & CHR(16)
      CODE ← CODE & CHR(20)
      CODE ← CODE & CHR(15)
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LINE = "DROP" THEN
      CODE ← CODE & CHR(26)
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 12) = "CALLROUTINE:" THEN
      LINE_LENGTH ← LENGTH(LINE)
      TEXT ← MID(LINE, 13, LINE_LENGTH)
      VALUE ← STR_TO_NUM(TEXT)
      VALUE ← VALUE + 33
      CODE ← CODE & CHR(16) & ULEB(VALUE)
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    IF LEFT(LINE, 6) = "ERROR:" THEN
      OUTPUT "E:" & LINE
      MODE ← "DONE"
    ENDIF
  ENDIF
  IF MODE = "" THEN
    OUTPUT "E:Unknown IR " & LINE
  ENDIF
ENDWHILE
IF DEPTH <> 0 THEN
  OUTPUT "E:Unclosed control blocks"
ENDIF

IF ROUTINE_MODE = 1 THEN
  OUTPUT "E:Unclosed routine"
ENDIF
BODY ← CHR(0) & CODE
BODY ← BODY & CHR(11)
VALUE ← ROUTINE_COUNT + 1
PAYLOAD ← ULEB(VALUE)
PAYLOAD ← PAYLOAD & ROUTINE_BODIES
PAYLOAD ← PAYLOAD & ULEB(LENGTH(BODY))
PAYLOAD ← PAYLOAD & BODY

VALUE ← ROUTINE_COUNT + 1
FUNCTION_PAYLOAD ← ULEB(VALUE)
INDEX ← 1
WHILE INDEX <= ROUTINE_COUNT
  FUNCTION_PAYLOAD ← FUNCTION_PAYLOAD & CHR(33)
  INDEX ← INDEX + 1
ENDWHILE
FUNCTION_PAYLOAD ← FUNCTION_PAYLOAD & CHR(34)
SECTION_DATA ← CHR(3)
SECTION_DATA ← SECTION_DATA & ULEB(LENGTH(FUNCTION_PAYLOAD))
SECTION_DATA ← SECTION_DATA & FUNCTION_PAYLOAD
WASM ← PREFIX & SECTION_DATA
VALUE ← (LENGTH(STATIC_DATA) + 8 + 65535) DIV 65536
SECTION_DATA ← CHR(1) & CHR(0) & ULEB(VALUE)
WASM ← WASM & CHR(5) & ULEB(LENGTH(SECTION_DATA)) & SECTION_DATA

VALUE ← ROUTINE_COUNT + 2
EXPORT_PAYLOAD ← ULEB(VALUE)
EXPORT_PAYLOAD ← EXPORT_PAYLOAD & ROUTINE_EXPORTS
EXPORT_PAYLOAD ← EXPORT_PAYLOAD & CHR(4)
EXPORT_PAYLOAD ← EXPORT_PAYLOAD & "main"
EXPORT_PAYLOAD ← EXPORT_PAYLOAD & CHR(0)
VALUE ← ROUTINE_COUNT + 33
EXPORT_PAYLOAD ← EXPORT_PAYLOAD & ULEB(VALUE)
EXPORT_PAYLOAD ← EXPORT_PAYLOAD & CHR(6) & "memory" & CHR(2) & CHR(0)
WASM ← WASM & CHR(7) & ULEB(LENGTH(EXPORT_PAYLOAD))
WASM ← WASM & EXPORT_PAYLOAD
WASM ← WASM & CHR(10) & ULEB(LENGTH(PAYLOAD))
WASM ← WASM & PAYLOAD
DATA_PAYLOAD ← CHR(1) & CHR(0) & CHR(65) & CHR(8) & CHR(11)
DATA_PAYLOAD ← DATA_PAYLOAD & ULEB(LENGTH(STATIC_DATA)) & STATIC_DATA
WASM ← WASM & CHR(11) & ULEB(LENGTH(DATA_PAYLOAD)) & DATA_PAYLOAD
OUTPUT "B:" & WASM
